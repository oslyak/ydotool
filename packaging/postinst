#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    for tool in ydotool ydotoold; do
        if [ -e "/usr/local/bin/$tool" ] || [ -L "/usr/local/bin/$tool" ]; then
            echo "ydotool: administrator local override /usr/local/bin/$tool takes precedence; inspect it separately" >&2
        fi
    done
    systemd-sysusers /usr/lib/sysusers.d/ydotool.conf
    if [ -d /run/systemd/system ] && [ -e /var/lib/ydotool/units-initialized ]; then
        deb-systemd-invoke stop ydotool-autosetup.path ydotool-autosetup.service
    fi
    for directory in /etc/systemd/system /run/systemd/system; do
        [ -d "$directory" ] || continue
        find "$directory" -type l \( -name 'ydotoold@*.service' -o -name 'ydotool-autosetup.*' \) -print | while IFS= read -r link; do
            case "$(readlink "$link")" in
                /usr/lib/systemd/system/ydotoold@.service|/lib/systemd/system/ydotoold@.service)
                    if [ -d /run/systemd/system ]; then deb-systemd-invoke stop "${link##*/}"; fi
                    rm -- "$link"
                    ;;
                /usr/lib/systemd/system/ydotool-autosetup.*|/lib/systemd/system/ydotool-autosetup.*)
                    rm -- "$link"
                    ;;
            esac
        done
    done
    rm -rf /var/lib/ydotool
    if deb-systemd-helper --quiet was-enabled ydotoold.service; then
        deb-systemd-helper enable ydotoold.service
    else
        deb-systemd-helper update-state ydotoold.service
    fi
    if [ -d /run/systemd/system ]; then
        if ! modprobe uinput; then
            echo 'ydotool: could not load uinput; ensure it is built in or loadable before starting the service' >&2
        fi
        udevadm control --reload-rules
        systemctl daemon-reload
        if [ -e /sys/class/misc/uinput ]; then
            udevadm trigger --action=change /sys/class/misc/uinput
            udevadm settle
            action=start
            if [ -n "${2:-}" ] && [ "$2" != "$(dpkg-query -W -f='${Version}' ydotool)" ]; then
                action=restart
            fi
            deb-systemd-invoke "$action" ydotoold.service
        fi
    fi
    echo 'ydotool: add authorized users with usermod -aG ydotool USER, then log out and back in' >&2
fi
