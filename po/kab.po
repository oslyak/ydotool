msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Aseqdec: key [OPTION]... [KEYCODES]...\nSuffeɣ ineḍruyen n tsekla.\n\nTinefrunin:\n  -d, --key-delay=N          Rǧu N n millisecund gar ineḍruyen n tsekla\n  -h, --help                 Sken tallalt-agi sakin ffɣ\n\nImi ulac abrid i wakken ad nessin acḥal n yisuddam n unasiw yellan di ddunit,\nnettaɣa tura s tengalin raw n yisekla.\n\nTaseddast: <keycode>:<pressed>\nmd. 28:1 28:0 yemmal-d tissit ɣef tqeffalt Enter deg unasiw US amagnu.\n     (:1 n ussed yemmal-d belli taqeffalt tettwased, syin :0 yemmal-d belli tettwaserreḥ)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nAzalen ur nettwafham ara, am 0, aaa, l0l, ad d-rren kan aḥbas.\n\nẒer `/usr/include/linux/input-event-codes.h' i tengalin n tsekla yellan (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Aseqdec: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nSmutti ameɣnu n umẓuɣ neɣ agerruj.\n\nTinefrunin:\n  -w, --wheel                Smutti agerruj n umẓuɣ s wazal amsemlal\n  -a, --absolute             Seqdec adeg amsɣan, ur yesseqdac ara i ugerruj\n  -x, --xpos                 Adeg X\n  -y, --ypos                 Adeg Y\n  -h, --help                 Sken tallalt-agi sakin ffɣ\n\nIlaq ad tsenseḍ arurad n tɣawla n umẓuɣ iwakken ad yeddu usmutti amsɣan."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: aṭas n yisɣaren n usmideg\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Asmutti n ugerruj n umẓuɣ ur ilaq ara ad yili s wazal amsɣan\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: ilaqen sin n yisɣaren n usmideg\n"

