msgstr "Aseqdec: type [OPTION]... [STRINGS]...\nAru azrir n yisekkilen.\n\nTinefrunin:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Rǧu N n millisecund gar tsekla (aḥbas gar yal tanmeẓla n usali/ukcim) (default: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Ḥbes yal taqeffalt N n millisecund (aḥbas gar usali d ukcim n tsekla) (default: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Rǧu N n millisecund gar izirigen n yiseɣẓanen n tladna (default: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Mmel-d afaylu, agbur-is ad yettwaru amzun d awel i d-yettunefken.\n                               Abrid n ufaylu yezmer daɣen ad yili '-' i tɣuri seg stdin\n  -e, --escape=BOOL          Rmed (1) neɣ sens (0) Escape\n  -h, --help                 Sken tallalt-agi sakin ffɣ\n\nEscape yettarmed s lexṣas mi ara tettaru iwenniten n yiseɣẓanen n tladna, yerna yettwasens s lexṣas mi ara tettaru seg ufaylu d stdin.\nAnekcum n ufaylu yettwaɣra s usuddem: ASCII ameɣtu uqbel anamek n tuccḍa yezmer ad yili yettwaru yakan."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type yesseqdac kan ASCII; seqdec clipboard i usenteḍ n uḍris UTF-8\n"

msgid "escape mode"
msgstr "askar n Escape"

