msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Bruk: ydotoold [OPTION]...\nydotool-tenesta.\n\nAlternativ:\n  -p, --socket-path=PATH     Tilpassa sokkelsti\n  -P, --socket-perm=PERM     Sokkelløyve (standard 0600)\n  -o, --socket-own=UID:GID   Eigarskap til sokkelen\n  -s, --no-system-keys        Slå av SysRq- og av/på-, kvile- og omstartstastar\n  -m, --mouse-off            Slå av mus (EV_REL)\n  -k, --keyboard-off         Slå av tastatur (EV_KEY)\n  -T, --touch-on             Slå på berøringsskjerm (EV_ABS)\n  -h, --help                 Vis denne hjelpeteksten og avslutt\n  -V, --version              Vis versjonsinformasjon\n"
