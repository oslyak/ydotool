msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Vent N millisekund mellom tastar (pausen mellom kvart tast ned/opp-par) (standard: %d)\n"
#, c-format

msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Hald kvar tast nede i N millisekund (pausen mellom tast ned og opp) (standard: %d)\n"
#, c-format

msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Vent N millisekund mellom strengane på kommandolinja (standard: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Oppgi ei fil, der innhaldet vert skrive som om det var sendt som eit argument.\n                               Filstien kan òg vere '-' for å lese frå stdin\n  -e, --escape=BOOL          Slå Escape på (1) eller av (0)\n  -h, --help                 Vis denne hjelpeteksten og avslutt\n\nEscape er slått på som standard når kommandolinjeargument vert skrivne, og av som standard ved skriving frå fil og stdin.\nFilinnhald vert lese som ein straum: gyldig ASCII før ein seinare feil kan alt ha vorte skrive."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type støttar berre ASCII; bruk innliming frå utklippstavla for UTF-8-tekst\n"

