msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Bruk: key [OPTION]... [KEYCODES]...\nSend tastehendingar.\n\nAlternativ:\n  -d, --key-delay=N          Vent N millisekund mellom tastehendingar\n  -h, --help                 Vis denne hjelpeteksten og avslutt\n\nSidan vi ikkje kan vite kor mange tastaturoppsett som finst i verda,\nbrukar vi rå tastekodar.\n\nSyntaks: <keycode>:<pressed>\ntil dømes tyder 28:1 28:0 at Enter-tasten på eit standard US-tastatur vert trykt ned.\n     (:1 tyder at tasten vert trykt ned, og :0 tyder at han vert sleppt)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nVerdiar som ikkje kan tolkast, til dømes 0, aaa, l0l, fører berre til ei pause.\n\nSjå `/usr/include/linux/input-event-codes.h' for tilgjengelege tastekodar (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Bruk: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nFlytt musepeikaren eller rullehjulet.\n\nAlternativ:\n  -w, --wheel                Flytt musehjulet relativt\n  -a, --absolute             Bruk absolutt posisjon; gjeld ikkje for rullehjul\n  -x, --xpos                 X-posisjon\n  -y, --ypos                 Y-posisjon\n  -h, --help                 Vis denne hjelpeteksten og avslutt\n\nDu må slå av akselerasjon for musepeikaren for å få korrekt absolutt rørsle."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: for mange koordinatar\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Rørsler med musehjulet skal ikkje vere absolutte verdiar\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: to koordinatar er påkravde\n"

