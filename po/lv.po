msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nydotool dēmons.\n\nOpcijas:\n  -p, --socket-path=PATH     Pielāgots ligzdas ceļš\n  -P, --socket-perm=PERM     Ligzdas atļaujas (noklusējums 0600)\n  -o, --socket-own=UID:GID   Ligzdas īpašnieks\n  -s, --no-system-keys        Atspējot SysRq un ieslēgšanas/miega/pārstartēšanas taustiņus\n  -m, --mouse-off            Atspējot peli (EV_REL)\n  -k, --keyboard-off         Atspējot tastatūru (EV_KEY)\n  -T, --touch-on             Iespējot skārienekrānu (EV_ABS)\n  -h, --help                 Parādīt šo palīdzību un iziet\n  -V, --version              Rādīt versijas informāciju\n"

