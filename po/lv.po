msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nIevadīt virknes.\n\nOpcijas:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Pauze N milisekundes starp taustiņiem (aizkave starp katru nospiešanas/atlaišanas pāri) (noklusējums: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Turēt katru taustiņu nospiestu N milisekundes (aizkave starp nospiešanu un atlaišanu) (noklusējums: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Pauze N milisekundes starp komandrindas virknēm (noklusējums: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Norādīt failu, kura saturs tiks ievadīts tā, it kā tas būtu padots kā arguments.\n                               filepath var būt arī '-', lai lasītu no stdin\n  -e, --escape=BOOL          Ieslēgt (1) vai izslēgt (0) escape apstrādi\n  -h, --help                 Parādīt šo palīdzību un iziet\n\nEscape pēc noklusējuma ir ieslēgts, ievadot komandrindas argumentus, un izslēgts, ievadot no faila un stdin.\nFaila ievade tiek straumēta: derīgs ASCII, kas nolasīts pirms vēlākas kļūdas, jau var būt ievadīts."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type atbalsta tikai ASCII; UTF-8 tekstam ieteicams ielīmēt no starpliktuves\n"

