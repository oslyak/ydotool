msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uso: type [OPTION]... [STRINGS]...\nDigita cadeias de caracteres.\n\nOpções:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Aguarda N milissegundos entre teclas (o intervalo entre cada par de pressão/libertação) (predefinição: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Mantém cada tecla pressionada por N milissegundos (intervalo entre pressionar e soltar) (predefinição: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Aguarda N milissegundos entre cadeias de caracteres da linha de comando (predefinição: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Especifica um ficheiro cujo conteúdo será digitado como se fosse passado como argumento.\n                               O caminho também pode ser '-' para ler de stdin\n  -e, --escape=BOOL          Ativa (1) ou desativa (0) o escape\n  -h, --help                 Mostra esta ajuda e sai\n\nO escape fica ativado por predefinição ao digitar argumentos da linha de comando e desativado por predefinição ao digitar de ficheiro e stdin.\nA entrada de ficheiro é transmitida em fluxo: o ASCII válido anterior a um erro posterior talvez já tenha sido digitado."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type aceita somente ASCII; use colar da área de transferência para texto UTF-8\n"

msgid "escape mode"
msgstr "modo de escape"

