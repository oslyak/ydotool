msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uso: ydotoold [OPTION]...\nO daemon ydotool.\n\nOpções:\n  -p, --socket-path=PATH     Caminho personalizado do socket\n  -P, --socket-perm=PERM     Permissão do socket (predefinição 0600)\n  -o, --socket-own=UID:GID   Proprietário do socket\n  -s, --no-system-keys        Desativa as teclas SysRq e de energia/suspensão/reinicialização\n  -m, --mouse-off            Desativa o rato (EV_REL)\n  -k, --keyboard-off         Desativa o teclado (EV_KEY)\n  -T, --touch-on             Ativa a ecrã tátil (EV_ABS)\n  -h, --help                 Mostra esta ajuda e sai\n  -V, --version              Mostra informações da versão\n"

