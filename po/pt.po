msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Uso: release-all\nSolta todas as teclas virtuais e os botões do rato."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all não aceita argumentos\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Uso: ydotool <cmd> <args>\nComandos disponíveis:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Use release-all para liberar teclas presas após o encerramento forçado de um cliente.\n  -h, --help     Mostra esta ajuda e sai\n  -V, --version  Mostra informações da versão e sai\nUse a variável de ambiente YDOTOOL_SOCKET para especificar o socket do daemon."

