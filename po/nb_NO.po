msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Bruk: release-all\nSlipp alle virtuelle tastatur- og museknapper."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all tar ingen argumenter\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Bruk: ydotool <cmd> <args>\nTilgjengelige kommandoer:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Bruk release-all for å frigjøre taster som holdes nede etter at en klient er avsluttet med tvang.\n  -h, --help     Vis denne hjelpen og avslutt\n  -V, --version  Vis versjonsinformasjon og avslutt\nBruk miljøvariabelen YDOTOOL_SOCKET for å angi tjenestesokkel."

