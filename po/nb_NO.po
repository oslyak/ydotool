msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Bruk: type [OPTION]... [STRINGS]...\nSkriv tekststrenger.\n\nValg:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Vent N millisekunder mellom tastene (forsinkelsen mellom hvert tast ned/opp-par) (standard: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Hold hver tast nede i N millisekunder (forsinkelsen mellom tast ned og opp) (standard: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Vent N millisekunder mellom tekststrenger på kommandolinjen (standard: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Angi en fil, hvis innhold skrives som om det var oppgitt som et argument.\n                               Filbanen kan også være '-' for å lese fra stdin\n  -e, --escape=BOOL          Aktiver (1) eller deaktiver (0) escape\n  -h, --help                 Vis denne hjelpen og avslutt\n\nEscape er aktivert som standard når kommandolinjeargumenter skrives, og deaktivert som standard ved lesing fra fil og stdin.\nFilinndata strømmes: gyldige ASCII-tegn før en senere feil kan allerede ha blitt skrevet."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type støtter bare ASCII; bruk innliming fra utklippstavlen for UTF-8-tekst\n"

msgid "escape mode"
msgstr "escape-modus"

