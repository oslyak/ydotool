msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Bruk: ydotoold [OPTION]...\nydotool-tjenesten.\n\nValg:\n  -p, --socket-path=PATH     Egendefinert sokkelbane\n  -P, --socket-perm=PERM     Sokkelrettigheter (standard 0600)\n  -o, --socket-own=UID:GID   Sokkeleierskap\n  -s, --no-system-keys        Deaktiver SysRq- og strøm-/hvile-/omstartstaster\n  -m, --mouse-off            Deaktiver mus (EV_REL)\n  -k, --keyboard-off         Deaktiver tastatur (EV_KEY)\n  -T, --touch-on             Aktiver berøringsskjerm (EV_ABS)\n  -h, --help                 Vis denne hjelpen og avslutt\n  -V, --version              Vis versjonsinformasjon\n"

