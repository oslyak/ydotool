msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Bruk: key [OPTION]... [KEYCODES]...\nSend tastetrykkhendelser.\n\nValg:\n  -d, --key-delay=N          Vent N millisekunder mellom tastetrykkhendelser\n  -h, --help                 Vis denne hjelpen og avslutt\n\nSiden det ikke er mulig å vite hvor mange tastaturoppsett som finnes i verden,\nbruker vi rå tastekoder nå.\n\nSyntaks: <keycode>:<pressed>\nf.eks. betyr 28:1 28:0 å trykke på Enter-tasten på et standard US-tastatur.\n     (der :1 for trykket betyr at tasten er nede, og :0 betyr at tasten slippes)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nVerdier som ikke kan tolkes, som 0, aaa, l0l, fører bare til en forsinkelse.\n\nSe `/usr/include/linux/input-event-codes.h' for tilgjengelige tastekoder (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Bruk: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nFlytt musepekeren eller rullehjulet.\n\nValg:\n  -w, --wheel                Flytt rullehjulet relativt\n  -a, --absolute             Bruk absolutt posisjon; gjelder ikke rullehjulet\n  -x, --xpos                 X-posisjon\n  -y, --ypos                 Y-posisjon\n  -h, --help                 Vis denne hjelpen og avslutt\n\nDu må deaktivere akselerasjon for musehastighet for å få korrekt absolutt bevegelse."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: for mange koordinater\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Bevegelser med musehjulet kan ikke være absolutte verdier\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: to koordinater kreves\n"

