msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uporaba: type [OPTION]... [STRINGS]...\nUpisuje nizove.\n\nOpcije:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Odgoda od N milisekundi između tipki (odgoda između svakog para spuštanja/podizanja tipke) (zadano: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Drži svaku tipku N milisekundi (odgoda između spuštanja i podizanja tipke) (zadano: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Odgoda od N milisekundi između nizova naredbenog retka (zadano: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Navedite datoteku čiji će se sadržaj upisati kao da je proslijeđen kao argument.\n                               Putanja datoteke može biti i '-' za čitanje iz stdin\n  -e, --escape=BOOL          Uključi escape (1) ili ga isključi (0)\n  -h, --help                 Prikaži ovu pomoć i izađi\n\nEscape je zadano uključen pri upisu argumenata naredbenog retka, a zadano isključen pri čitanju iz datoteke i stdin.\nUlaz iz datoteke obrađuje se u toku: valjani ASCII znakovi prije kasnije pogreške možda su već upisani."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type podržava samo ASCII; za UTF-8 tekst upotrijebite lijepljenje iz međuspremnika\n"

msgid "escape mode"
msgstr "način escape"

