msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uporaba: ydotoold [OPTION]...\nDemon ydotool.\n\nOpcije:\n  -p, --socket-path=PATH     Prilagođena putanja utičnice\n  -P, --socket-perm=PERM     Dopuštenja utičnice (zadano 0600)\n  -o, --socket-own=UID:GID   Vlasništvo nad utičnicom\n  -s, --no-system-keys        Onemogući tipke SysRq i za napajanje/spavanje/ponovno pokretanje\n  -m, --mouse-off            Onemogući miš (EV_REL)\n  -k, --keyboard-off         Onemogući tipkovnicu (EV_KEY)\n  -T, --touch-on             Omogući dodirni zaslon (EV_ABS)\n  -h, --help                 Prikaži ovu pomoć i izađi\n  -V, --version              Prikaži informacije o verziji\n\n"

