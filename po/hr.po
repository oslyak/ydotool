msgstr "odgoda (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "Događaj klika %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Uporaba: key [OPTION]... [KEYCODES]...\nEmitiraj događaje tipki.\n\nOpcije:\n  -d, --key-delay=N          Odgoda od N milisekundi između događaja tipki\n  -h, --help                 Prikaži ovu pomoć i izađi\n\nBudući da nije moguće znati koliko rasporeda tipkovnice postoji u svijetu,\ntrenutačno upotrebljavamo sirove kodove tipki.\n\nSintaksa: <keycode>:<pressed>\nnpr. 28:1 28:0 znači pritisak tipke Enter na standardnoj US tipkovnici.\n     (gdje :1 za pritisnutu tipku znači da se tipka spusti, a zatim :0 da se otpusti)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nVrijednosti koje se ne mogu protumačiti, kao što su 0, aaa, l0l, uzrokovat će samo odgodu.\n\nDostupne kodove tipki potražite u /usr/include/linux/input-event-codes.h' (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Uporaba: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nPomakni pokazivač miša ili kotačić.\n\nOpcije:\n  -w, --wheel                Pomakni kotačić miša relativno\n  -a, --absolute             Upotrijebi apsolutni položaj; ne primjenjuje se na kotačić\n  -x, --xpos                 Položaj X\n  -y, --ypos                 Položaj Y\n  -h, --help                 Prikaži ovu pomoć i izađi\n\nZa ispravno apsolutno pomicanje potrebno je isključiti ubrzanje brzine miša."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: previše koordinata\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Pomaci kotačića miša ne smiju biti apsolutne vrijednosti\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: potrebne su dvije koordinate\n"

