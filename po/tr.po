msgstr "Kullanım: type [OPTION]... [STRINGS]...\nMetin dizelerini yazar.\n\nSeçenekler:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Tuşlar arasında N milisaniye bekler (her tuş basma/bırakma çifti arasındaki gecikme) (varsayılan: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Her tuşu N milisaniye basılı tutar (tuşa basma ve bırakma arasındaki gecikme) (varsayılan: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Komut satırı metin dizeleri arasında N milisaniye bekler (varsayılan: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            İçeriği bir bağımsız değişken olarak verilmiş gibi yazılacak dosyayı belirtir.\n                               stdin'den okumak için dosya yolu '-' olabilir\n  -e, --escape=BOOL          Escape'i etkinleştirir (1) veya devre dışı bırakır (0)\n  -h, --help                 Bu yardımı görüntüler ve çıkar\n\nKomut satırı bağımsız değişkenleri yazılırken Escape varsayılan olarak etkindir; dosya ve stdin'den yazılırken varsayılan olarak devre dışıdır.\nDosya girdisi akış halinde işlenir: daha sonraki bir hatadan önceki geçerli ASCII metni yazılmış olabilir."

