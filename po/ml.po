msgid "You're advised to run this program as root, or YMMV."
msgstr "ഈ പ്രോഗ്രാം root ആയി പ്രവർത്തിപ്പിക്കാൻ നിർദേശിക്കുന്നു; അല്ലെങ്കിൽ ഫലം വ്യത്യാസപ്പെടാം (YMMV)."
msgid "failed to open uinput device"
msgstr "uinput ഉപകരണം തുറക്കാനായില്ല"
#, c-format
msgid "Socket path: %s\n"
msgstr "സോക്കറ്റ് പാത്ത്: %s\n"
msgid "failed to create socket for daemon collision detection"
msgstr "ഡീമൺ കൂട്ടിയിടി കണ്ടെത്താനുള്ള സോക്കറ്റ് സൃഷ്ടിക്കാനായില്ല"
msgid "Removing old stale socket"
msgstr "പഴയ പ്രവർത്തനരഹിത സോക്കറ്റ് നീക്കുന്നു"
