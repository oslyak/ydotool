msgid "Usage: click [OPTION]... [BUTTONS]...\nClick mouse buttons.\n\nOptions:\n  -r, --repeat=N             Repeat entire sequence N times\n  -D, --next-delay=N         Delay N milliseconds between input events (up/down,                                a complete click means doubled time)\n  -P, --press-release        Press & release mouse button to complete a click, (optional)\n  -h, --help                 Display this help and exit\n\nHow to specify buttons:\n  Now all mouse buttons are represented using hexadecimal numeric values, with an optional\nbit mask to specify if mouse up/down needs to be omitted.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Mouse down\n  0x80 - Mouse up\n  Examples:\n    0x00: chooses left button, but does nothing (you can use this to implement extra sleeps)\n    0xC0: left button click (down then up)\n    0x41: right button down\n    0x82: middle button up\n  The '0x' prefix can be omitted if you want.\n"
msgstr "Usage: click [OPTION]... [BUTTONS]...\nമൗസ് ബട്ടണുകൾ ക്ലിക്ക് ചെയ്യുക.\n\nഓപ്ഷനുകൾ:\n  -r, --repeat=N             മുഴുവൻ ശ്രേണിയും N തവണ ആവർത്തിക്കുക\n  -D, --next-delay=N         ഇൻപുട്ട് ഇവന്റുകൾക്കിടയിൽ N മില്ലിസെക്കൻഡ് ഇടവേള (അപ്പ്/ഡൗൺ,                                ഒരു പൂർണ്ണ ക്ലിക്കിന് ഇരട്ടി സമയം)\n  -P, --press-release        ക്ലിക്ക് പൂർത്തിയാക്കാൻ മൗസ് ബട്ടൺ അമർത്തി വിടുക (ഐച്ഛികം)\n  -h, --help                 ഈ സഹായം കാണിച്ച് പുറത്തുകടക്കുക\n\nബട്ടണുകൾ വ്യക്തമാക്കുന്ന വിധം:\n  ഇപ്പോൾ എല്ലാ മൗസ് ബട്ടണുകളും ഹെക്സാഡെസിമൽ സംഖ്യാ മൂല്യങ്ങളാൽ സൂചിപ്പിക്കുന്നു; ആവശ്യമെങ്കിൽ\nമൗസ് അപ്പ്/ഡൗൺ ഒഴിവാക്കണമോ എന്ന് വ്യക്തമാക്കാൻ ബിറ്റ് മാസ്ക് നൽകാം.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - മൗസ് താഴേക്ക്\n  0x80 - മൗസ് മുകളിലേക്ക്\n  ഉദാഹരണങ്ങൾ:\n    0x00: ഇടത് ബട്ടൺ തിരഞ്ഞെടുക്കുന്നു, ഒന്നും ചെയ്യുന്നില്ല (അധിക ഇടവേളകൾ ചേർക്കാൻ ഇത് ഉപയോഗിക്കാം)\n    0xC0: ഇടത് ബട്ടൺ ക്ലിക്ക് (താഴേക്ക്, തുടർന്ന് മുകളിലേക്ക്)\n    0x41: വലത് ബട്ടൺ താഴേക്ക്\n    0x82: മധ്യ ബട്ടൺ മുകളിലേക്ക്\n  വേണമെങ്കിൽ '0x' പ്രിഫിക്സ് ഒഴിവാക്കാം.\n"

#, c-format
msgid "option %s"
msgstr "ഓപ്ഷൻ %s"
#, c-format
msgid " with arg %s"
msgstr " ആർഗ്യുമെന്റ് %s സഹിതം"
msgid "repeat count"
msgstr "ആവർത്തനങ്ങളുടെ എണ്ണം"
msgid "delay (0..60000 ms)"
msgstr "ഇടവേള (0..60000 ms)"
#, c-format
msgid "Click Event %d\n"
msgstr "ക്ലിക്ക് ഇവന്റ് %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Usage: key [OPTION]... [KEYCODES]...\nകീ ഇവന്റുകൾ സൃഷ്ടിക്കുക.\n\nഓപ്ഷനുകൾ:\n  -d, --key-delay=N          കീ ഇവന്റുകൾക്കിടയിൽ N മില്ലിസെക്കൻഡ് ഇടവേള\n  -h, --help                 ഈ സഹായം കാണിച്ച് പുറത്തുകടക്കുക\n\nലോകത്ത് എത്ര കീബോർഡ് ലേയൗട്ടുകളുണ്ടെന്ന് അറിയാൻ വഴിയില്ലാത്തതിനാൽ,\nഇപ്പോൾ അസംസ്കൃത കീകോഡുകളാണ് ഉപയോഗിക്കുന്നത്.\n\nസിന്റാക്സ്: <keycode>:<pressed>\nഉദാ. സാധാരണ US കീബോർഡിൽ Enter അമർത്തുന്നതാണ് 28:1 28:0.\n     (:1 അമർത്തിയ കീ താഴെയാണെന്നും തുടർന്ന് :0 കീ വിട്ടുവെന്നും സൂചിപ്പിക്കുന്നു)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\n0, aaa, l0l പോലുള്ള വ്യാഖ്യാനിക്കാനാകാത്ത മൂല്യങ്ങൾ ഇടവേള മാത്രമേ സൃഷ്ടിക്കൂ.\n\nലഭ്യമായ കീകോഡുകൾക്കായി (KEY_*) `/usr/include/linux/input-event-codes.h' കാണുക.\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nമൗസ് പോയിന്ററോ വീലോ നീക്കുക.\n\nഓപ്ഷനുകൾ:\n  -w, --wheel                മൗസ് വീൽ ആപേക്ഷികമായി നീക്കുക\n  -a, --absolute             പരമ സ്ഥാനമുപയോഗിക്കുക; വീലിന് ബാധകമല്ല\n  -x, --xpos                 X സ്ഥാനം\n  -y, --ypos                 Y സ്ഥാനം\n  -h, --help                 ഈ സഹായം കാണിച്ച് പുറത്തുകടക്കുക\n\nശരിയായ പരമ ചലനത്തിന് മൗസ് വേഗത ആക്സിലറേഷൻ പ്രവർത്തനരഹിതമാക്കണം."
msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: കോഓർഡിനേറ്റുകൾ അധികമാണ്\n"
msgid "Mouse wheel moves should not be absolute values\n"
msgstr "മൗസ് വീൽ ചലനങ്ങൾ പരമ മൂല്യങ്ങളാകരുത്\n"
msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: രണ്ട് കോഓർഡിനേറ്റുകൾ ആവശ്യമാണ്\n"
msgid "Type anything (CTRL-C to exit):\n"
msgstr "എന്തെങ്കിലും ടൈപ്പ് ചെയ്യുക (പുറത്തുകടക്കാൻ CTRL-C):\n"
msgid "ydotool: read stdin"
msgstr "ydotool: stdin വായിക്കുക"
#, c-format
msgid "Key code: %d %d %d\n"
msgstr "കീ കോഡ്: %d %d %d\n"
msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin ASCII മാത്രം പിന്തുണയ്ക്കുന്നു; UTF-8 ടെക്സ്റ്റിന് ക്ലിപ്പ്ബോർഡ് പേസ്റ്റ് ഉപയോഗിക്കുക\n"
#, c-format
msgid "  Maps to: %d\n"
msgstr "  ഇതിലേക്ക് മാപ്പ് ചെയ്യുന്നു: %d\n"
#, c-format
msgid "  Sending shift\n"
msgstr "  shift അയയ്ക്കുന്നു\n"
#, c-format
msgid "  Sending ctrl\n"
msgstr "  ctrl അയയ്ക്കുന്നു\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nസ്ട്രിങ്ങുകൾ ടൈപ്പ് ചെയ്യുക.\n\nഓപ്ഷനുകൾ:"
#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          കീകൾക്കിടയിൽ N മില്ലിസെക്കൻഡ് ഇടവേള (ഓരോ കീ താഴെ/മുകളിൽ ജോഡിയുടെയും ഇടവേള) (സ്ഥിരസ്ഥിതി: %d)\n"
#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           ഓരോ കീയും N മില്ലിസെക്കൻഡ് അമർത്തിപ്പിടിക്കുക (കീ താഴെയും മുകളിലും ഇടയിലുള്ള ഇടവേള) (സ്ഥിരസ്ഥിതി: %d)\n"
#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         കമാൻഡ് ലൈൻ സ്ട്രിങ്ങുകൾക്കിടയിൽ N മില്ലിസെക്കൻഡ് ഇടവേള (സ്ഥിരസ്ഥിതി: %d)\n"
msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            ഒരു ഫയൽ വ്യക്തമാക്കുക; അതിലെ ഉള്ളടക്കം ആർഗ്യുമെന്റായി നൽകിയതുപോലെ ടൈപ്പ് ചെയ്യും.\n                               stdin-ൽ നിന്ന് വായിക്കാൻ ഫയൽപാത്ത് '-' ആകാം\n  -e, --escape=BOOL          Escape പ്രവർത്തനക്ഷമമാക്കുക (1) അല്ലെങ്കിൽ പ്രവർത്തനരഹിതമാക്കുക (0)\n  -h, --help                 ഈ സഹായം കാണിച്ച് പുറത്തുകടക്കുക\n\nകമാൻഡ് ലൈൻ ആർഗ്യുമെന്റുകൾ ടൈപ്പ് ചെയ്യുമ്പോൾ Escape സ്ഥിരമായി പ്രവർത്തനക്ഷമമാണ്; ഫയലിൽ നിന്നും stdin-ൽ നിന്നും ടൈപ്പ് ചെയ്യുമ്പോൾ സ്ഥിരമായി പ്രവർത്തനരഹിതമാണ്.\nഫയൽ ഇൻപുട്ട് സ്ട്രീമായി വായിക്കുന്നു: പിന്നീട് പിശക് വന്നാലും അതിന് മുമ്പുള്ള സാധുവായ ASCII ഇതിനകം ടൈപ്പ് ചെയ്തിരിക്കാം."
msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type ASCII മാത്രം പിന്തുണയ്ക്കുന്നു; UTF-8 ടെക്സ്റ്റിന് ക്ലിപ്പ്ബോർഡ് പേസ്റ്റ് ഉപയോഗിക്കുക\n"
msgid "escape mode"
msgstr "escape മോഡ്"
#, c-format
msgid "ydotool: type: error: failed to open %s: %s\n"
msgstr "ydotool: type: പിശക്: %s തുറക്കാനായില്ല: %s\n"
#, c-format
msgid "ydotool: type: error: read %s failed: %s\n"
msgstr "ydotool: type: പിശക്: %s വായന പരാജയപ്പെട്ടു: %s\n"

msgid "These are our honorable bakers:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"
msgstr "ഞങ്ങളുടെ ആദരണീയരായ സംഭാവകർ:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"
msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Usage: release-all\nഎല്ലാ വെർച്വൽ കീബോർഡ്, മൗസ് ബട്ടണുകളും വിടുക."
msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all-ന് ആർഗ്യുമെന്റുകളൊന്നും വേണ്ട\n"
msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Usage: ydotool <cmd> <args>\nലഭ്യമായ കമാൻഡുകൾ:"
msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "ക്ലയന്റ് നിർബന്ധമായി അവസാനിപ്പിച്ചതിന് ശേഷം അമർത്തിപ്പിടിച്ച കീകൾ വീണ്ടെടുക്കാൻ release-all ഉപയോഗിക്കുക.\n  -h, --help     ഈ സഹായം കാണിച്ച് പുറത്തുകടക്കുക\n  -V, --version  പതിപ്പ് വിവരം കാണിച്ച് പുറത്തുകടക്കുക\nഡീമൺ സോക്കറ്റ് വ്യക്തമാക്കാൻ YDOTOOL_SOCKET എൻവയോൺമെന്റ് വേരിയബിൾ ഉപയോഗിക്കുക."
#, c-format
msgid "ydotool: invalid %s: %s\n"
msgstr "ydotool: അസാധുവായ %s: %s\n"
msgid "ydotool: send input event"
msgstr "ydotool: ഇൻപുട്ട് ഇവന്റ് അയയ്ക്കുക"
#, c-format
msgid "ydotool: Unknown command: %s\nRun 'ydotool help' if you want a command list\n"
msgstr "ydotool: അറിയാത്ത കമാൻഡ്: %s\nകമാൻഡ് പട്ടികയ്ക്കായി 'ydotool help' പ്രവർത്തിപ്പിക്കുക\n"
msgid "failed to create socket"
msgstr "സോക്കറ്റ് സൃഷ്ടിക്കാനായില്ല"
msgid "ydotool: socket path is too long\n"
msgstr "ydotool: സോക്കറ്റ് പാത്ത് വളരെ നീളമുള്ളതാണ്\n"
#, c-format
msgid "failed to connect socket `%s': %s\n"
msgstr "സോക്കറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനായില്ല `%s': %s\n"
msgid "Please check if ydotoold is running.\n"
msgstr "ydotoold പ്രവർത്തിക്കുന്നുണ്ടോ എന്ന് പരിശോധിക്കുക.\n"
msgid "Please check if the current user has sufficient permissions to access the socket file.\n"
msgstr "സോക്കറ്റ് ഫയൽ ആക്സസ് ചെയ്യാൻ നിലവിലെ ഉപയോക്താവിന് മതിയായ അനുമതിയുണ്ടോ എന്ന് പരിശോധിക്കുക.\n"
msgid "ydotool: install signal handler"
msgstr "ydotool: സിഗ്നൽ ഹാൻഡ്ലർ ഇൻസ്റ്റാൾ ചെയ്യുക"
msgid "ydotool: lock socket directory"
msgstr "ydotool: സോക്കറ്റ് ഡയറക്ടറി ലോക്ക് ചെയ്യുക"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nydotool ഡീമൺ.\n\nഓപ്ഷനുകൾ:\n  -p, --socket-path=PATH     ഇഷ്ടാനുസൃത സോക്കറ്റ് പാത്ത്\n  -P, --socket-perm=PERM     സോക്കറ്റ് അനുമതി (സ്ഥിരസ്ഥിതി 0600)\n  -o, --socket-own=UID:GID   സോക്കറ്റിന്റെ ഉടമസ്ഥത\n  -s, --no-system-keys        SysRq, പവർ/സ്ലീപ്പ്/റീസ്റ്റാർട്ട് കീകൾ പ്രവർത്തനരഹിതമാക്കുക\n  -m, --mouse-off            മൗസ് പ്രവർത്തനരഹിതമാക്കുക (EV_REL)\n  -k, --keyboard-off         കീബോർഡ് പ്രവർത്തനരഹിതമാക്കുക (EV_KEY)\n  -T, --touch-on             ടച്ച്‌സ്‌ക്രീൻ പ്രവർത്തനക്ഷമമാക്കുക (EV_ABS)\n  -h, --help                 ഈ സഹായം കാണിച്ച് പുറത്തുകടക്കുക\n  -V, --version              പതിപ്പ് വിവരം കാണിക്കുക\n"
