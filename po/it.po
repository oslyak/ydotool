msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uso: ydotoold [OPTION]...\nIl daemon di ydotool.\n\nOpzioni:\n  -p, --socket-path=PATH     Percorso socket personalizzato\n  -P, --socket-perm=PERM     Permessi del socket (predefinito 0600)\n  -o, --socket-own=UID:GID   Proprietario del socket\n  -s, --no-system-keys        Disabilitare i tasti SysRq e di alimentazione/sospensione/riavvio\n  -m, --mouse-off            Disabilitare il mouse (EV_REL)\n  -k, --keyboard-off         Disabilitare la tastiera (EV_KEY)\n  -T, --touch-on             Abilitare il touchscreen (EV_ABS)\n  -h, --help                 Mostrare questo aiuto e uscire\n  -V, --version              Mostrare le informazioni sulla versione\n"

