msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Uso: key [OPTION]... [KEYCODES]...\nGenerare eventi dei tasti.\n\nOpzioni:\n  -d, --key-delay=N          Attesa di N millisecondi tra gli eventi dei tasti\n  -h, --help                 Mostrare questo aiuto e uscire\n\nPoiché non è possibile sapere quante layout di tastiera esistano nel mondo,\nora usiamo i codici dei tasti grezzi.\n\nSintassi: <keycode>:<pressed>\nAd es., 28:1 28:0 significa premere il tasto Enter su una tastiera US\nstandard.\n     (:1 indica che il tasto è premuto e :0 che viene rilasciato)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nValori non interpretabili, come 0, aaa, l0l, causano solo un'attesa.\n\nConsulta `/usr/include/linux/input-event-codes.h' per i codici dei tasti disponibili (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Uso: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nSpostare il puntatore o la rotella del mouse.\n\nOpzioni:\n  -w, --wheel                Spostare la rotella del mouse relativamente\n  -a, --absolute             Usare la posizione assoluta; non si applica alla rotella\n  -x, --xpos                 Posizione X\n  -y, --ypos                 Posizione Y\n  -h, --help                 Mostrare questo aiuto e uscire\n\nPer un movimento assoluto corretto, devi disattivare l'accelerazione della velocità del mouse."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: troppe coordinate\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "I movimenti della rotella del mouse non devono essere valori assoluti\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: sono richieste due coordinate\n"

