msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uso: type [OPTION]... [STRINGS]...\nDigitare stringhe.\n\nOpzioni:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Attesa di N millisecondi tra i tasti (attesa tra ogni coppia di pressione/rilascio) (predefinito: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Tenere premuto ogni tasto per N millisecondi (attesa tra pressione e rilascio) (predefinito: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Attesa di N millisecondi tra le stringhe della riga di comando (predefinito: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Specificare un file, il cui contenuto verrà digitato\n                              come se fosse passato come argomento.\n                              Il percorso può anche essere '-' per leggere da stdin\n  -e, --escape=BOOL          Abilitare (1) o disabilitare (0) l'escape\n  -h, --help                 Mostrare questo aiuto e uscire\n\nL'escape è abilitato per impostazione predefinita quando si digitano argomenti della riga di comando, ed è disabilitato quando si digita da file e stdin.\nL'input del file viene elaborato in streaming: l'ASCII valido precedente a un errore successivo potrebbe essere già stato digitato."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type supporta solo ASCII; usa l'incolla dagli appunti per il testo UTF-8\n"

msgid "escape mode"
msgstr "modalità escape"

