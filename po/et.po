msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nSisesta tekstisõned.\n\nValikud:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Viivitus klahvide vahel millisekundites (viivitus iga klahvi alla/üles paari vahel) (vaikimisi: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Hoia iga klahvi all N millisekundit (viivitus klahvi alla- ja ülesvajutuse vahel) (vaikimisi: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Viivitus käsurea tekstisõnede vahel millisekundites (vaikimisi: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Määra fail, mille sisu sisestatakse nii, nagu oleks see argumendina antud.\n                               Failitee võib stdin-ist lugemiseks olla ka '-'\n  -e, --escape=BOOL          Lülita paomärgi töötlemine sisse (1) või välja (0)\n  -h, --help                 Kuva see abiinfo ja lõpeta\n\nKäsurea argumentide sisestamisel on paomärgi töötlemine vaikimisi sisse lülitatud, failist ja stdin-ist sisestamisel aga välja lülitatud.\nFaili sisendit töödeldakse voona: enne hilisemat viga võidi kehtiv ASCII juba sisestada."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type toetab ainult ASCII-t; UTF-8 teksti jaoks kasuta lõikelaualt kleepimist\n"

msgid "escape mode"
msgstr "paomärgi režiim"

