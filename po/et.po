msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Usage: key [OPTION]... [KEYCODES]...\nSaada klahvisündmused.\n\nValikud:\n  -d, --key-delay=N          Viivitus klahvisündmuste vahel millisekundites\n  -h, --help                 Kuva see abiinfo ja lõpeta\n\nKuna pole võimalik teada, kui palju klaviatuuripaigutusi maailmas leidub,\nkasutame nüüd tooreid klahvikoode.\n\nSüntaks: <keycode>:<pressed>\nnt 28:1 28:0 tähendab tavalisel US-klaviatuuril Enter-klahvi vajutamist.\n     (:1 tähendab, et klahv vajutatakse alla, ja :0, et see vabastatakse)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nMittetõlgendatavad väärtused, näiteks 0, aaa, l0l, põhjustavad ainult viivituse.\n\nSaadaolevad klahvikoodid (KEY_*) leiate failist `/usr/include/linux/input-event-codes.h'.\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nLiiguta hiirekursorit või ratast.\n\nValikud:\n  -w, --wheel                Liiguta hiireratast suhteliselt\n  -a, --absolute             Kasuta absoluutset asukohta; rattale see ei kehti\n  -x, --xpos                 X-asukoht\n  -y, --ypos                 Y-asukoht\n  -h, --help                 Kuva see abiinfo ja lõpeta\n\nAbsoluutseks liikumiseks tuleb hiire kiirendamine õigesti toimimiseks välja lülitada."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: liiga palju koordinaate\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Hiireratta liikumised ei tohi olla absoluutsed väärtused\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: vaja on kahte koordinaati\n"

