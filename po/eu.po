msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Usage: key [OPTION]... [KEYCODES]...\nSortu tekla-gertaerak.\n\nAukerak:\n  -d, --key-delay=N          Atzeratu N milisegundo tekla-gertaeren artean\n  -h, --help                 Erakutsi laguntza hau eta irten\n\nMunduan zenbat teklatu-diseinu dauden jakiteko modurik ez dagoenez,\nteklatu-kode gordinak erabiltzen ditugu orain.\n\nSintaxia: <keycode>:<pressed>\nadib. 28:1 28:0: US teklatu estandar bateko Enter tekla sakatzea esan nahi du.\n     (:1 sakatuta dagoela adierazten du, tekla behera dagoela; ondoren :0 askatuta dagoela)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nInterpretatu ezin diren balioek, hala nola 0, aaa, l0l, atzerapena baino ez dute eragingo.\n\nIkusi `/usr/include/linux/input-event-codes.h' erabilgarri dauden tekla-kodeak ikusteko (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMugitu saguaren erakuslea edo gurpila.\n\nAukerak:\n  -w, --wheel                Mugitu saguaren gurpila erlatiboki\n  -a, --absolute             Erabili kokapen absolutua; ez dagokio gurpilari\n  -x, --xpos                 X kokapena\n  -y, --ypos                 Y kokapena\n  -h, --help                 Erakutsi laguntza hau eta irten\n\nMugimendu absolutu zuzena lortzeko, saguaren abiadura-azelerazioa desgaitu behar duzu."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: koordenatu gehiegi\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Saguaren gurpilaren mugimenduak ez dira balio absolutuak izan behar\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: bi koordenatu behar dira\n"

