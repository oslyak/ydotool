msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nydotool daemon-a.\n\nAukerak:\n  -p, --socket-path=PATH     Socket-aren bide pertsonalizatua\n  -P, --socket-perm=PERM     Socket-aren baimena (lehenetsia 0600)\n  -o, --socket-own=UID:GID   Socket-aren jabetza\n  -s, --no-system-keys        Desgaitu SysRq eta pizteko/lo egiteko/berrabiarazteko teklak\n  -m, --mouse-off            Desgaitu sagua (EV_REL)\n  -k, --keyboard-off         Desgaitu teklatua (EV_KEY)\n  -T, --touch-on             Gaitu ukipen-pantaila (EV_ABS)\n  -h, --help                 Erakutsi laguntza hau eta irten\n  -V, --version              Erakutsi bertsio-informazioa\n"

