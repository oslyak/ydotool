msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nIdatzi kateak.\n\nAukerak:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Atzeratu N milisegundo teklen artean (tekla bakoitzaren behera/gora bikotearen arteko atzerapena) (lehenetsia: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Eutsi tekla bakoitzari N milisegundoz (tekla behera eta gora dagoenaren arteko atzerapena) (lehenetsia: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Atzeratu N milisegundo komando-lerroko kateen artean (lehenetsia: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Zehaztu fitxategi bat; haren edukia argumentu gisa emana balitz bezala idatziko da.\n                               Fitxategi-bidea '-' ere izan daiteke stdin-etik irakurtzeko\n  -e, --escape=BOOL          Gaitu escape (1) edo desgaitu (0)\n  -h, --help                 Erakutsi laguntza hau eta irten\n\nEscape lehenespenez gaituta dago komando-lerroko argumentuak idaztean, eta desgaituta fitxategitik eta stdin-etik idaztean.\nFitxategi-sarrera korrontean prozesatzen da: geroago errore bat gertatu aurretik baliozkoa den ASCIIa idatzita egon daiteke."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type-k ASCII soilik onartzen du; erabili arbeleko itsastea UTF-8 testurako\n"

msgid "escape mode"
msgstr "escape modua"

