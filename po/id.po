msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "PENGGUNAAN: type [OPTION]... [STRINGS]...\nKetik string.\n\nOptions:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Jeda N milidetik di antara tombol (jeda antara setiap pasangan tekan/lepas) (default: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Tahan setiap tombol selama N milidetik (jeda antara tombol ditekan dan dilepas) (default: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Jeda N milidetik di antara string baris perintah (default: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Tentukan file yang isinya akan diketik seolah-olah diberikan sebagai argumen.\n                               Jalur file juga dapat berupa '-' untuk membaca dari stdin\n  -e, --escape=BOOL          Aktifkan (1) atau nonaktifkan (0) escape\n  -h, --help                 Tampilkan bantuan ini lalu keluar\n\nEscape aktif secara default saat mengetik argumen baris perintah, dan nonaktif secara default saat mengetik dari file dan stdin.\nInput file dialirkan: ASCII yang valid sebelum kesalahan berikutnya mungkin sudah terketik."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type hanya mendukung ASCII; gunakan tempel clipboard untuk teks UTF-8\n"

msgid "escape mode"
msgstr "mode escape"

