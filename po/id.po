msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "PENGGUNAAN: key [OPTION]... [KEYCODES]...\nKirim peristiwa tombol.\n\nOptions:\n  -d, --key-delay=N          Jeda N milidetik di antara peristiwa tombol\n  -h, --help                 Tampilkan bantuan ini lalu keluar\n\nKarena jumlah tata letak papan ketik di dunia tidak dapat diketahui,\n kini kami menggunakan kode tombol mentah.\n\nSintaks: <keycode>:<pressed>\nmisalnya 28:1 28:0 berarti menekan tombol Enter pada papan ketik standar US.\n     (di mana :1 berarti tombol ditekan lalu :0 berarti tombol dilepas)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNilai yang tidak dapat ditafsirkan, seperti 0, aaa, l0l, hanya akan menyebabkan jeda.\n\nLihat `/usr/include/linux/input-event-codes.h' untuk kode tombol yang tersedia (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "PENGGUNAAN: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nPindahkan penunjuk mouse atau roda.\n\nOptions:\n  -w, --wheel                Gerakkan roda mouse secara relatif\n  -a, --absolute             Gunakan posisi absolut, tidak berlaku untuk roda\n  -x, --xpos                 Posisi X\n  -y, --ypos                 Posisi Y\n  -h, --help                 Tampilkan bantuan ini lalu keluar\n\nAnda perlu menonaktifkan akselerasi kecepatan mouse agar gerakan absolut tepat."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: terlalu banyak koordinat\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Gerakan roda mouse tidak boleh berupa nilai absolut\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: diperlukan dua koordinat\n"

