msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "PENGGUNAAN: release-all\nLepaskan semua tombol papan ketik dan mouse virtual."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all tidak menerima argumen\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "PENGGUNAAN: ydotool <cmd> <args>\nPerintah yang tersedia:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Gunakan release-all untuk melepaskan tombol yang tertahan setelah klien dihentikan paksa.\n  -h, --help     Tampilkan bantuan ini lalu keluar\n  -V, --version  Tampilkan informasi versi lalu keluar\nGunakan variabel lingkungan YDOTOOL_SOCKET untuk menentukan soket daemon."

