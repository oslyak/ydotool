msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "PENGGUNAAN: ydotoold [OPTION]...\nDaemon ydotool.\n\nOptions:\n  -p, --socket-path=PATH     Jalur soket khusus\n  -P, --socket-perm=PERM     Izin soket (default 0600)\n  -o, --socket-own=UID:GID   Kepemilikan soket\n  -s, --no-system-keys        Nonaktifkan tombol SysRq dan tombol daya/tidur/mulai ulang\n  -m, --mouse-off            Nonaktifkan mouse (EV_REL)\n  -k, --keyboard-off         Nonaktifkan papan ketik (EV_KEY)\n  -T, --touch-on             Aktifkan layar sentuh (EV_ABS)\n  -h, --help                 Tampilkan bantuan ini lalu keluar\n  -V, --version              Tampilkan informasi versi\n"

