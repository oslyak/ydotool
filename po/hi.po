msgstr "विलंब (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "क्लिक घटना %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "उपयोग: key [OPTION]... [KEYCODES]...\nकुंजी घटनाएँ भेजें।\n\nविकल्प:\n  -d, --key-delay=N          कुंजी घटनाओं के बीच N मिलीसेकंड का विलंब\n  -h, --help                 यह सहायता दिखाएँ और बाहर निकलें\n\nदुनिया में कितने कीबोर्ड लेआउट हैं, यह जानने का कोई तरीका नहीं है,\nइसलिए अब हम सीधे keycodes का उपयोग करते हैं।\n\nवाक्यविन्यास: <keycode>:<pressed>\nउदाहरण: 28:1 28:0 का अर्थ मानक US कीबोर्ड पर Enter बटन दबाना है।\n     (यहाँ pressed के लिए :1 का अर्थ कुंजी नीचे है और फिर :0 का अर्थ कुंजी छोड़ दी गई है)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\n0, aaa, l0l जैसे समझ में न आने वाले मान केवल विलंब उत्पन्न करेंगे।\n\nउपलब्ध key codes (KEY_*) के लिए `/usr/include/linux/input-event-codes.h' देखें।\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "उपयोग: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nमाउस पॉइंटर या व्हील को चलाएँ।\n\nविकल्प:\n  -w, --wheel                माउस व्हील को सापेक्ष रूप से चलाएँ\n  -a, --absolute             निरपेक्ष स्थिति उपयोग करें; व्हील पर लागू नहीं\n  -x, --xpos                 X स्थिति\n  -y, --ypos                 Y स्थिति\n  -h, --help                 यह सहायता दिखाएँ और बाहर निकलें\n\nनिरपेक्ष गति सही रखने के लिए माउस गति त्वरण बंद करना आवश्यक है।"

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: बहुत अधिक निर्देशांक\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "माउस व्हील की गति निरपेक्ष मान नहीं होनी चाहिए\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: दो निर्देशांक आवश्यक हैं\n"

