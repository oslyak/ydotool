msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "उपयोग: type [OPTION]... [STRINGS]...\nस्ट्रिंग टाइप करें।\n\nविकल्प:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          कुंजियों के बीच N मिलीसेकंड विलंब (हर कुंजी के नीचे/ऊपर जोड़ी के बीच का विलंब) (डिफ़ॉल्ट: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           हर कुंजी को N मिलीसेकंड दबाए रखें (कुंजी नीचे और ऊपर के बीच का विलंब) (डिफ़ॉल्ट: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         कमांड लाइन स्ट्रिंगों के बीच N मिलीसेकंड विलंब (डिफ़ॉल्ट: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            ऐसी फ़ाइल निर्दिष्ट करें जिसकी सामग्री तर्क के रूप में दी गई हो, ऐसे टाइप की जाएगी।\n                               stdin से पढ़ने के लिए फ़ाइल पथ '-' भी हो सकता है\n  -e, --escape=BOOL          Escape सक्षम (1) या अक्षम (0) करें\n  -h, --help                 यह सहायता दिखाएँ और बाहर निकलें\n\nकमांड लाइन तर्क टाइप करते समय Escape डिफ़ॉल्ट रूप से सक्षम होता है; फ़ाइल और stdin से टाइप करते समय डिफ़ॉल्ट रूप से अक्षम होता है।\nफ़ाइल इनपुट स्ट्रीम के रूप में पढ़ा जाता है: बाद में त्रुटि आने से पहले का वैध ASCII पहले ही टाइप हो चुका हो सकता है।"

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type केवल ASCII समर्थित करता है; UTF-8 पाठ के लिए क्लिपबोर्ड से पेस्ट करें\n"

