msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "उपयोग: ydotoold [OPTION]...\nydotool डेमन।\n\nविकल्प:\n  -p, --socket-path=PATH     कस्टम सॉकेट पथ\n  -P, --socket-perm=PERM     सॉकेट अनुमति (डिफ़ॉल्ट 0600)\n  -o, --socket-own=UID:GID   सॉकेट स्वामित्व\n  -s, --no-system-keys        SysRq और पावर/स्लीप/रीस्टार्ट कुंजियाँ अक्षम करें\n  -m, --mouse-off            माउस अक्षम करें (EV_REL)\n  -k, --keyboard-off         कीबोर्ड अक्षम करें (EV_KEY)\n  -T, --touch-on             टचस्क्रीन सक्षम करें (EV_ABS)\n  -h, --help                 यह सहायता दिखाएँ और बाहर निकलें\n  -V, --version              संस्करण जानकारी दिखाएँ\n"

