msgid ""
"Usage: type [OPTION]... [STRINGS]...\n"
"Type strings.\n"
"\n"
"Options:"
msgstr ""
"Использование: type [OPTION]... [STRINGS]...\n"
"Вводит строки.\n"
"\n"
"Параметры:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Задержка N миллисекунд между клавишами (между каждой парой нажатия и отпускания) (по умолчанию: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Удерживать каждую клавишу N миллисекунд (задержка между нажатием и отпусканием) (по умолчанию: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Задержка N миллисекунд между строками командной строки (по умолчанию: %d)\n"

msgid ""
"  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n"
"                               The filepath may also be '-' to read from stdin\n"
"  -e, --escape=BOOL          Escape enable (1) or disable (0)\n"
"  -h, --help                 Display this help and exit\n"
"\n"
"Escape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\n"
"File input is streamed: valid ASCII before a later error may already have been typed."
msgstr ""
"  -f, --file=PATH            Указать файл, содержимое которого будет введено так, как если бы оно было передано аргументом.\n"
"                               В качестве пути к файлу можно указать '-' для чтения из stdin\n"
"  -e, --escape=BOOL          Включить (1) или отключить (0) обработку escape-последовательностей\n"
"  -h, --help                 Показать эту справку и выйти\n"
"\n"
"При вводе аргументов командной строки обработка escape-последовательностей включена по умолчанию, а при чтении из файла и stdin — отключена.\n"
"Ввод из файла выполняется потоком: корректный ASCII-текст до последующей ошибки может уже успеть введен."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type поддерживает только ASCII; для текста UTF-8 используйте вставку из буфера обмена\n"

msgid "escape mode"
msgstr "режим escape-последовательностей"

