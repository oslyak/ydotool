msgid "ydotool: Unknown command: %s\nRun 'ydotool help' if you want a command list\n"
msgstr "ydotool: Nepoznata komanda: %s\nPokrenite 'ydotool help' da biste dobili spisak komandi\n"

msgid "failed to create socket"
msgstr "pravljenje soketa nije uspelo"

msgid "ydotool: socket path is too long\n"
msgstr "ydotool: putanja soketa je preduga\n"

