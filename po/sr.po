msgid "Please check if ydotoold is running.\n"
msgstr "Proverite da li je ydotoold pokrenut.\n"

msgid "Please check if the current user has sufficient permissions to access the socket file.\n"
msgstr "Proverite da li trenutni korisnik ima dovoljna ovlašćenja za pristup datoteci soketa.\n"

msgid "ydotool: install signal handler"
msgstr "ydotool: instaliranje obrađivača signala"

msgid "ydotool: lock socket directory"
msgstr "ydotool: zaključavanje direktorijuma soketa"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Upotreba: ydotoold [OPTION]...\nDemon ydotool.\n\nOpcije:\n  -p, --socket-path=PATH     Prilagođena putanja soketa\n  -P, --socket-perm=PERM     Dozvole soketa (podrazumevano 0600)\n  -o, --socket-own=UID:GID   Vlasništvo nad soketom\n  -s, --no-system-keys        Onemogući SysRq i tastere za napajanje/spavanje/ponovno pokretanje\n  -m, --mouse-off            Onemogući miš (EV_REL)\n  -k, --keyboard-off         Onemogući tastaturu (EV_KEY)\n  -T, --touch-on             Omogući ekran osetljiv na dodir (EV_ABS)\n  -h, --help                 Prikaži ovu pomoć i izađi\n  -V, --version              Prikaži podatke o verziji\n"

