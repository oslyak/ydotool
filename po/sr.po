msgstr "Zahvaljujemo našim uvaženim autorima:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Upotreba: release-all\nOtpusti sve virtuelne tastere tastature i miša."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all ne prima argumente\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Upotreba: ydotool <cmd> <args>\nDostupne komande:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Koristite release-all da otpustite zadržane tastere nakon nasilno prekinutog klijenta.\n  -h, --help     Prikažite ovu pomoć i izađite\n  -V, --version  Prikažite podatke o verziji i izađite\nZa navođenje soketa demona koristite promenljivu okruženja YDOTOOL_SOCKET."

#, c-format
msgid "ydotool: invalid %s: %s\n"
msgstr "ydotool: neispravno %s: %s\n"

msgid "ydotool: send input event"
msgstr "ydotool: slanje ulaznog događaja"

