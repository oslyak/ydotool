msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Upotreba: type [OPTION]... [STRINGS]...\nUnosi tekstualne nizove.\n\nOpcije:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Pauza od N milisekundi između tastera (pauza između svakog para pritiska i otpuštanja) (podrazumevano: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Drži svaki taster N milisekundi (vreme između pritiska i otpuštanja) (podrazumevano: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Pauza od N milisekundi između nizova iz komandne linije (podrazumevano: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Navedite datoteku čiji će sadržaj biti unet kao da je prosleđen kao argument.\n                               Putanja datoteke može biti i '-' za čitanje sa stdin\n  -e, --escape=BOOL          Uključuje (1) ili isključuje (0) escape obradu\n  -h, --help                 Prikažite ovu pomoć i izađite\n\nEscape obrada je podrazumevano uključena za argumente komandne linije, a isključena za unos iz datoteke i stdin.\nUlaz iz datoteke obrađuje se kao tok: ispravan ASCII sadržaj pre kasnije greške možda je već unet."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type podržava samo ASCII; za UTF-8 tekst koristite lepljenje iz ostave\n"

msgid "escape mode"
msgstr "escape režim"

