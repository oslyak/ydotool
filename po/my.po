msgstr "Project-Id-Version: ydotool 1.0.11\nReport-Msgid-Bugs-To: anton@sirius.if.ua\nPOT-Creation-Date: 2026-11-06 02:52+0700\nPO-Revision-Date: 2026-11-06 00:00+0000\nLast-Translator: ydotool translation tooling <anton@sirius.if.ua>\nLanguage-Team: Burmese\nLanguage: my\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nX-Native-Review: pending\nPlural-Forms: nplurals=1; plural=0;\n"

msgid "Usage: click [OPTION]... [BUTTONS]...\nClick mouse buttons.\n\nOptions:\n  -r, --repeat=N             Repeat entire sequence N times\n  -D, --next-delay=N         Delay N milliseconds between input events (up/down,                                a complete click means doubled time)\n  -P, --press-release        Press & release mouse button to complete a click, (optional)\n  -h, --help                 Display this help and exit\n\nHow to specify buttons:\n  Now all mouse buttons are represented using hexadecimal numeric values, with an optional\nbit mask to specify if mouse up/down needs to be omitted.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Mouse down\n  0x80 - Mouse up\n  Examples:\n    0x00: chooses left button, but does nothing (you can use this to implement extra sleeps)\n    0xC0: left button click (down then up)\n    0x41: right button down\n    0x82: middle button up\n  The '0x' prefix can be omitted if you want.\n"
msgstr "အသုံးပြုပုံ: click [OPTION]... [BUTTONS]...\nမောက်စ်ခလုတ်များကို နှိပ်ပါ။\n\nရွေးချယ်စရာများ:\n  -r, --repeat=N             အစီအစဉ်တစ်ခုလုံးကို N ကြိမ် ထပ်လုပ်ပါ\n  -D, --next-delay=N         ထည့်သွင်းမှုဖြစ်ရပ်များ (အောက်/အပေါ်) အကြား N မီလီစက္ကန့် စောင့်ပါ (ပြီးပြည့်စုံသော click တွင် အချိန်နှစ်ဆကြာသည်)\n  -P, --press-release        click ပြီးစေရန် မောက်စ်ခလုတ်ကို ဖိပြီး လွှတ်ပါ (ရွေးချယ်နိုင်သည်)\n  -h, --help                 ဤအကူအညီကို ပြပြီး ထွက်ပါ\n\nခလုတ်များ သတ်မှတ်နည်း:\n  ယခု မောက်စ်ခလုတ်အားလုံးကို hexadecimal ကိန်းဂဏန်းတန်ဖိုးများဖြင့် ကိုယ်စားပြုပြီး မောက်စ် အောက်/အပေါ် လုပ်ဆောင်ချက်ကို ချန်လှပ်ရန် ရွေးချယ်နိုင်သော bit mask ပါရှိသည်။\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - မောက်စ် အောက်\n  0x80 - မောက်စ် အပေါ်\n  ဥပမာများ:\n    0x00: ဘယ်ခလုတ်ကို ရွေးသော်လည်း ဘာမျှမလုပ်ပါ (အပိုစောင့်ချိန်များအတွက် အသုံးပြုနိုင်သည်)\n    0xC0: ဘယ်ခလုတ် click (အောက်ပြီး အပေါ်)\n    0x41: ညာခလုတ် အောက်\n    0x82: အလယ်ခလုတ် အပေါ်\n  လိုပါက '0x' ရှေ့ဆက်ကို ချန်ထားနိုင်သည်။\n"

#, c-format
msgid "option %s"
msgstr "ရွေးချယ်စရာ %s"

#, c-format
msgid " with arg %s"
msgstr " အကြောင်းပြချက် %s ဖြင့်"

msgid "repeat count"
msgstr "ထပ်လုပ်မည့်အကြိမ်ရေ"

msgid "delay (0..60000 ms)"
msgstr "နှောင့်နှေးချိန် (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "Click ဖြစ်ရပ် %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "အသုံးပြုပုံ: key [OPTION]... [KEYCODES]...\nကီးဖြစ်ရပ်များ ထုတ်လွှүүлပါ။\n\nရွေးချယ်စရာများ:\n  -d, --key-delay=N          ကီးဖြစ်ရပ်များအကြား N မီလီစက္ကန့် စောင့်ပါ\n  -h, --help                 ဤအကူအညီကို ပြပြီး ထွက်ပါ\n\nကမ္ဘာပေါ်ရှိ ကီးဘုတ်အပြင်အဆင် အရေအတွက်ကို သိနိုင်သည့်နည်း မရှိသောကြောင့်၊\nယခု raw keycodes များကို အသုံးပြုနေသည်။\n\nSyntax: <keycode>:<pressed>\nဥပမာ 28:1 28:0 သည် စံ US ကီးဘုတ်ရှိ Enter ခလုတ်ကို နှိပ်ခြင်းဖြစ်သည်။\n     (:1 သည် ဖိထားခြင်းဖြစ်ပြီး :0 သည် လွှတ်ခြင်းဖြစ်သည်)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\n0, aaa, l0l ကဲ့သို့ အဓိပ္ပာယ်မဖော်နိုင်သော တန်ဖိုးများသည် စောင့်ချိန်သာ ဖြစ်စေမည်။\n\nရနိုင်သော ကီးကုဒ်များ (KEY_*) ကို `/usr/include/linux/input-event-codes.h' တွင် ကြည့်ပါ။\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "အသုံးပြုပုံ: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nမောက်စ်ညွှန်ပြကိရိယာ သို့မဟုတ် ဘီးကို ရွှေ့ပါ။\n\nရွေးချယ်စရာများ:\n  -w, --wheel                မောက်စ်ဘီးကို နှိုင်းရတန်ဖိုးဖြင့် ရွှေ့ပါ\n  -a, --absolute             အကြွင်းမဲ့တည်နေရာကို သုံးပါ၊ ဘီးအတွက် မသက်ဆိုင်ပါ\n  -x, --xpos                 X တည်နေရာ\n  -y, --ypos                 Y တည်နေရာ\n  -h, --help                 ဤအကူအညီကို ပြပြီး ထွက်ပါ\n\nအကြွင်းမဲ့ရွှေ့မှု မှန်ကန်ရန် မောက်စ်အမြန်နှုန်း အရှိန်မြှင့်မှုကို ပိတ်ထားရမည်။"

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: ကိုဩဒိနိတ်များ များလွန်းသည်\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "မောက်စ်ဘီးရွှေ့မှုများသည် အကြွင်းမဲ့တန်ဖိုးများ မဖြစ်သင့်ပါ\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: ကိုဩဒိနိတ်နှစ်ခု လိုအပ်သည်\n"

msgid "Type anything (CTRL-C to exit):\n"
msgstr "မည်သည့်အရာမဆို ရိုက်ပါ (ထွက်ရန် CTRL-C):\n"

msgid "ydotool: read stdin"
msgstr "ydotool: stdin ကို ဖတ်ပါ"

#, c-format
msgid "Key code: %d %d %d\n"
msgstr "ကီးကုဒ်: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin သည် ASCII ကိုသာ လက်ခံသည်; UTF-8 စာသားအတွက် clipboard paste ကို သုံးပါ\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  သို့ ပြောင်းသည်: %d\n"

msgid "  Sending shift\n"
msgstr "  shift ပို့နေသည်\n"

msgid "  Sending ctrl\n"
msgstr "  ctrl ပို့နေသည်\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "အသုံးပြုပုံ: type [OPTION]... [STRINGS]...\nစာသားများကို ရိုက်ထည့်ပါ။\n\nရွေးချယ်စရာများ:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          ကီးတစ်ခုစီအကြား (ကီးအောက်/အပေါ် တစ်စုံစီကြား) N မီလီစက္ကန့် စောင့်ပါ (မူလ: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           ကီးတစ်ခုစီကို N မီလီစက္ကန့် ဖိထားပါ (ကီးအောက်နှင့် အပေါ်ကြား စောင့်ချိန်) (မူလ: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         command line စာသားများအကြား N မီလီစက္ကန့် စောင့်ပါ (မူလ: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            ဖိုင်၏ အကြောင်းအရာကို အကြောင်းပြချက်အဖြစ် ပေးသကဲ့သို့ ရိုက်ထည့်ရန် ဖိုင်သတ်မှတ်ပါ။\n                               ဖိုင်လမ်းကြောင်းအဖြစ် stdin မှ ဖတ်ရန် '-' ကိုလည်း သုံးနိုင်သည်\n  -e, --escape=BOOL          Escape ကို ဖွင့် (1) သို့မဟုတ် ပိတ် (0) ပါ\n  -h, --help                 ဤအကူအညီကို ပြပြီး ထွက်ပါ\n\ncommand line အကြောင်းပြချက်များ ရိုက်ရာတွင် Escape ကို မူလအားဖြင့် ဖွင့်ထားပြီး ဖိုင်နှင့် stdin မှ ရိုက်ရာတွင် မူလအားဖြင့် ပိတ်ထားသည်။\nဖိုင်ထည့်သွင်းမှုသည် အစဉ်လိုက်စီးဆင်းသည်: နောက်ပိုင်းတွင် အမှားဖြစ်သော်လည်း ထိုမတိုင်မီ မှန်ကန်သော ASCII ကို ရိုက်ပြီးသား ဖြစ်နိုင်သည်။"

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type သည် ASCII ကိုသာ လက်ခံသည်; UTF-8 စာသားအတွက် clipboard paste ကို သုံးပါ\n"

msgid "escape mode"
msgstr "escape မုဒ်"

#, c-format
msgid "ydotool: type: error: failed to open %s: %s\n"
msgstr "ydotool: type: အမှား: %s ကို ဖွင့်မရပါ: %s\n"

#, c-format
msgid "ydotool: type: error: read %s failed: %s\n"
msgstr "ydotool: type: အမှား: %s ကို ဖတ်ရာတွင် မအောင်မြင်ပါ: %s\n"

msgid "These are our honorable bakers:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"
msgstr "ဤသူများသည် ကျွန်ုပ်တို့၏ လေးစားရသော မုန့်ဖုတ်သမားများ ဖြစ်သည်:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "အသုံးပြုပုံ: release-all\nvirtual ကီးဘုတ်နှင့် မောက်စ်ခလုတ်အားလုံးကို လွှတ်ပါ။"

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all တွင် အကြောင်းပြချက် မယူပါ\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "အသုံးပြုပုံ: ydotool <cmd> <args>\nရနိုင်သော command များ:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "client ကို အတင်းပိတ်ပြီးနောက် ဖိနေဆဲကီးများကို ပြန်လွှတ်ရန် release-all ကို သုံးပါ။\n  -h, --help     ဤအကူအညီကို ပြပြီး ထွက်ပါ\n  -V, --version  ဗားရှင်းအချက်အလက်ကို ပြပြီး ထွက်ပါ\ndaemon socket ကို သတ်မှတ်ရန် YDOTOOL_SOCKET ပတ်ဝန်းကျင်ပြောင်းလဲကိန်းကို သုံးပါ။"

#, c-format
msgid "ydotool: invalid %s: %s\n"
msgstr "ydotool: မမှန်ကန်သော %s: %s\n"

msgid "ydotool: send input event"
msgstr "ydotool: input ဖြစ်ရပ် ပို့ပါ"

#, c-format
msgid "ydotool: Unknown command: %s\nRun 'ydotool help' if you want a command list\n"
msgstr "ydotool: မသိသော command: %s\ncommand စာရင်းလိုပါက 'ydotool help' ကို လုပ်ဆောင်ပါ\n"

msgid "failed to create socket"
msgstr "socket ဖန်တီးမရပါ"

msgid "ydotool: socket path is too long\n"
msgstr "ydotool: socket လမ်းကြောင်း ရှည်လွန်းသည်\n"

#, c-format
msgid "failed to connect socket `%s': %s\n"
msgstr "socket `%s' သို့ ချိတ်ဆက်မရပါ: %s\n"

msgid "Please check if ydotoold is running.\n"
msgstr "ydotoold လုပ်ဆောင်နေကြောင်း စစ်ဆေးပါ။\n"

msgid "Please check if the current user has sufficient permissions to access the socket file.\n"
msgstr "လက်ရှိအသုံးပြုသူတွင် socket ဖိုင်ကို ဝင်ရောက်ရန် လုံလောက်သော ခွင့်ပြုချက်ရှိကြောင်း စစ်ဆေးပါ။\n"

msgid "ydotool: install signal handler"
msgstr "ydotool: signal handler ထည့်သွင်းပါ"

msgid "ydotool: lock socket directory"
msgstr "ydotool: socket directory ကို lock လုပ်ပါ"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "အသုံးပြုပုံ: ydotoold [OPTION]...\nydotool daemon ဖြစ်သည်။\n\nရွေးချယ်စရာများ:\n  -p, --socket-path=PATH     ကိုယ်ပိုင် socket လမ်းကြောင်း\n  -P, --socket-perm=PERM     Socket ခွင့်ပြုချက် (မူလ 0600)\n  -o, --socket-own=UID:GID   Socket ပိုင်ဆိုင်မှု\n  -s, --no-system-keys        SysRq နှင့် power/sleep/restart ကီးများကို ပိတ်ပါ\n  -m, --mouse-off            မောက်စ် (EV_REL) ကို ပိတ်ပါ\n  -k, --keyboard-off         ကီးဘုတ် (EV_KEY) ကို ပိတ်ပါ\n  -T, --touch-on             touchscreen (EV_ABS) ကို ဖွင့်ပါ\n  -h, --help                 ဤအကူအညီကို ပြပြီး ထွက်ပါ\n  -V, --version              ဗားရှင်းအချက်အလက်ကို ပြပါ\n"

