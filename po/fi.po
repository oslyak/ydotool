msgstr "Usage: type [OPTION]... [STRINGS]...\nKirjoita merkkijonoja.\n\nValitsimet:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Viive N millisekuntia näppäinten välillä (viive kunkin alas/ylös-parin välillä) (oletus: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Pidä kutakin näppäintä painettuna N millisekuntia (viive alas- ja ylös-tapahtuman välillä) (oletus: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Viive N millisekuntia komentorivin merkkijonojen välillä (oletus: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Määritä tiedosto, jonka sisältö kirjoitetaan ikään kuin se olisi annettu argumenttina.\n                               Tiedostopolku voi olla myös '-' lukemiseen stdin-lähteestä\n  -e, --escape=BOOL          Ota escape käyttöön (1) tai poista se käytöstä (0)\n  -h, --help                 Näytä tämä ohje ja poistu\n\nEscape on oletuksena käytössä kirjoitettaessa komentoriviargumentteja ja pois käytöstä luettaessa tiedostosta tai stdin-lähteestä.\nTiedoston syöte käsitellään virtana: kelvollisia ASCII-merkkejä voi olla jo kirjoitettu ennen myöhempää virhettä."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type tukee vain ASCII-merkkejä; liitä UTF-8-teksti leikepöydältä\n"

