msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nydotool-daemon.\n\nValitsimet:\n  -p, --socket-path=PATH     Mukautettu socket-polku\n  -P, --socket-perm=PERM     Socketin oikeudet (oletus 0600)\n  -o, --socket-own=UID:GID   Socketin omistaja\n  -s, --no-system-keys        Poista SysRq- sekä virta-, lepo- ja uudelleenkäynnistysnäppäimet käytöstä\n  -m, --mouse-off            Poista hiiri käytöstä (EV_REL)\n  -k, --keyboard-off         Poista näppäimistö käytöstä (EV_KEY)\n  -T, --touch-on             Ota kosketusnäyttö käyttöön (EV_ABS)\n  -h, --help                 Näytä tämä ohje ja poistu\n  -V, --version              Näytä versiotiedot\n"

