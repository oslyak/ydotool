msgstr "Gebruik: type [OPTION]... [STRINGS]...\nTyp tekenreeksen.\n\nOpties:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Vertraging van N milliseconden tussen toetsen (vertraging tussen elk paar toets indrukken/loslaten) (standaard: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Houd elke toets N milliseconden ingedrukt (vertraging tussen indrukken en loslaten) (standaard: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Vertraging van N milliseconden tussen tekenreeksen op de opdrachtregel (standaard: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Geef een bestand op waarvan de inhoud wordt getypt alsof die als argument is meegegeven.\n                               Het bestandspad mag ook '-' zijn om van stdin te lezen\n  -e, --escape=BOOL          Escaping inschakelen (1) of uitschakelen (0)\n  -h, --help                 Toon deze hulp en sluit af\n\nEscaping is standaard ingeschakeld bij het typen van opdrachtregelargumenten en standaard uitgeschakeld bij het typen vanuit een bestand en stdin.\nBestandsinvoer wordt gestreamd: geldige ASCII-tekens vóór een latere fout kunnen al zijn getypt."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type ondersteunt alleen ASCII; gebruik plakken vanaf het klembord voor UTF-8-tekst\n"

