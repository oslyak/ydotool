msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Gebruik: ydotoold [OPTION]...\nDe ydotool-daemon.\n\nOpties:\n  -p, --socket-path=PATH     Aangepast socketpad\n  -P, --socket-perm=PERM     Socketrechten (standaard 0600)\n  -o, --socket-own=UID:GID   Socket-eigenaarschap\n  -s, --no-system-keys        SysRq- en aan/uit-/slaap-/herstarttoetsen uitschakelen\n  -m, --mouse-off            Muis uitschakelen (EV_REL)\n  -k, --keyboard-off         Toetsenbord uitschakelen (EV_KEY)\n  -T, --touch-on             Aanraakscherm inschakelen (EV_ABS)\n  -h, --help                 Toon deze hulp en sluit af\n  -V, --version              Toon versiegegevens\n"

