msgstr "UI_SET_KEYBIT %d ཕམ་སོང་།\n"

#, c-format
msgid "UI_SET_RELBIT %d failed\n"
msgstr "UI_SET_RELBIT %d ཕམ་སོང་།\n"

#, c-format
msgid "UI_SET_ABSBIT %d failed\n"
msgstr "UI_SET_ABSBIT %d ཕམ་སོང་།\n"

msgid "UI_DEV_SETUP ioctl failed"
msgstr "UI_DEV_SETUP ioctl ཕམ་སོང་།"

msgid "UI_DEV_CREATE ioctl failed"
msgstr "UI_DEV_CREATE ioctl ཕམ་སོང་།"

msgid "You're advised to run this program as root, or YMMV."
msgstr "ལས་རིམ་འདི root ཡིས་འཁོར་སྐྱོད་བྱེད་པར་གདམ་བྱ། དེ་མིན་འབྲས་བུ་ཁྱད་པར་ཡོང་སྲིད། (YMMV)"

msgid "failed to open uinput device"
msgstr "uinput སྒྲིག་ཆས་ཁ་ཕྱེ་མ་ཐུབ།"

#, c-format
msgid "Socket path: %s\n"
msgstr "Socket ལམ་ཡིག: %s\n"

msgid "failed to create socket for daemon collision detection"
msgstr "daemon འགལ་བ་འཚོལ་བའི་ཆེད་ socket བཟོ་མ་ཐུབ།"

msgid "Removing old stale socket"
msgstr "socket རྙིང་པ་དང་བེད་མེད་འདི་སུབ་བཞིན་པ།"

