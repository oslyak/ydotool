msgid "error: Another ydotoold is running with the same socket."
msgstr "ནོར་འཁྲུལ། ydotoold གཞན་ཞིག་གིས་སྤྱོད་མཚུངས་པའི socket བཀོལ་ནས་འཁོར་བཞིན་འདུག"

msgid "failed to bind socket"
msgstr "socket བཀྱིག་མ་ཐུབ།"

msgid "failed to change socket permission"
msgstr "socket དབང་ཚད་བསྒྱུར་མ་ཐུབ།"

#, c-format
msgid "Socket permission: %s\n"
msgstr "Socket དབང་ཚད། %s\n"

msgid "invalid ownership specification"
