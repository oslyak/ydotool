msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Utilisation : type [OPTION]... [STRINGS]...\nSaisir des chaînes de caractères.\n\nOptions :"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Délai de N millisecondes entre les touches (délai entre chaque paire appui/relâchement) (par défaut : %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Maintenir chaque touche enfoncée pendant N millisecondes (délai entre l'appui et le relâchement) (par défaut : %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Délai de N millisecondes entre les chaînes de la ligne de commande (par défaut : %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Indiquer un fichier dont le contenu sera saisi comme s'il était fourni en argument.\n                               Le chemin peut aussi être '-' pour lire depuis stdin\n  -e, --escape=BOOL          Activer (1) ou désactiver (0) l'échappement\n  -h, --help                 Afficher cette aide et quitter\n\nL'échappement est activé par défaut pour la saisie d'arguments de ligne de commande et désactivé par défaut pour la saisie depuis un fichier ou stdin.\nLa lecture d'un fichier est en flux : le texte ASCII valide précédant une erreur ultérieure peut déjà avoir été saisi."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool : type prend uniquement en charge l'ASCII ; utilisez le collage depuis le presse-papiers pour le texte UTF-8\n"

msgid "escape mode"
msgstr "mode d'échappement"

