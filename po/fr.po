msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Utilisation : key [OPTION]... [KEYCODES]...\nÉmettre des événements de touche.\n\nOptions :\n  -d, --key-delay=N          Délai de N millisecondes entre les événements de touche\n  -h, --help                 Afficher cette aide et quitter\n\nComme il est impossible de connaître tous les agencements de clavier du monde,\nnous utilisons désormais les codes de touche bruts.\n\nSyntaxe : <keycode>:<pressed>\nPar exemple, 28:1 28:0 signifie appuyer sur la touche Entrée d'un clavier US standard.\n     (:1 signifie que la touche est enfoncée, puis :0 qu'elle est relâchée)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nLes valeurs non interprétables, comme 0, aaa, l0l, ne provoquent qu'un délai.\n\nVoir `/usr/include/linux/input-event-codes.h' pour les codes de touche disponibles (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Utilisation : mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nDéplacer le pointeur ou la molette de la souris.\n\nOptions :\n  -w, --wheel                Déplacer la molette de la souris relativement\n  -a, --absolute             Utiliser une position absolue, sans effet sur la molette\n  -x, --xpos                 Position X\n  -y, --ypos                 Position Y\n  -h, --help                 Afficher cette aide et quitter\n\nPour obtenir un déplacement absolu correct, désactivez l'accélération de la souris."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool : mousemove : trop de coordonnées\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Les déplacements de la molette ne doivent pas être des valeurs absolues\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool : mousemove : deux coordonnées sont requises\n"

