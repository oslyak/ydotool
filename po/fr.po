msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Utilisation : release-all\nRelâcher toutes les touches virtuelles du clavier et tous les boutons de la souris."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool : release-all ne prend aucun argument\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Utilisation : ydotool <cmd> <args>\nCommandes disponibles :"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Utilisez release-all pour relâcher les touches restées enfoncées après l'arrêt forcé d'un client.\n  -h, --help     Afficher cette aide et quitter\n  -V, --version  Afficher les informations de version et quitter\nUtilisez la variable d'environnement YDOTOOL_SOCKET pour indiquer le socket du démon."

