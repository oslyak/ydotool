msgstr "ydotool : verrouillage du répertoire de sockets"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Utilisation : ydotoold [OPTION]...\nLe démon ydotool.\n\nOptions :\n  -p, --socket-path=PATH     Chemin personnalisé du socket\n  -P, --socket-perm=PERM     Droits du socket (par défaut 0600)\n  -o, --socket-own=UID:GID   Propriétaire du socket\n  -s, --no-system-keys        Désactiver les touches SysRq et alimentation/veille/redémarrage\n  -m, --mouse-off            Désactiver la souris (EV_REL)\n  -k, --keyboard-off         Désactiver le clavier (EV_KEY)\n  -T, --touch-on             Activer l'écran tactile (EV_ABS)\n  -h, --help                 Afficher cette aide et quitter\n  -V, --version              Afficher les informations de version\n"

