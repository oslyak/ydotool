msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Ús: type [OPTION]... [STRINGS]...\nEscriu cadenes de text.\n\nOpcions:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Espera N mil·lisegons entre tecles (retard entre cada parell de pulsació/alliberament) (per defecte: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Manté cada tecla premuda N mil·lisegons (retard entre pulsació i alliberament) (per defecte: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Espera N mil·lisegons entre cadenes de la línia d’ordres (per defecte: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Especifica un fitxer i n’escriu el contingut com si fos un argument.\n                               El camí també pot ser '-' per llegir de stdin\n  -e, --escape=BOOL          Activa (1) o desactiva (0) l’escapament\n  -h, --help                 Mostra aquesta ajuda i surt\n\nL’escapament està activat per defecte per als arguments de la línia d’ordres i desactivat per defecte per a fitxer i stdin.\nL’entrada del fitxer es processa en flux: potser ja s’hauran escrit caràcters ASCII vàlids abans d’un error posterior."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type només admet ASCII; enganxa el text UTF-8 des del porta-retalls\n"

msgid "escape mode"
msgstr "mode d’escapament"

