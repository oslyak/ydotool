msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Ús: ydotoold [OPTION]...\nEl dimoni ydotool.\n\nOpcions:\n  -p, --socket-path=PATH     Camí personalitzat del sòcol\n  -P, --socket-perm=PERM     Permisos del sòcol (per defecte 0600)\n  -o, --socket-own=UID:GID   Propietari del sòcol\n  -s, --no-system-keys        Desactiva SysRq i les tecles d’engegada/repòs/reinici\n  -m, --mouse-off            Desactiva el ratolí (EV_REL)\n  -k, --keyboard-off         Desactiva el teclat (EV_KEY)\n  -T, --touch-on             Activa la pantalla tàctil (EV_ABS)\n  -h, --help                 Mostra aquesta ajuda i surt\n  -V, --version              Mostra la informació de versió\n"

