#: Daemon/ydotoold.c:86
msgid ""
"Usage: ydotoold [OPTION]...\n"
"The ydotool Daemon.\n"
"\n"
"Options:\n"
"  -p, --socket-path=PATH     Custom socket path\n"
"  -P, --socket-perm=PERM     Socket permission (default 0600)\n"
"  -o, --socket-own=UID:GID   Socket ownership\n"
"  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n"
"  -m, --mouse-off            Disable mouse (EV_REL)\n"
"  -k, --keyboard-off         Disable keyboard (EV_KEY)\n"
"  -T, --touch-on             Enable touchscreen (EV_ABS)\n"
"  -h, --help                 Display this help and exit\n"
"  -V, --version              Show version information\n"
msgstr ""
"Usu: ydotoold [OPTION]...\n"
"El daemon de ydotool.\n"
"\n"
"Opciones:\n"
"  -p, --socket-path=PATH     Ruta personalizada del socket\n"
"  -P, --socket-perm=PERM     Permisos del socket (valor predetermináu 0600)\n"
"  -o, --socket-own=UID:GID   Propietariu del socket\n"
"  -s, --no-system-keys        Desactivar les tecles SysRq, d'encendíu, suspensión y reiniciu\n"
"  -m, --mouse-off            Desactivar el mur (EV_REL)\n"
"  -k, --keyboard-off         Desactivar el tecláu (EV_KEY)\n"
"  -T, --touch-on             Activar la pantalla táctil (EV_ABS)\n"
"  -h, --help                 Amosar esta ayuda y salir\n"
"  -V, --version              Amosar información de versión\n"

