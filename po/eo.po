msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uzado: type [OPTION]... [STRINGS]...\nTajpu ĉenojn.\n\nOpcioj:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Atendu N milisekundojn inter klavoj (prokrasto inter ĉiu prem/lev-paro) (defaŭlte: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Tenu ĉiun klavon N milisekundojn (prokrasto inter premado kaj levado) (defaŭlte: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Atendu N milisekundojn inter komandliniaj ĉenoj (defaŭlte: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Specifu dosieron, kies enhavo estos tajpata kvazaŭ ĝi estus argumento.\n                               La dosiera vojo povas ankaŭ esti '-' por legi de stdin\n  -e, --escape=BOOL          Ebligu (1) aŭ malebligu (0) eskapinterpretadon\n  -h, --help                 Montru ĉi tiun helpon kaj eliru\n\nEskapinterpretado estas defaŭlte ebligita por komandliniaj argumentoj kaj defaŭlte malebligita dum legado el dosiero kaj stdin.\nDosierenigo estas laŭflua: valida ASCII antaŭ posta eraro eble jam estis tajpita."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type subtenas nur ASCII; uzu tondujan algluon por UTF-8-teksto\n"

msgid "escape mode"
msgstr "eskapreĝimo"

