msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Uzado: release-all\nLiberigu ĉiujn virtualajn klavarajn kaj musbutonojn."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all ne akceptas argumentojn\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Uzado: ydotool <cmd> <args>\nDisponeblaj komandoj:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Uzu release-all por liberigi tenatajn klavojn post perforte haltigita kliento.\n  -h, --help     Montru ĉi tiun helpon kaj eliru\n  -V, --version  Montru versiinformojn kaj eliru\nUzu la mediovariablon YDOTOOL_SOCKET por specifi la daemon-socketon."

