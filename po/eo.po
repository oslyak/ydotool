msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uzado: ydotoold [OPTION]...\nLa ydotool-demono.\n\nOpcioj:\n  -p, --socket-path=PATH     Propra socketa vojo\n  -P, --socket-perm=PERM     Socketaj permesoj (defaŭlte 0600)\n  -o, --socket-own=UID:GID   Socketa posedanto\n  -s, --no-system-keys        Malebligu SysRq kaj ŝaltajn/dormigajn/restartigajn klavojn\n  -m, --mouse-off            Malebligu muson (EV_REL)\n  -k, --keyboard-off         Malebligu klavaron (EV_KEY)\n  -T, --touch-on             Ebligu tuŝekranon (EV_ABS)\n  -h, --help                 Montru ĉi tiun helpon kaj eliru\n  -V, --version              Montru versiinformojn\n"

