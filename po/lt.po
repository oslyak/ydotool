msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nydotool demonas.\n\nParinktys:\n  -p, --socket-path=PATH     Pasirinktinis lizdo kelias\n  -P, --socket-perm=PERM     Lizdo teisės (numatyta 0600)\n  -o, --socket-own=UID:GID   Lizdo savininkas\n  -s, --no-system-keys        Išjungti SysRq ir maitinimo/miego/paleidimo iš naujo klavišus\n  -m, --mouse-off            Išjungti pelę (EV_REL)\n  -k, --keyboard-off         Išjungti klaviatūrą (EV_KEY)\n  -T, --touch-on             Įjungti jutiklinį ekraną (EV_ABS)\n  -h, --help                 Rodyti šią pagalbą ir išeiti\n  -V, --version              Rodyti versijos informaciją\n"

