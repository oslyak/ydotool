msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nĮvesti eilutes.\n\nParinktys:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Delsa N milisekundžių tarp klavišų (delsa tarp kiekvienos paspaudimo ir atleidimo poros) (numatyta: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Laikyti kiekvieną klavišą nuspaustą N milisekundžių (delsa tarp paspaudimo ir atleidimo) (numatyta: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Delsa N milisekundžių tarp komandų eilutės eilučių (numatyta: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Nurodyti failą, kurio turinys bus įvedamas taip, lyg būtų pateiktas kaip argumentas.\n                               filepath taip pat gali būti '-', kad būtų skaitoma iš stdin\n  -e, --escape=BOOL          Įjungti (1) arba išjungti (0) escape apdorojimą\n  -h, --help                 Rodyti šią pagalbą ir išeiti\n\nĮvedant komandų eilutės argumentus Escape įjungtas pagal numatytuosius nustatymus, o įvedant iš failo ir stdin — išjungtas.\nFailo įvestis skaitoma srautu: galiojantis ASCII, perskaitytas prieš vėlesnę klaidą, jau gali būti įvestas."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type palaiko tik ASCII; UTF-8 tekstui rekomenduojama įklijuoti iš iškarpinės\n"

