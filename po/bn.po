msgstr "ydotool: release-all কোনো আর্গুমেন্ট নেয় না\n"
msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "ব্যবহার: ydotool <cmd> <args>\nউপলভ্য কমান্ডসমূহ:"
msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "ক্লায়েন্ট বন্ধ হয়ে গেলে চেপে থাকা কী ছাড়তে release-all ব্যবহার করুন।\n  -h, --help     এই সহায়িকা দেখিয়ে প্রস্থান করুন\n  -V, --version  সংস্করণ তথ্য দেখিয়ে প্রস্থান করুন\nডেমন সকেট নির্দিষ্ট করতে YDOTOOL_SOCKET পরিবেশ ভেরিয়েবল ব্যবহার করুন।"
#, c-format
msgid "ydotool: invalid %s: %s\n"
msgstr "ydotool: অবৈধ %s: %s\n"
