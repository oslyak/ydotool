msgstr "ydotool: সকেট পাথ অত্যন্ত দীর্ঘ\n"
#, c-format
msgid "failed to connect socket `%s': %s\n"
msgstr "`%s' সকেটে সংযোগ ব্যর্থ: %s\n"
msgid "Please check if ydotoold is running.\n"
msgstr "ydotoold চলছে কি না পরীক্ষা করুন।\n"
msgid "Please check if the current user has sufficient permissions to access the socket file.\n"
msgstr "বর্তমান ব্যবহারকারীর সকেট ফাইল ব্যবহারের যথেষ্ট অনুমতি আছে কি না পরীক্ষা করুন।\n"
msgid "ydotool: install signal handler"
msgstr "ydotool: সিগন্যাল হ্যান্ডলার ইনস্টল করুন"
msgid "ydotool: lock socket directory"
msgstr "ydotool: সকেট ডিরেক্টরি লক করুন"
msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "ব্যবহার: ydotoold [OPTION]...\nydotool ডেমন।\n\nবিকল্পসমূহ:\n  -p, --socket-path=PATH     কাস্টম সকেট পাথ\n  -P, --socket-perm=PERM     সকেটের অনুমতি (ডিফল্ট 0600)\n  -o, --socket-own=UID:GID   সকেটের মালিকানা\n  -s, --no-system-keys        SysRq ও পাওয়ার/স্লিপ/রিস্টার্ট কী নিষ্ক্রিয় করুন\n  -m, --mouse-off            মাউস নিষ্ক্রিয় করুন (EV_REL)\n  -k, --keyboard-off         কীবোর্ড নিষ্ক্রিয় করুন (EV_KEY)\n  -T, --touch-on             টাচস্ক্রিন চালু করুন (EV_ABS)\n  -h, --help                 এই সহায়িকা দেখিয়ে প্রস্থান করুন\n  -V, --version              সংস্করণ তথ্য দেখান\n"
