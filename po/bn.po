msgstr "ydotool: stdin পড়ুন"
#, c-format
msgid "Key code: %d %d %d\n"
msgstr "কী কোড: %d %d %d\n"
msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin শুধু ASCII সমর্থন করে; UTF-8 লেখার জন্য ক্লিপবোর্ড থেকে পেস্ট করুন\n"
#, c-format
msgid "  Maps to: %d\n"
msgstr "  রূপান্তরিত হয়: %d\n"
#, c-format
msgid "  Sending shift\n"
msgstr "  shift পাঠানো হচ্ছে\n"
#, c-format
msgid "  Sending ctrl\n"
msgstr "  ctrl পাঠানো হচ্ছে\n"
msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "ব্যবহার: type [OPTION]... [STRINGS]...\nস্ট্রিং টাইপ করুন।\n\nবিকল্পসমূহ:"
#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          কীগুলোর মাঝে N মিলিসেকেন্ড বিরতি (প্রতিটি কী চাপা/ছাড়ার জোড়ার মধ্যবর্তী বিরতি) (ডিফল্ট: %d)\n"
#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           প্রতিটি কী N মিলিসেকেন্ড ধরে রাখুন (কী চাপা ও ছাড়ার মধ্যবর্তী বিরতি) (ডিফল্ট: %d)\n"
#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         কমান্ড-লাইন স্ট্রিংগুলোর মাঝে N মিলিসেকেন্ড বিরতি (ডিফল্ট: %d)\n"
msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            যে ফাইলের বিষয়বস্তু আর্গুমেন্ট হিসেবে দেওয়ার মতো টাইপ হবে, সেই ফাইল নির্দিষ্ট করুন।\n                               stdin থেকে পড়তে ফাইলপাথ '-' হতে পারে\n  -e, --escape=BOOL          Escape চালু (1) বা বন্ধ (0) করুন\n  -h, --help                 এই সহায়িকা দেখিয়ে প্রস্থান করুন\n\nকমান্ড-লাইন আর্গুমেন্ট টাইপ করার সময় Escape ডিফল্টভাবে চালু; ফাইল ও stdin থেকে টাইপের সময় ডিফল্টভাবে বন্ধ।\nফাইল ইনপুট ধারাবাহিকভাবে পড়া হয়: পরের কোনো ত্রুটির আগে বৈধ ASCII ইতিমধ্যে টাইপ হয়ে যেতে পারে।"

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type শুধু ASCII সমর্থন করে; UTF-8 লেখার জন্য ক্লিপবোর্ড থেকে পেস্ট করুন\n"
msgid "escape mode"
msgstr "Escape মোড"
