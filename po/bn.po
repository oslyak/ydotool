msgstr "পুরোনো নিষ্ক্রিয় সকেট সরাতে ব্যর্থ"
msgid "error: Another ydotoold is running with the same socket."
msgstr "ত্রুটি: একই সকেটসহ অন্য ydotoold চলছে।"
msgid "failed to bind socket"
msgstr "সকেট বেঁধে দিতে ব্যর্থ"
msgid "failed to change socket permission"
msgstr "সকেটের অনুমতি পরিবর্তনে ব্যর্থ"
#, c-format
msgid "Socket permission: %s\n"
msgstr "সকেটের অনুমতি: %s\n"
msgid "invalid ownership specification"
msgstr "মালিকানার নির্দিষ্টকরণ অবৈধ"
msgid "failed to run xinput command"
msgstr "xinput কমান্ড চালাতে ব্যর্থ"
msgid "failed to change socket ownership"
msgstr "সকেটের মালিকানা পরিবর্তনে ব্যর্থ"
msgid "ydotoold: write input event"
msgstr "ydotoold: ইনপুট ইভেন্ট লিখুন"
msgid "xinput command not found in `%s', not disabling mouser pointer acceleration"
msgstr "`%s'-এ xinput কমান্ড পাওয়া যায়নি; মাউস পয়েন্টারের ত্বরণ নিষ্ক্রিয় করা হচ্ছে না"
msgid "failed to fork"
msgstr "fork করতে ব্যর্থ"
#, c-format
msgid "Socket ownership: UID=%d, GID=%d\n"
msgstr "সকেটের মালিকানা: UID=%d, GID=%d\n"
