msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uporaba: type [OPTION]... [STRINGS]...\nVnesi nize.\n\nMožnosti:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Zakasnitev N milisekund med tipkami (zakasnitev med vsakim parom pritiska/spusta tipke) (privzeto: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Vsako tipko drži N milisekund (zakasnitev med pritiskom in spustom tipke) (privzeto: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Zakasnitev N milisekund med nizi ukazne vrstice (privzeto: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Določi datoteko, katere vsebina bo vnesena, kot da bi bila podana kot argument.\n                               Pot do datoteke je lahko tudi '-' za branje iz stdin\n  -e, --escape=BOOL          Omogoči (1) ali onemogoči (0) ubežni način\n  -h, --help                 Prikaži to pomoč in končaj\n\nUbežni način je privzeto omogočen pri vnašanju argumentov ukazne vrstice, pri vnašanju iz datoteke in stdin pa je privzeto onemogočen.\nVnos datoteke se pretaka: veljavni ASCII pred poznejšo napako je morda že vnesen."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type podpira samo ASCII; za besedilo UTF-8 uporabite lepljenje iz odložišča\n"

msgid "escape mode"
msgstr "ubežni način"

