msgstr "ydotool: release-all ne sprejema argumentov\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Uporaba: ydotool <cmd> <args>\nRazpoložljivi ukazi:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Za obnovitev pritisnjenih tipk po prisilno končanem odjemalcu uporabite release-all.\n  -h, --help     Prikaži to pomoč in končaj\n  -V, --version  Prikaži podatke o različici in končaj\nZ okoljsko spremenljivko YDOTOOL_SOCKET določite vtičnico demona."

