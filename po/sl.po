msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uporaba: ydotoold [OPTION]...\nDemon ydotool.\n\nMožnosti:\n  -p, --socket-path=PATH     Pot do vtičnice po meri\n  -P, --socket-perm=PERM     Dovoljenja vtičnice (privzeto 0600)\n  -o, --socket-own=UID:GID   Lastništvo vtičnice\n  -s, --no-system-keys        Onemogoči tipke SysRq in tipke za napajanje/spanje/ponovni zagon\n  -m, --mouse-off            Onemogoči miško (EV_REL)\n  -k, --keyboard-off         Onemogoči tipkovnico (EV_KEY)\n  -T, --touch-on             Omogoči zaslon na dotik (EV_ABS)\n  -h, --help                 Prikaži to pomoč in končaj\n  -V, --version              Prikaži podatke o različici\n"

