msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nPíše řetězce.\n\nMožnosti:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Prodleva N milisekund mezi klávesami (prodleva mezi každou dvojicí stisknutí/uvolnění) (výchozí: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Podrží každou klávesu N milisekund (prodleva mezi stisknutím a uvolněním klávesy) (výchozí: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Prodleva N milisekund mezi řetězci z příkazového řádku (výchozí: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Určí soubor, jehož obsah se napíše stejně jako argument.\n                               Cesta k souboru může být také '-' pro čtení ze stdin\n  -e, --escape=BOOL          Zapne (1) nebo vypne (0) interpretaci escape sekvencí\n  -h, --help                 Zobrazí tuto nápovědu a skončí\n\nPři psaní argumentů příkazového řádku je interpretace escape sekvencí ve výchozím nastavení zapnutá; při čtení ze souboru a stdin je ve výchozím nastavení vypnutá.\nVstup ze souboru se zpracovává průběžně: platné ASCII znaky před pozdější chybou už mohly být napsány."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type podporuje pouze ASCII; pro text UTF-8 použijte vložení ze schránky\n"

msgid "escape mode"
msgstr "režim escape sekvencí"

