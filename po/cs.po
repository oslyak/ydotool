msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\\nDémon ydotool.\n\nMožnosti:\n  -p, --socket-path=PATH     Vlastní cesta k soketu\n  -P, --socket-perm=PERM     Oprávnění soketu (výchozí 0600)\n  -o, --socket-own=UID:GID   Vlastník soketu\n  -s, --no-system-keys        Zakáže klávesy SysRq a napájení/uspání/restart\n  -m, --mouse-off            Zakáže myš (EV_REL)\n  -k, --keyboard-off         Zakáže klávesnici (EV_KEY)\n  -T, --touch-on             Povolí dotykovou obrazovku (EV_ABS)\n  -h, --help                 Zobrazí tuto nápovědu a skončí\n  -V, --version              Zobrazí informace o verzi\n"

