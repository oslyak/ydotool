msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Usage: release-all\nUvolní všechny virtuální klávesy a tlačítka myši."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all nepřijímá žádné argumenty\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Usage: ydotool <cmd> <args>\nDostupné příkazy:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Pomocí release-all uvolníte držené klávesy po násilném ukončení klienta.\n  -h, --help     Zobrazí tuto nápovědu a skončí\n  -V, --version  Zobrazí informace o verzi a skončí\nPro určení soketu démona použijte proměnnou prostředí YDOTOOL_SOCKET."

