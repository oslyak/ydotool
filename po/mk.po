msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Употреба: ydotoold [OPTION]...\nДемонот ydotool.\n\nОпции:\n  -p, --socket-path=PATH     Прилагодена патека за сокетот\n  -P, --socket-perm=PERM     Дозволи за сокетот (стандардно 0600)\n  -o, --socket-own=UID:GID   Сопственик на сокетот\n  -s, --no-system-keys        Исклучи ги копчињата SysRq и за напојување/спиење/рестартирање\n  -m, --mouse-off            Исклучи го глушецот (EV_REL)\n  -k, --keyboard-off         Исклучи ја тастатурата (EV_KEY)\n  -T, --touch-on             Вклучи го екранoт на допир (EV_ABS)\n  -h, --help                 Прикажи ја оваа помош и излези\n  -V, --version              Прикажи информации за верзијата\n"

