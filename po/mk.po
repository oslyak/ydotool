msgstr "  Се испраќа ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Употреба: type [OPTION]... [STRINGS]...\nВнесете низи од знаци.\n\nОпции:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Пауза од N милисекунди меѓу копчињата (пауза меѓу секој пар притискање/отпуштање) (стандардно: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Држи го секое копче N милисекунди (пауза меѓу притискањето и отпуштањето) (стандардно: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Пауза од N милисекунди меѓу низите од командната линија (стандардно: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Наведете датотека чија содржина ќе се внесе како да е дадена како аргумент.\n                               Патеката може да биде и '-' за читање од stdin\n  -e, --escape=BOOL          Вклучи (1) или исклучи (0) обработка на escape-знаци\n  -h, --help                 Прикажи ја оваа помош и излези\n\nОбработката на escape-знаци е стандардно вклучена за аргументи од командната линија, а исклучена за читање од датотека и stdin.\nВлезот од датотека се обработува како тек: важечкиот ASCII пред подоцнежна грешка можеби веќе е внесен."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type поддржува само ASCII; за UTF-8 текст користете залепување од таблата со исечоци\n"

msgid "escape mode"
msgstr "режим за escape-знаци"

