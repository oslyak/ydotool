msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Verwendung: type [OPTION]... [STRINGS]...\nZeichenfolgen eingeben.\n\nOptionen:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          N Millisekunden Verzögerung zwischen Tasten, also zwischen Drücken und Loslassen (Standard: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Jede Taste N Millisekunden halten (zwischen Drücken und Loslassen) (Standard: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         N Millisekunden zwischen Befehlszeilen-Zeichenfolgen warten (Standard: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Datei angeben; ihr Inhalt wird wie ein Argument eingegeben.\n                               '-' als Dateipfad liest von stdin\n  -e, --escape=BOOL          Escape-Modus aktivieren (1) oder deaktivieren (0)\n  -h, --help                 Diese Hilfe anzeigen und beenden\n\nEscape ist für Befehlszeilenargumente standardmäßig aktiviert und beim Lesen aus Datei oder stdin standardmäßig deaktiviert.\nDateieingaben werden gestreamt: Gültiger ASCII-Inhalt vor einem späteren Fehler kann bereits eingegeben worden sein."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type unterstützt nur ASCII; für UTF-8-Text Zwischenablage verwenden\n"

msgid "escape mode"
msgstr "Escape-Modus"

