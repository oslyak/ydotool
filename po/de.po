msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Verwendung: key [OPTION]... [KEYCODES]...\nTastenereignisse ausgeben.\n\nOptionen:\n  -d, --key-delay=N          N Millisekunden Verzögerung zwischen Tastenereignissen\n  -h, --help                 Diese Hilfe anzeigen und beenden\n\nDa die Zahl der Tastaturbelegungen weltweit unbekannt ist, verwenden wir rohe Tastencodes.\n\nSyntax: <keycode>:<pressed>\nz. B. bedeutet 28:1 28:0 das Drücken der Eingabetaste auf einer üblichen US-Tastatur.\n     (:1 bedeutet gedrückt, :0 bedeutet losgelassen)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNicht interpretierbare Werte wie 0, aaa, l0l bewirken nur eine Verzögerung.\n\nVerfügbare Tastencodes (KEY_*) stehen in `/usr/include/linux/input-event-codes.h' für Tastencodes.\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Verwendung: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMauszeiger oder Mausrad bewegen.\n\nOptionen:\n  -w, --wheel                Mausrad relativ bewegen\n  -a, --absolute             Absolute Position verwenden, nicht für das Mausrad\n  -x, --xpos                 X-Position\n  -y, --ypos                 Y-Position\n  -h, --help                 Diese Hilfe anzeigen und beenden\n\nFür korrekte absolute Bewegung muss die Mausbeschleunigung deaktiviert werden."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: zu viele Koordinaten\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Mausradbewegungen dürfen keine absoluten Werte sein\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: zwei Koordinaten sind erforderlich\n"

