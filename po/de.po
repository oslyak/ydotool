msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Verwendung: ydotoold [OPTION]...\nDer ydotool-Daemon.\n\nOptionen:\n  -p, --socket-path=PATH     Benutzerdefinierter Socket-Pfad\n  -P, --socket-perm=PERM     Socket-Berechtigung (Standard 0600)\n  -o, --socket-own=UID:GID   Socket-Eigentümer\n  -s, --no-system-keys        SysRq-, Ein-/Ausschalt-, Standby- und Neustarttasten deaktivieren\n  -m, --mouse-off            Maus deaktivieren (EV_REL)\n  -k, --keyboard-off         Tastatur deaktivieren (EV_KEY)\n  -T, --touch-on             Touchscreen aktivieren (EV_ABS)\n  -h, --help                 Diese Hilfe anzeigen und beenden\n  -V, --version              Versionsinformationen anzeigen\n"

