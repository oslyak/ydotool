msgstr "Project-Id-Version: ydotool\nReport-Msgid-Bugs-To: anton@sirius.if.ua\nPOT-Creation-Date: 2026-11-06 02:48+0700\nPO-Revision-Date: 2026-11-06 00:00+0000\nLast-Translator: ydotool translation tooling <anton@sirius.if.ua>\nLanguage-Team: Kannada\nLanguage: kn\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\nX-Native-Review: pending\n"

msgid "Usage: click [OPTION]... [BUTTONS]...\nClick mouse buttons.\n\nOptions:\n  -r, --repeat=N             Repeat entire sequence N times\n  -D, --next-delay=N         Delay N milliseconds between input events (up/down,                                a complete click means doubled time)\n  -P, --press-release        Press & release mouse button to complete a click, (optional)\n  -h, --help                 Display this help and exit\n\nHow to specify buttons:\n  Now all mouse buttons are represented using hexadecimal numeric values, with an optional\nbit mask to specify if mouse up/down needs to be omitted.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Mouse down\n  0x80 - Mouse up\n  Examples:\n    0x00: chooses left button, but does nothing (you can use this to implement extra sleeps)\n    0xC0: left button click (down then up)\n    0x41: right button down\n    0x82: middle button up\n  The '0x' prefix can be omitted if you want.\n"
msgstr "Usage: click [OPTION]... [BUTTONS]...\nಮೌಸ್ ಬಟನ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.\n\nಆಯ್ಕೆಗಳು:\n  -r, --repeat=N             ಸಂಪೂರ್ಣ ಅನುಕ್ರಮವನ್ನು N ಬಾರಿ ಪುನರಾವರ್ತಿಸಿ\n  -D, --next-delay=N         ಇನ್‌ಪುಟ್ ಘಟನೆಗಳ ನಡುವೆ N ಮಿಲಿಸೆಕೆಂಡ್ ವಿರಾಮ (ಕೆಳಗೆ/ಮೇಲೆ,                                ಪೂರ್ಣ ಕ್ಲಿಕ್‌ಗೆ ಇದರ ಎರಡು ಪಟ್ಟು ಸಮಯ ಬೇಕು)\n  -P, --press-release        ಕ್ಲಿಕ್ ಪೂರ್ಣಗೊಳಿಸಲು ಮೌಸ್ ಬಟನ್ ಒತ್ತಿ ಬಿಡಿ (ಐಚ್ಛಿಕ)\n  -h, --help                 ಈ ಸಹಾಯವನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\n\nಬಟನ್‌ಗಳನ್ನು ಸೂಚಿಸುವ ವಿಧಾನ:\n  ಈಗ ಎಲ್ಲ ಮೌಸ್ ಬಟನ್‌ಗಳನ್ನು ಹೆಕ್ಸಾಡೆಸಿಮಲ್ ಸಂಖ್ಯೆಗಳಾಗಿ ಸೂಚಿಸಲಾಗುತ್ತದೆ; ಮೌಸ್ ಮೇಲಕ್ಕೆ/ಕೆಳಕ್ಕೆ ಚಲನೆಯನ್ನು ಕೈಬಿಡಬೇಕೇ ಎಂದು ತಿಳಿಸಲು ಐಚ್ಛಿಕ\nಬಿಟ್ ಮಾಸ್ಕ್ ಬಳಸಬಹುದು.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - ಮೌಸ್ ಕೆಳಕ್ಕೆ\n  0x80 - ಮೌಸ್ ಮೇಲಕ್ಕೆ\n  ಉದಾಹರಣೆಗಳು:\n    0x00: ಎಡ ಬಟನ್ ಆಯ್ಕೆಮಾಡುತ್ತದೆ, ಆದರೆ ಏನೂ ಮಾಡುವುದಿಲ್ಲ (ಹೆಚ್ಚುವರಿ ವಿರಾಮಗಳನ್ನು ಸೇರಿಸಲು ಇದನ್ನು ಬಳಸಬಹುದು)\n    0xC0: ಎಡ ಬಟನ್ ಕ್ಲಿಕ್ (ಕೆಳಕ್ಕೆ, ನಂತರ ಮೇಲಕ್ಕೆ)\n    0x41: ಬಲ ಬಟನ್ ಕೆಳಕ್ಕೆ\n    0x82: ಮಧ್ಯದ ಬಟನ್ ಮೇಲಕ್ಕೆ\n  ಬೇಕಿದ್ದರೆ '0x' ಪೂರ್ವಪ್ರತ್ಯಯವನ್ನು ಬಿಡಬಹುದು.\n"

#, c-format
msgid "option %s"
msgstr "ಆಯ್ಕೆ %s"

#, c-format
msgid " with arg %s"
msgstr " ಆರ್ಗ್ %s ಜೊತೆಗೆ"

msgid "repeat count"
msgstr "ಪುನರಾವರ್ತನೆಗಳ ಸಂಖ್ಯೆ"

msgid "delay (0..60000 ms)"
msgstr "ವಿಳಂಬ (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "ಕ್ಲಿಕ್ ಘಟನೆ %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Usage: key [OPTION]... [KEYCODES]...\nಕೀ ಘಟನೆಗಳನ್ನು ಉಂಟುಮಾಡಿ.\n\nಆಯ್ಕೆಗಳು:\n  -d, --key-delay=N          ಕೀ ಘಟನೆಗಳ ನಡುವೆ N ಮಿಲಿಸೆಕೆಂಡ್ ವಿಳಂಬ\n  -h, --help                 ಈ ಸಹಾಯವನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\n\nಜಗತ್ತಿನಲ್ಲಿ ಎಷ್ಟು ಕೀಬೋರ್ಡ್ ವಿನ್ಯಾಸಗಳಿವೆ ಎಂದು ತಿಳಿಯಲು ಸಾಧ್ಯವಿಲ್ಲದ ಕಾರಣ,\nಈಗ ನಾವು ಮೂಲ keycode-ಗಳನ್ನು ಬಳಸುತ್ತಿದ್ದೇವೆ.\n\nವಾಕ್ಯರಚನೆ: <keycode>:<pressed>\nಉದಾ. 28:1 28:0 ಎಂದರೆ ಪ್ರಮಾಣಿತ US ಕೀಬೋರ್ಡ್‌ನಲ್ಲಿ Enter ಬಟನ್ ಒತ್ತುವುದು.\n     (:1 ಎಂದರೆ ಕೀ ಕೆಳಗಿದೆ; ನಂತರ :0 ಎಂದರೆ ಕೀ ಬಿಡುಗಡೆಯಾಗಿದೆ)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\n0, aaa, l0l ಮುಂತಾದ ಅರ್ಥೈಸಲಾಗದ ಮೌಲ್ಯಗಳು ಕೇವಲ ವಿಳಂಬವನ್ನುಂಟುಮಾಡುತ್ತವೆ.\n\nಲಭ್ಯವಿರುವ ಕೀ ಕೋಡ್‌ಗಳಿಗಾಗಿ `/usr/include/linux/input-event-codes.h' (KEY_*) ನೋಡಿ.\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nಮೌಸ್ ಪಾಯಿಂಟರ್ ಅಥವಾ ಚಕ್ರವನ್ನು ಸರಿಸಿ.\n\nಆಯ್ಕೆಗಳು:\n  -w, --wheel                ಮೌಸ್ ಚಕ್ರವನ್ನು ಸಾಪೇಕ್ಷವಾಗಿ ಸರಿಸಿ\n  -a, --absolute             ಸಂಪೂರ್ಣ ಸ್ಥಾನ ಬಳಸಿ; ಚಕ್ರಕ್ಕೆ ಅನ್ವಯಿಸುವುದಿಲ್ಲ\n  -x, --xpos                 X ಸ್ಥಾನ\n  -y, --ypos                 Y ಸ್ಥಾನ\n  -h, --help                 ಈ ಸಹಾಯವನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\n\nಸಂಪೂರ್ಣ ಚಲನೆಯನ್ನು ಸರಿಯಾಗಿ ಮಾಡಲು ಮೌಸ್ ವೇಗದ ವೇಗವರ್ಧನೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಬೇಕು."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: ತುಂಬಾ ಹೆಚ್ಚು ನಿರ್ದೇಶಾಂಕಗಳು\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "ಮೌಸ್ ಚಕ್ರದ ಚಲನೆಗಳು ಸಂಪೂರ್ಣ ಮೌಲ್ಯಗಳಾಗಿರಬಾರದು\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: ಎರಡು ನಿರ್ದೇಶಾಂಕಗಳು ಅಗತ್ಯ\n"

#, c-format
msgid "Type anything (CTRL-C to exit):\n"
msgstr "ಏನನ್ನಾದರೂ ಟೈಪ್ ಮಾಡಿ (ನಿರ್ಗಮಿಸಲು CTRL-C):\n"

msgid "ydotool: read stdin"
msgstr "ydotool: stdin ಓದಿ"

#, c-format
msgid "Key code: %d %d %d\n"
msgstr "ಕೀ ಕೋಡ್: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin ASCII ಮಾತ್ರ ಬೆಂಬಲಿಸುತ್ತದೆ; UTF-8 ಪಠ್ಯಕ್ಕೆ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ನಿಂದ ಅಂಟಿಸಿ\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  ಇದಕ್ಕೆ ಮ್ಯಾಪ್ ಆಗುತ್ತದೆ: %d\n"

#, c-format
msgid "  Sending shift\n"
msgstr "  shift ಕಳುಹಿಸಲಾಗುತ್ತಿದೆ\n"

#, c-format
msgid "  Sending ctrl\n"
msgstr "  ctrl ಕಳುಹಿಸಲಾಗುತ್ತಿದೆ\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nಸ್ಟ್ರಿಂಗ್‌ಗಳನ್ನು ಟೈಪ್ ಮಾಡಿ.\n\nಆಯ್ಕೆಗಳು:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          ಕೀಗಳ ನಡುವೆ N ಮಿಲಿಸೆಕೆಂಡ್ ವಿಳಂಬ (ಪ್ರತಿ ಕೀ ಕೆಳಗೆ/ಮೇಲೆ ಜೋಡಿಯ ನಡುವಿನ ವಿಳಂಬ) (ಪೂರ್ವನಿಯೋಜಿತ: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           ಪ್ರತಿ ಕೀಯನ್ನು N ಮಿಲಿಸೆಕೆಂಡ್ ಹಿಡಿದಿಡಿ (ಕೀ ಕೆಳಗೆ ಮತ್ತು ಮೇಲೆ ನಡುವಿನ ವಿಳಂಬ) (ಪೂರ್ವನಿಯೋಜಿತ: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         ಆಜ್ಞಾ ಸಾಲಿನ ಸ್ಟ್ರಿಂಗ್‌ಗಳ ನಡುವೆ N ಮಿಲಿಸೆಕೆಂಡ್ ವಿಳಂಬ (ಪೂರ್ವನಿಯೋಜಿತ: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            ಫೈಲ್ ಸೂಚಿಸಿ; ಅದರ ವಿಷಯವನ್ನು ಆರ್ಗ್ಯುಮೆಂಟ್‌ನಂತೆ ನೀಡಿದರೆ ಹೇಗೆ ಟೈಪ್ ಆಗುತ್ತದೆಯೋ ಹಾಗೆ ಟೈಪ್ ಮಾಡಲಾಗುತ್ತದೆ.\n                               stdin ನಿಂದ ಓದಲು ಫೈಲ್ ಪಥ '-' ಆಗಿರಬಹುದು\n  -e, --escape=BOOL          Escape ಸಕ್ರಿಯ (1) ಅಥವಾ ನಿಷ್ಕ್ರಿಯ (0)\n  -h, --help                 ಈ ಸಹಾಯವನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\n\nಆಜ್ಞಾ ಸಾಲಿನ ಆರ್ಗ್ಯುಮೆಂಟ್‌ಗಳನ್ನು ಟೈಪ್ ಮಾಡುವಾಗ Escape ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ಸಕ್ರಿಯವಾಗಿರುತ್ತದೆ; ಫೈಲ್ ಮತ್ತು stdin ನಿಂದ ಟೈಪ್ ಮಾಡುವಾಗ ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ನಿಷ್ಕ್ರಿಯವಾಗಿರುತ್ತದೆ.\nಫೈಲ್ ಇನ್‌ಪುಟ್ ಸ್ಟ್ರೀಮ್ ಆಗಿ ಓದಲಾಗುತ್ತದೆ: ನಂತರ ದೋಷ ಬಂದರೂ ಅದಕ್ಕೂ ಮೊದಲು ಇರುವ ಸರಿಯಾದ ASCII ಈಗಾಗಲೇ ಟೈಪ್ ಆಗಿರಬಹುದು."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type ASCII ಮಾತ್ರ ಬೆಂಬಲಿಸುತ್ತದೆ; UTF-8 ಪಠ್ಯಕ್ಕೆ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ನಿಂದ ಅಂಟಿಸಿ\n"

msgid "escape mode"
msgstr "escape ವಿಧಾನ"

#, c-format
msgid "ydotool: type: error: failed to open %s: %s\n"
msgstr "ydotool: type: ದೋಷ: %s ತೆರೆಯಲಾಗಲಿಲ್ಲ: %s\n"

#, c-format
msgid "ydotool: type: error: read %s failed: %s\n"
msgstr "ydotool: type: ದೋಷ: %s ಓದಲು ವಿಫಲ: %s\n"

msgid "These are our honorable bakers:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"
msgstr "ನಮ್ಮ ಗೌರವಾನ್ವಿತ ಕೊಡುಗೆದಾರರು:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Usage: release-all\nಎಲ್ಲ ವರ್ಚುವಲ್ ಕೀಬೋರ್ಡ್ ಮತ್ತು ಮೌಸ್ ಬಟನ್‌ಗಳನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿ."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all ಗೆ ಆರ್ಗ್ಯುಮೆಂಟ್‌ಗಳು ಬೇಡ\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Usage: ydotool <cmd> <args>\nಲಭ್ಯವಿರುವ ಆಜ್ಞೆಗಳು:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "ಕ್ಲೈಂಟ್ ಬಲವಂತವಾಗಿ ಮುಚ್ಚಿದ ನಂತರ ಒತ್ತಿಹಿಡಿದ ಕೀಗಳನ್ನು ಬಿಡುಗಡೆ ಮಾಡಲು release-all ಬಳಸಿ.\n  -h, --help     ಈ ಸಹಾಯವನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\n  -V, --version  ಆವೃತ್ತಿ ಮಾಹಿತಿಯನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\nಡೀಮನ್ ಸಾಕೆಟ್ ಸೂಚಿಸಲು YDOTOOL_SOCKET ಪರಿಸರ ಚರವನ್ನು ಬಳಸಿ."

#, c-format
msgid "ydotool: invalid %s: %s\n"
msgstr "ydotool: ಅಮಾನ್ಯ %s: %s\n"

msgid "ydotool: send input event"
msgstr "ydotool: ಇನ್‌ಪುಟ್ ಘಟನೆಯನ್ನು ಕಳುಹಿಸಿ"

#, c-format
msgid "ydotool: Unknown command: %s\nRun 'ydotool help' if you want a command list\n"
msgstr "ydotool: ತಿಳಿಯದ ಆಜ್ಞೆ: %s\nಆಜ್ಞೆಗಳ ಪಟ್ಟಿಗಾಗಿ 'ydotool help' ಚಲಾಯಿಸಿ\n"

msgid "failed to create socket"
msgstr "ಸಾಕೆಟ್ ರಚಿಸಲು ವಿಫಲ"

