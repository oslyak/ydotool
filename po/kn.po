msgstr "ydotool: ಸಾಕೆಟ್ ಪಥ ತುಂಬಾ ಉದ್ದವಾಗಿದೆ\n"

#, c-format
msgid "failed to connect socket `%s': %s\n"
msgstr "`%s' ಸಾಕೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಲು ವಿಫಲ: %s\n"

msgid "Please check if ydotoold is running.\n"
msgstr "ydotoold ಚಾಲನೆಯಲ್ಲಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ.\n"

msgid "Please check if the current user has sufficient permissions to access the socket file.\n"
msgstr "ಪ್ರಸ್ತುತ ಬಳಕೆದಾರರಿಗೆ ಸಾಕೆಟ್ ಫೈಲ್ ಪ್ರವೇಶಿಸಲು ಸಾಕಷ್ಟು ಅನುಮತಿಗಳಿವೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ.\n"

msgid "ydotool: install signal handler"
msgstr "ydotool: ಸಿಗ್ನಲ್ ಹ್ಯಾಂಡ್ಲರ್ ಸ್ಥಾಪಿಸಿ"

msgid "ydotool: lock socket directory"
msgstr "ydotool: ಸಾಕೆಟ್ ಡೈರೆಕ್ಟರಿಯನ್ನು ಲಾಕ್ ಮಾಡಿ"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nydotool ಡೀಮನ್.\n\nಆಯ್ಕೆಗಳು:\n  -p, --socket-path=PATH     ಕಸ್ಟಮ್ ಸಾಕೆಟ್ ಪಥ\n  -P, --socket-perm=PERM     ಸಾಕೆಟ್ ಅನುಮತಿ (ಪೂರ್ವನಿಯೋಜಿತ 0600)\n  -o, --socket-own=UID:GID   ಸಾಕೆಟ್ ಮಾಲೀಕತ್ವ\n  -s, --no-system-keys        SysRq ಮತ್ತು power/sleep/restart ಕೀಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ\n  -m, --mouse-off            ಮೌಸ್ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ (EV_REL)\n  -k, --keyboard-off         ಕೀಬೋರ್ಡ್ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ (EV_KEY)\n  -T, --touch-on             ಟಚ್‌ಸ್ಕ್ರೀನ್ ಸಕ್ರಿಯಗೊಳಿಸಿ (EV_ABS)\n  -h, --help                 ಈ ಸಹಾಯವನ್ನು ತೋರಿಸಿ ನಿರ್ಗಮಿಸಿ\n  -V, --version              ಆವೃತ್ತಿ ಮಾಹಿತಿಯನ್ನು ತೋರಿಸಿ\n"

