msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uso: type [OPTION]... [STRINGS]...\nEscribe cadeas de texto.\n\nOpcións:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Agarda N milisegundos entre teclas (atraso entre cada par de pulsación/soltura) (por defecto: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Mantén cada tecla premida N milisegundos (atraso entre pulsar e soltar) (por defecto: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Agarda N milisegundos entre cadeas da liña de ordes (por defecto: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Indica un ficheiro e escribe o seu contido coma se fose un argumento.\n                               A ruta tamén pode ser «-» para ler de stdin\n  -e, --escape=BOOL          Activa (1) ou desactiva (0) o escapado\n  -h, --help                 Mostra esta axuda e sae\n\nO escapado está activado por defecto para argumentos da liña de ordes e desactivado ao ler de ficheiro e stdin.\nA entrada do ficheiro procésase en fluxo: pode que xa se escribise o ASCII válido anterior a un erro posterior."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type só admite ASCII; pega o texto UTF-8 desde o portapapeis\n"

msgid "escape mode"
msgstr "modo de escapado"

