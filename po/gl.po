msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uso: ydotoold [OPTION]...\nO daemon ydotool.\n\nOpcións:\n  -p, --socket-path=PATH     Ruta personalizada do socket\n  -P, --socket-perm=PERM     Permisos do socket (por defecto 0600)\n  -o, --socket-own=UID:GID   Propietario do socket\n  -s, --no-system-keys        Desactiva SysRq e as teclas de acendido/suspensión/reinicio\n  -m, --mouse-off            Desactiva o rato (EV_REL)\n  -k, --keyboard-off         Desactiva o teclado (EV_KEY)\n  -T, --touch-on             Activa a pantalla táctil (EV_ABS)\n  -h, --help                 Mostra esta axuda e sae\n  -V, --version              Mostra a información da versión\n"

