msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Uso: release-all\nLibera todos os botóns virtuais do teclado e do rato."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all non acepta argumentos\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Uso: ydotool <cmd> <args>\nOrdes dispoñibles:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Usa release-all para recuperar as teclas premidas se se pechou un cliente á forza.\n  -h, --help     Mostra esta axuda e sae\n  -V, --version  Mostra a información da versión e sae\nUsa a variable de contorno YDOTOOL_SOCKET para indicar o socket do daemon."

