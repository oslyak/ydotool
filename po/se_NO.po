msgstr "ydotool: lohkat sokketa máhpa"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Geavaheapmi: ydotoold [OPTION]...\nydotool-dihtor.\n\nMolssaeavttut:\n  -p, --socket-path=PATH     Iežas sokketbálggis\n  -P, --socket-perm=PERM     Sokketa lohpi (standárda 0600)\n  -o, --socket-own=UID:GID   Sokketa eaiggátvuohta\n  -s, --no-system-keys        Váldde eret SysRq ja fámu/oađđin/ođđasisálggahan-boaluid\n  -m, --mouse-off            Heaittit sáhpána (EV_REL)\n  -k, --keyboard-off         Heaittit boallobeavddi (EV_KEY)\n  -T, --touch-on             Bidjat čuozahangeavtti doibmii (EV_ABS)\n  -h, --help                 Čájet dán veahki ja heaittit\n  -V, --version              Čájet veršuvdnadieđuid\n"

