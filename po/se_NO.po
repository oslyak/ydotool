msgstr "maŋidusa áigi (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "Deaddindáhpáhus %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Geavaheapmi: key [OPTION]... [KEYCODES]...\nSádde boallodáhpáhusaid.\n\nMolssaeavttut:\n  -d, --key-delay=N          Maŋidit N millisekundda boallodáhpáhusaid gaskkas\n  -h, --help                 Čájet dán veahki ja heaittit\n\nGo eat dieđe man ollu boalloplánaid máilmmis gávdnojit,\ngeavahit dál njuolga boallokodaid.\n\nSyntáksa: <keycode>:<pressed>\nOvdamearka: 28:1 28:0 mearkkaša ahte Enter-boalu deaddá standárda US boallobeavddis.\n     (:1 deaddima várás mearkkaša ahte boallu vuolá, ja deattin :0 luoitá boalu)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nÁrvvut maid ii sáhte dulkojit, nugo 0, aaa, l0l, dagahit dušše maŋidusa.\n\nGeahča `/usr/include/linux/input-event-codes.h' gávdnon boallokodaid várás (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Geavaheapmi: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nSirdde sáhpána čuoggá dahje jođánasa.\n\nMolssaeavttut:\n  -w, --wheel                Sirdde sáhpána jođánasa relatiiva ládje\n  -a, --absolute             Geavat absoluhtta sajádaga, ii heive jođánassii\n  -x, --xpos                 X-sajádat\n  -y, --ypos                 Y-sajádat\n  -h, --help                 Čájet dán veahki ja heaittit\n\nVálmmaš absoluhtta sirddema várás fertet heaittihit sáhpána leaktu jorgaleami."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: koordináhtaid lea beare ollu\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Sáhpána jođánassirddema árvvut eai galgga leat absoluhtta árvvut\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: guokte koordináhta dárbbašuvvojit\n"

#, c-format
msgid "Type anything (CTRL-C to exit):\n"
msgstr "Čále maid beare (CTRL-C heaittihan várás):\n"

msgid "ydotool: read stdin"
msgstr "ydotool: stdin lohkan"

#, c-format
msgid "Key code: %d %d %d\n"
msgstr "Boallokoda: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin doarju dušše ASCII; geavat čuohpadássa UTF-8 teavstta liibmemii\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  Jorgaluvvá dása: %d\n"

#, c-format
