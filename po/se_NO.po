msgstr "  Sáddemin shift\n"

#, c-format
msgid "  Sending ctrl\n"
msgstr "  Sáddemin ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Geavaheapmi: type [OPTION]... [STRINGS]...\nČále teavstaráidduid.\n\nMolssaeavttut:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Maŋidit N millisekundda boaluid gaskkas (maŋidusa áigi juohke boalu vuolá/luoitin-joavkku gaskkas) (standárdaárvu: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Doalat juohke boalu N millisekundda (boalu vuoládeami ja luoitima gaskkas) (standárdaárvu: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Maŋidit N millisekundda kommándoráidduid gaskkas (standárdaárvu: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Meroštala fiilla, man sisdoallu čállojuvvo nugo dat livččii addojuvvon árgumeantan.\n                               Fiilabálgá sáhttá maid leat '-' vai lohkat stdin:s\n  -e, --escape=BOOL          Bidjat Escape doibmii (1) dahje váldit eret (0)\n  -h, --help                 Čájet dán veahki ja heaittit\n\nEscape lea standárdan alde go kommándolinnjás čállá árgumeanttaid, ja standárdan eret go fiillas dahje stdin:s lohká.\nFiilasisdoallu sáddejuvvo striimman: gustojeaddji ASCII ovdal maŋit meattáhusa sáhttá leat juo čállojuvvon."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type doarju dušše ASCII; geavat čuohpadássa UTF-8 teavstta liibmemii\n"

msgid "escape mode"
msgstr "Escape-modus"

