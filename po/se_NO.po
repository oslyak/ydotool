msgstr "Dát leat min gudnejahttojuvvon bákkit:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Geavaheapmi: release-all\nLuoitte buot virtuellalaš boallobeavddi ja sáhpána boaluid."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all ii váldde árgumeanttaid\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Geavaheapmi: ydotool <cmd> <args>\nOlamuttus kommándot:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Geavat release-all oaččun dihte ruhttojuvvon boaluid maŋŋil go kliente lea goddojuvvon.\n  -h, --help     Čájet dán veahki ja heaittit\n  -V, --version  Čájet veršuvdnadieđuid ja heaittit\nGeavat birasvariábila YDOTOOL_SOCKET mearridit dihtora sokketa."

