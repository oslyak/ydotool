msgstr "Utilizare: type [OPTION]... [STRINGS]...\nTastați șiruri.\n\nOpțiuni:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Întârziere de N milisecunde între taste (întârzierea dintre fiecare pereche apăsare/eliberare) (implicit: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Țineți fiecare tastă apăsată N milisecunde (întârzierea dintre apăsarea și eliberarea tastei) (implicit: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Întârziere de N milisecunde între șirurile din linia de comandă (implicit: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Specificați un fișier al cărui conținut va fi tastat ca și cum ar fi fost transmis ca argument.\n                               Calea fișierului poate fi și '-' pentru citirea din stdin\n  -e, --escape=BOOL          Activați (1) sau dezactivați (0) modul escape\n  -h, --help                 Afișați acest ajutor și ieșiți\n\nModul escape este activat implicit la tastarea argumentelor din linia de comandă și dezactivat implicit la tastarea din fișier și stdin.\nIntrarea din fișier este transmisă în flux: textul ASCII valid dinaintea unei erori ulterioare poate fi deja tastat."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type acceptă numai ASCII; folosiți lipirea din clipboard pentru text UTF-8\n"

