msgstr "Bikaranîn: type [OPTION]... [STRINGS]...\nRêzikên nivîsê binivîse.\n\nVebijêrk:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Di navbera bişkojkan de N mîlîçirkeyan raweste (navbera her cotê daketin/rabûnê) (pêşdiyar: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Her bişkojkê N mîlîçirkeyan tikandî bigire (navbera tikandin û berdanê) (pêşdiyar: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Di navbera rêzikên rêza fermanê de N mîlîçirkeyan raweste (pêşdiyar: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Pelekê diyar bike; naveroka wê wek argûmanê hatibe dayîn dê were nivîsandin.\n                               Riya pelê dikare '-' be ji bo xwendina ji stdin\n  -e, --escape=BOOL          Şîrovekirina nîşaneyên revê çalak (1) an neçalak (0) bike\n  -h, --help                 Vê alîkariyê nîşan bide û derkeve\n\nŞîrovekirina nîşaneyên revê ji bo argûmanên rêza fermanê bi pêşdiyarî çalak e; ji bo pel û stdin bi pêşdiyarî neçalak e.\nTêketina pelê bi herikînê tê xwendin: berî xeletiyeke paşîn, dibe ku beşa ASCII ya derbasdar jixwe hatibe nivîsandin."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type tenê ASCII piştgirî dike; ji bo nivîsa UTF-8 ji panoyê pêve bikin\n"

msgid "escape mode"
msgstr "moda şîrovekirina nîşaneyên revê"

