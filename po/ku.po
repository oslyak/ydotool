msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Bikaranîn: ydotoold [OPTION]...\nDaemonê ydotool.\n\nVebijêrk:\n  -p, --socket-path=PATH     Riya soketê ya taybet\n  -P, --socket-perm=PERM     Destûrên soketê (pêşdiyar 0600)\n  -o, --socket-own=UID:GID   Xwedîtiya soketê\n  -s, --no-system-keys        Bişkojkên SysRq û hêz/xew/ji-nû-ve-destpêkirinê neçalak bike\n  -m, --mouse-off            Mişkê neçalak bike (EV_REL)\n  -k, --keyboard-off         Klavyeyê neçalak bike (EV_KEY)\n  -T, --touch-on             Ekrana destdanê çalak bike (EV_ABS)\n  -h, --help                 Vê alîkariyê nîşan bide û derkeve\n  -V, --version              Agahiyên guhertoyê nîşan bide\n"

