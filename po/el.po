msgstr "ydotool: το stdin υποστηρίζει μόνο ASCII· χρησιμοποιήστε επικόλληση από το πρόχειρο για κείμενο UTF-8\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  Αντιστοιχεί σε: %d\n"

msgid "  Sending shift\n"
msgstr "  Αποστολή shift\n"

msgid "  Sending ctrl\n"
msgstr "  Αποστολή ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Χρήση: type [OPTION]... [STRINGS]...\nΠληκτρολόγηση συμβολοσειρών.\n\nΕπιλογές:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Καθυστέρηση N χιλιοστών του δευτερολέπτου μεταξύ πλήκτρων (καθυστέρηση ανά ζεύγος πατήματος/απελευθέρωσης) (προεπιλογή: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Κράτημα κάθε πλήκτρου για N χιλιοστά του δευτερολέπτου (καθυστέρηση μεταξύ πατήματος και απελευθέρωσης) (προεπιλογή: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Καθυστέρηση N χιλιοστών του δευτερολέπτου μεταξύ συμβολοσειρών γραμμής εντολών (προεπιλογή: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Ορισμός αρχείου, του οποίου τα περιεχόμενα θα πληκτρολογηθούν σαν να είχαν δοθεί ως όρισμα.\n                               Η διαδρομή αρχείου μπορεί επίσης να είναι '-' για ανάγνωση από stdin\n  -e, --escape=BOOL          Ενεργοποίηση escape (1) ή απενεργοποίηση (0)\n  -h, --help                 Εμφάνιση αυτής της βοήθειας και έξοδος\n\nΤο escape είναι ενεργό από προεπιλογή κατά την πληκτρολόγηση ορισμάτων γραμμής εντολών και ανενεργό από προεπιλογή κατά την πληκτρολόγηση από αρχείο και stdin.\nΗ είσοδος αρχείου μεταδίδεται σταδιακά: έγκυρο ASCII πριν από μεταγενέστερο σφάλμα μπορεί να έχει ήδη πληκτρολογηθεί."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: το type υποστηρίζει μόνο ASCII· χρησιμοποιήστε επικόλληση από το πρόχειρο για κείμενο UTF-8\n"

msgid "escape mode"
msgstr "λειτουργία escape"

