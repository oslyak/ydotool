msgstr "Συμβάν κλικ %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Χρήση: key [OPTION]... [KEYCODES]...\nΠαραγωγή συμβάντων πλήκτρων.\n\nΕπιλογές:\n  -d, --key-delay=N          Καθυστέρηση N χιλιοστών του δευτερολέπτου μεταξύ συμβάντων πλήκτρων\n  -h, --help                 Εμφάνιση αυτής της βοήθειας και έξοδος\n\nΚαθώς δεν υπάρχει τρόπος να γνωρίζουμε πόσες διατάξεις πληκτρολογίου υπάρχουν στον κόσμο,\nχρησιμοποιούμε πλέον ακατέργαστους κωδικούς πλήκτρων.\n\nΣύνταξη: <keycode>:<pressed>\nπ.χ. 28:1 28:0 σημαίνει πάτημα του πλήκτρου Enter (US) σε ένα τυπικό πληκτρολόγιο ΗΠΑ.\n     (όπου :1 σημαίνει ότι το πλήκτρο είναι πατημένο και έπειτα το :0 ότι έχει απελευθερωθεί)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nΜη ερμηνεύσιμες τιμές, όπως 0, aaa, l0l, προκαλούν μόνο καθυστέρηση.\n\nΔείτε το `/usr/include/linux/input-event-codes.h' για διαθέσιμους κωδικούς πλήκτρων (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Χρήση: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nΜετακίνηση του δείκτη ή του τροχού του ποντικιού.\n\nΕπιλογές:\n  -w, --wheel                Σχετική μετακίνηση του τροχού του ποντικιού\n  -a, --absolute             Χρήση απόλυτης θέσης· δεν ισχύει για τον τροχό\n  -x, --xpos                 Θέση X\n  -y, --ypos                 Θέση Y\n  -h, --help                 Εμφάνιση αυτής της βοήθειας και έξοδος\n\nΓια σωστή απόλυτη μετακίνηση πρέπει να απενεργοποιήσετε την επιτάχυνση ταχύτητας του ποντικιού."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: πάρα πολλές συντεταγμένες\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Οι κινήσεις του τροχού του ποντικιού δεν πρέπει να είναι απόλυτες τιμές\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: απαιτούνται δύο συντεταγμένες\n"

