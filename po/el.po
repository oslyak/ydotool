msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Χρήση: ydotoold [OPTION]...\nΟ δαίμονας ydotool.\n\nΕπιλογές:\n  -p, --socket-path=PATH     Προσαρμοσμένη διαδρομή socket\n  -P, --socket-perm=PERM     Δικαιώματα socket (προεπιλογή 0600)\n  -o, --socket-own=UID:GID   Ιδιοκτησία socket\n  -s, --no-system-keys        Απενεργοποίηση πλήκτρων SysRq και λειτουργίας/ύπνου/επανεκκίνησης\n  -m, --mouse-off            Απενεργοποίηση ποντικιού (EV_REL)\n  -k, --keyboard-off         Απενεργοποίηση πληκτρολογίου (EV_KEY)\n  -T, --touch-on             Ενεργοποίηση οθόνης αφής (EV_ABS)\n  -h, --help                 Εμφάνιση αυτής της βοήθειας και έξοδος\n  -V, --version              Εμφάνιση πληροφοριών έκδοσης\n"

