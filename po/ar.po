msgstr "الاستخدام: type [OPTION]... [STRINGS]...\nاكتب سلاسل نصية.\n\nالخيارات:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          التأخير بالمللي ثانية بين المفاتيح (بين كل زوج ضغط/رفع) (الافتراضي: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           أبقِ كل مفتاح مضغوطاً N مللي ثانية (التأخير بين الضغط والرفع) (الافتراضي: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         التأخير بالمللي ثانية بين سلاسل سطر الأوامر (الافتراضي: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            حدد ملفاً واكتب محتواه كما لو أُمرر كوسيط.\n                             يمكن أن يكون مسار الملف '-' للقراءة من stdin\n  -e, --escape=BOOL          فعّل Escape (1) أو عطّله (0)\n  -h, --help                 اعرض هذه المساعدة ثم اخرج\n\nيكون Escape مفعّلاً افتراضياً عند الكتابة من وسائط سطر الأوامر، ومعطّلاً افتراضياً عند الكتابة من ملف أو stdin.\nتُقرأ بيانات الملف على شكل تدفق: قد تكون محارف ASCII الصحيحة قبل خطأ لاحق قد كُتبت بالفعل."

