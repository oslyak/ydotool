msgstr "таваққуф (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "Рӯйдоди пахш %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Истифода: key [OPTION]... [KEYCODES]...\nРӯйдодҳои тугмаҳоро фиристед.\n\nПараметрҳо:\n  -d, --key-delay=N          Байни рӯйдодҳои тугма N миллисония таваққуф кунед\n  -h, --help                 Ин роҳнаморо нишон диҳед ва бароед\n\nАзбаски шумораи тарҳҳои клавиатура дар ҷаҳонро донистан имкон надорад,\nҳоло кодҳои хоми тугмаҳоро истифода мебарем.\n\nСинтаксис: <keycode>:<pressed>\nмасалан, 28:1 28:0 пахш кардани тугмаи Enter дар клавиатураи стандартии US аст.\n     (дар ин ҷо :1 маънои поён будани тугма ва :0 маънои раҳо шудани онро дорад)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nҚиматҳои тафсирнашаванда, монанди 0, aaa, l0l, танҳо таваққуфро ба вуҷуд меоранд.\n\nБарои дидани кодҳои дастраси тугмаҳо (KEY_*) ба `/usr/include/linux/input-event-codes.h' нигаред.\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Истифода: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nНишоннамо ё чархи мушро ҳаракат диҳед.\n\nПараметрҳо:\n  -w, --wheel                Чархи мушро нисбӣ ҳаракат диҳед\n  -a, --absolute             Ҷойгоҳи мутлақро истифода баред; барои чарх татбиқ намешавад\n  -x, --xpos                 Ҷойгоҳи X\n  -y, --ypos                 Ҷойгоҳи Y\n  -h, --help                 Ин роҳнаморо нишон диҳед ва бароед\n\nБарои ҳаракати дурусти мутлақ бояд шитоби суръати мушро хомӯш кунед."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: координатҳо аз ҳад зиёданд\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Ҳаракати чархи муш набояд қимати мутлақ бошад\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: ду координат лозим аст\n"

msgid "Type anything (CTRL-C to exit):\n"
msgstr "Ҳар чизеро ворид кунед (барои баромадан CTRL-C):\n"

