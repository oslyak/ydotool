msgid "Key code: %d %d %d\n"
msgstr "Рамзи тугма: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin танҳо ASCII-ро дастгирӣ мекунад; барои матни UTF-8 аз часпондан аз силули мухобиротӣ истифода баред\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  Ба ин рамз табдил меёбад: %d\n"

msgid "  Sending shift\n"
msgstr "  Фиристодани shift\n"

msgid "  Sending ctrl\n"
msgstr "  Фиристодани ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Истифода: type [OPTION]... [STRINGS]...\nСатрҳоро чоп кунед.\n\nПараметрҳо:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Байни тугмаҳо N миллисония таваққуф кунед (фосила байни ҳар ҷуфти поён/боло) (пешфарз: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Ҳар тугмаро N миллисония нигоҳ доред (фосилаи байни поён ва боло шудани тугма) (пешфарз: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Байни сатрҳои сатри фармон N миллисония таваққуф кунед (пешфарз: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Файлро муайян кунед; муҳтавои он мисли аргумент чоп карда мешавад.\n                               Ба ҷойи роҳи файл '-' гузошта, аз stdin хондан мумкин аст\n  -e, --escape=BOOL          Escape-ро фаъол (1) ё ғайрифаъол (0) кунед\n  -h, --help                 Ин роҳнаморо нишон диҳед ва бароед\n\nҲангоми чопи аргументҳои сатри фармон Escape бо нобаёнӣ фаъол аст; ҳангоми хондан аз файл ё stdin он бо нобаёнӣ ғайрифаъол аст.\nВуруди файл ҷараёнӣ аст: матни дурусти ASCII то хатои баъдӣ шояд аллакай чоп шуда бошад."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type танҳо ASCII-ро дастгирӣ мекунад; барои матни UTF-8 аз часпондан аз силули мухобиротӣ истифода баред\n"

msgid "escape mode"
msgstr "ҳолати escape"

