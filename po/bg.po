msgstr "  Изпращане на ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Употреба: type [OPTION]... [STRINGS]...\nВъвеждане на текстови низове.\n\nОпции:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Изчакване N милисекунди между клавишите (между всяка двойка натискане/отпускане) (по подразбиране: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Задържане на всеки клавиш N милисекунди (между натискането и отпускането) (по подразбиране: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Изчакване N милисекунди между низовете от командния ред (по подразбиране: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Посочва файл, чието съдържание ще бъде въведено като аргумент.\n                               Пътят може да е и '-' за четене от stdin\n  -e, --escape=BOOL          Включване (1) или изключване (0) на escape обработката\n  -h, --help                 Показва тази помощ и излиза\n\nEscape обработката е включена по подразбиране за аргументи от командния ред и изключена за файл и stdin.\nВходът от файл се обработва поточно: валидният ASCII текст преди последваща грешка може вече да е бил въведен."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type поддържа само ASCII; за UTF-8 текст поставете от клипборда\n"

msgid "escape mode"
msgstr "режим escape"

