msgid "failed to connect socket `%s': %s\n"
msgstr "неуспешно свързване със сокета `%s': %s\n"

msgid "Please check if ydotoold is running.\n"
msgstr "Проверете дали ydotoold работи.\n"

msgid "Please check if the current user has sufficient permissions to access the socket file.\n"
msgstr "Проверете дали текущият потребител има достатъчни права за достъп до файла на сокета.\n"

msgid "ydotool: install signal handler"
msgstr "ydotool: инсталиране на обработчик на сигнал"

msgid "ydotool: lock socket directory"
msgstr "ydotool: заключване на директорията на сокета"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Употреба: ydotoold [OPTION]...\nДемонът ydotool.\n\nОпции:\n  -p, --socket-path=PATH     Потребителски път до сокета\n  -P, --socket-perm=PERM     Права за сокета (по подразбиране 0600)\n  -o, --socket-own=UID:GID   Собственик на сокета\n  -s, --no-system-keys        Изключване на клавишите SysRq и за захранване/заспиване/рестартиране\n  -m, --mouse-off            Изключване на мишката (EV_REL)\n  -k, --keyboard-off         Изключване на клавиатурата (EV_KEY)\n  -T, --touch-on             Включване на сензорния екран (EV_ABS)\n  -h, --help                 Показва тази помощ и излиза\n  -V, --version              Показва информацията за версията\n"

