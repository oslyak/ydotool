msgstr "ydotool: четене от stdin"

#, c-format
msgid "Key code: %d %d %d\n"
msgstr "Код на клавиша: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin поддържа само ASCII; за UTF-8 текст поставете от клипборда\n"

#, c-format
