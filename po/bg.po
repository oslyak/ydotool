msgstr "Това са нашите уважавани създатели:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Употреба: release-all\nОтпуска всички виртуални клавиши и бутони на мишката."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all не приема аргументи\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Употреба: ydotool <cmd> <args>\nНалични команди:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Използвайте release-all, за да освободите задържани клавиши след прекратен клиент.\n  -h, --help     Показва тази помощ и излиза\n  -V, --version  Показва информацията за версията и излиза\nИзползвайте променливата на средата YDOTOOL_SOCKET, за да зададете сокета на демона."

