msgstr "ydotool: Непозната команда: %s\nИзпълнете 'ydotool help', за да видите списъка с команди\n"

msgid "failed to create socket"
msgstr "неуспешно създаване на сокет"

msgid "ydotool: socket path is too long\n"
msgstr "ydotool: пътят до сокета е твърде дълъг\n"

