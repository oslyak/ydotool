msgstr "забавяне (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "Събитие на щракване %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Употреба: key [OPTION]... [KEYCODES]...\nИзпращане на събития от клавиши.\n\nОпции:\n  -d, --key-delay=N          Изчакване N милисекунди между събитията от клавиши\n  -h, --help                 Показва тази помощ и излиза\n\nТъй като не е възможно да се знае колко клавиатурни подредби има по света,\nвече използваме директно кодовете на клавишите.\n\nСинтаксис: <keycode>:<pressed>\nнапр. 28:1 28:0 означава натискане на Enter на стандартна US клавиатура.\n     (:1 означава, че клавишът е натиснат, а :0 — че е отпуснат)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nНеразбираеми стойности като 0, aaa, l0l само ще причинят забавяне.\n\nВижте `/usr/include/linux/input-event-codes.h' за наличните кодове (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Употреба: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nПреместване на показалеца или колелцето на мишката.\n\nОпции:\n  -w, --wheel                Относително завъртане на колелцето на мишката\n  -a, --absolute             Използване на абсолютна позиция; не важи за колелцето\n  -x, --xpos                 Позиция по X\n  -y, --ypos                 Позиция по Y\n  -h, --help                 Показва тази помощ и излиза\n\nЗа правилно абсолютно преместване трябва да изключите ускорението на мишката."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: твърде много координати\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Преместванията на колелцето на мишката не трябва да са абсолютни стойности\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: необходими са две координати\n"

#, c-format
