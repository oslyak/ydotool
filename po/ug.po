msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "ئىشلىتىلىشى: ydotoold [OPTION]...\nydotool daemon پروگراممىسى.\n\nتاللانمىلار:\n  -p, --socket-path=PATH     خاس socket يولى\n  -P, --socket-perm=PERM     Socket ھوقۇقى (كۆڭۈلدىكى 0600)\n  -o, --socket-own=UID:GID   Socket ئىگىدارلىقى\n  -s, --no-system-keys        SysRq ۋە توك/ئۇخلاش/قايتا قوزغىتىش كۇنۇپكىلىرىنى چەكلەڭ\n  -m, --mouse-off            چاشقىنەكنى چەكلەڭ (EV_REL)\n  -k, --keyboard-off         كۇنۇپكا تاختىسىنى چەكلەڭ (EV_KEY)\n  -T, --touch-on             سېزىمچان ئېكراننى قوزغىتىڭ (EV_ABS)\n  -h, --help                 بۇ ياردەمنى كۆرسىتىپ چېكىنىڭ\n  -V, --version              نەشر ئۇچۇرىنى كۆرسىتىڭ\n"

