msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "ئىشلىتىلىشى: type [OPTION]... [STRINGS]...\nتېكىست تىزىقلىرىنى كىرگۈزۈڭ.\n\nتاللانمىلار:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          كۇنۇپكىلار ئارىسىدا N مىللىسېكۇنت كۈتۈڭ (ھەر بىر بېسىش/قويۇپ بېرىش جۈپىنىڭ ئارىسىدىكى كۈتۈش) (كۆڭۈلدىكى: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           ھەر بىر كۇنۇپكىنى N مىللىسېكۇنت بېسىپ تۇرۇڭ (بېسىش بىلەن قويۇپ بېرىش ئارىسىدىكى كۈتۈش) (كۆڭۈلدىكى: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         بۇيرۇق قۇرىدىكى تېكىست تىزىقلىرى ئارىسىدا N مىللىسېكۇنت كۈتۈڭ (كۆڭۈلدىكى: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            مەزمۇنى ئارگۇمېنت قىلىپ بېرىلگەندەك كىرگۈزۈلىدىغان ھۆججەتنى بەلگىلەڭ.\n                               ھۆججەت يولى stdin دىن ئوقۇش ئۈچۈن '-' بولسىمۇ بولىدۇ\n  -e, --escape=BOOL          Escape نى قوزغىتىڭ (1) ياكى چەكلەڭ (0)\n  -h, --help                 بۇ ياردەمنى كۆرسىتىپ چېكىنىڭ\n\nبۇيرۇق قۇرى ئارگۇمېنتلىرىنى كىرگۈزگەندە Escape كۆڭۈلدىكى ھالەتتە قوزغىتىلغان؛ ھۆججەت ۋە stdin دىن كىرگۈزگەندە كۆڭۈلدىكى ھالەتتە چەكلەنگەن.\nھۆججەت كىرگۈزۈش ئېقىم شەكلىدە ئىشلەيدۇ: كېيىن خاتالىق چىقىشتىن بۇرۇنقى توغرا ASCII قىسمى كىرگۈزۈلۈپ بولغان بولۇشى مۇمكىن."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type پەقەت ASCII نى قوللايدۇ؛ UTF-8 تېكىست ئۈچۈن clipboard ئارقىلىق چاپلاڭ\n"

