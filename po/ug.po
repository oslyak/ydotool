msgstr "چاشقىنەك چاقى ھەرىكىتى مۇتلەق قىممەت بولماسلىقى كېرەك\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: ئىككى كوئوردېنات كېرەك\n"

msgid "Type anything (CTRL-C to exit):\n"
msgstr "خالىغان نەرسىنى كىرگۈزۈڭ (چېكىش ئۈچۈن CTRL-C):\n"

