#, c-format
msgid "Click Event %d\n"
msgstr "Ngjarja e klikimit %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Përdorimi: key [OPTION]... [KEYCODES]...\nGjeneron ngjarje tastesh.\n\nOpsionet:\n  -d, --key-delay=N          Pret N milisekonda mes ngjarjeve të tasteve\n  -h, --help                 Shfaq këtë ndihmë dhe del\n\nMeqë nuk ka mënyrë për të ditur sa variante tastierash ka në botë,\ntani përdorim kode të papërpunuara tastesh.\n\nSintaksa: <keycode>:<pressed>\np.sh. 28:1 28:0 do të thotë shtypja e tastit Enter në një tastierë standarde US.\n     (ku :1 tregon shtypjen e tastit dhe më pas :0 tregon lëshimin e tij)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nVlera të painterpretueshme, si 0, aaa, l0l, shkaktojnë vetëm një vonesë.\n\nPër kodet e disponueshme të tasteve (KEY_*), shihni `/usr/include/linux/input-event-codes.h'\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Përdorimi: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nLëviz treguesin ose rrotën e miut.\n\nOpsionet:\n  -w, --wheel                Lëviz rrotën e miut në mënyrë relative\n  -a, --absolute             Përdor pozicion absolut; nuk zbatohet për rrotën\n  -x, --xpos                 Pozicioni X\n  -y, --ypos                 Pozicioni Y\n  -h, --help                 Shfaq këtë ndihmë dhe del\n\nPër lëvizje të saktë absolute, duhet të çaktivizoni përshpejtimin e miut."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: shumë koordinata\n"

