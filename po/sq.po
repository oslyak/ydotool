msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Përdorimi: ydotoold [OPTION]...\nDaemon-i ydotool.\n\nOpsionet:\n  -p, --socket-path=PATH     Shtegu i personalizuar i soketit\n  -P, --socket-perm=PERM     Leja e soketit (parazgjedhja 0600)\n  -o, --socket-own=UID:GID   Pronësia e soketit\n  -s, --no-system-keys        Çaktivizon tastet SysRq dhe të energjisë/gjumit/rinisjes\n  -m, --mouse-off            Çaktivizon miun (EV_REL)\n  -k, --keyboard-off         Çaktivizon tastierën (EV_KEY)\n  -T, --touch-on             Aktivizon ekranin me prekje (EV_ABS)\n  -h, --help                 Shfaq këtë ndihmë dhe del\n  -V, --version              Shfaq informacionin e versionit\n"

