msgstr "Përdorimi: type [OPTION]... [STRINGS]...\nShkruan vargjet e tekstit.\n\nOpsionet:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Pret N milisekonda mes tasteve (vonesa mes çdo çifti shtypje/lëshim) (parazgjedhja: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Mban çdo tast të shtypur për N milisekonda (vonesa mes shtypjes dhe lëshimit) (parazgjedhja: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Pret N milisekonda mes vargjeve të linjës së komandës (parazgjedhja: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Përcakton skedarin, përmbajtja e të cilit do të shkruhet sikur të ishte dhënë si argument.\n                               Rruga e skedarit mund të jetë edhe '-' për të lexuar nga stdin\n  -e, --escape=BOOL          Aktivizon (1) ose çaktivizon (0) Escape\n  -h, --help                 Shfaq këtë ndihmë dhe del\n\nEscape është aktivizuar si parazgjedhje kur shkruhen argumentet e linjës së komandës dhe çaktivizuar si parazgjedhje kur shkruhet nga skedari dhe stdin.\nHyrja nga skedari përpunohet si rrjedhë: ASCII e vlefshme para një gabimi të mëvonshëm mund të jetë shkruar tashmë."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type mbështet vetëm ASCII; përdorni ngjitjen nga clipboard për tekst UTF-8\n"

