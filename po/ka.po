#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          დაყოვნება N მილიწამი კლავიშებს შორის (ყოველ დაწევა/აწევის წყვილს შორის დაყოვნება) (ნაგულისხმევი: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           თითოეული კლავიში დაჭერილი იყოს N მილიწამით (დაყოვნება კლავიშის დაწევასა და აწევას შორის) (ნაგულისხმევი: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         დაყოვნება N მილიწამი ბრძანების სტრიქონებს შორის (ნაგულისხმევი: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            მიუთითეთ ფაილი, რომლის შიგთავსიც არგუმენტად გადაცემულივით აიკრიფება.\n                               ფაილის ბილიკად შეიძლება '-' მიუთითოთ stdin-იდან წასაკითხად\n  -e, --escape=BOOL          Escape-ის ჩართვა (1) ან გამორთვა (0)\n  -h, --help                 აჩვენეთ ეს დახმარება და დაასრულეთ\n\nბრძანების სტრიქონის არგუმენტების აკრეფისას Escape ნაგულისხმევად ჩართულია, ფაილიდან და stdin-იდან აკრეფისას კი ნაგულისხმევად გამორთულია.\nფაილის შეყვანა ნაკადურად მუშავდება: მოგვიანებით შეცდომამდე არსებული სწორი ASCII შეიძლება უკვე აკრეფილი იყოს."

