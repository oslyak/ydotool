msgstr "ປ່ຽນເຈົ້າຂອງ socket ບໍ່ສຳເລັດ"
#, c-format
msgid "Socket ownership: UID=%d, GID=%d\n"
msgstr "ເຈົ້າຂອງ Socket: UID=%d, GID=%d\n"
msgid "failed to run xinput command"
msgstr "ຮັນຄຳສັ່ງ xinput ບໍ່ສຳເລັດ"
