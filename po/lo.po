msgstr "UI_SET_ABSBIT %d ລົ້ມເຫຼວ\n"
msgid "UI_DEV_SETUP ioctl failed"
msgstr "UI_DEV_SETUP ioctl ລົ້ມເຫຼວ"
msgid "UI_DEV_CREATE ioctl failed"
msgstr "UI_DEV_CREATE ioctl ລົ້ມເຫຼວ"
msgid "You're advised to run this program as root, or YMMV."
msgstr "ແນະນຳໃຫ້ຮັນໂປຣແກຣມນີ້ໃນສິດ root; ຜົນອາດແຕກຕ່າງກັນ (YMMV)."
msgid "failed to open uinput device"
msgstr "ເປີດອຸປະກອນ uinput ບໍ່ສຳເລັດ"
#, c-format
msgid "Socket path: %s\n"
msgstr "ເສັ້ນທາງ Socket: %s\n"
msgid "failed to create socket for daemon collision detection"
msgstr "ສ້າງ socket ເພື່ອກວດຈັບ daemon ຊ້ຳກັນບໍ່ສຳເລັດ"
msgid "Removing old stale socket"
msgstr "ກຳລັງລຶບ socket ເກົ່າທີ່ຄ້າງຢູ່"
