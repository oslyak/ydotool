msgstr "opóźnienie (0..60000 ms)"

#, c-format
msgid "Click Event %d\n"
msgstr "Zdarzenie kliknięcia %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Użycie: key [OPTION]... [KEYCODES]...\nGeneruj zdarzenia klawiszy.\n\nOpcje:\n  -d, --key-delay=N          Opóźnienie N milisekund między zdarzeniami klawiszy\n  -h, --help                 Wyświetl tę pomoc i zakończ\n\nPonieważ nie wiadomo, ile układów klawiatur istnieje na świecie,\nużywamy teraz surowych kodów klawiszy.\n\nSkładnia: <keycode>:<pressed>\nnp. 28:1 28:0 oznacza naciśnięcie klawisza Enter na standardowej klawiaturze US.\n     (:1 oznacza, że klawisz jest wciśnięty, a :0, że został zwolniony)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nWartości niemożliwe do zinterpretowania, takie jak 0, aaa, l0l, spowodują jedynie opóźnienie.\n\nDostępne kody klawiszy (KEY_*) można znaleźć w `/usr/include/linux/input-event-codes.h'.\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Użycie: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nPrzesuń wskaźnik myszy lub kółko.\n\nOpcje:\n  -w, --wheel                Przesuń kółko myszy względnie\n  -a, --absolute             Użyj pozycji bezwzględnej; nie dotyczy kółka\n  -x, --xpos                 Pozycja X\n  -y, --ypos                 Pozycja Y\n  -h, --help                 Wyświetl tę pomoc i zakończ\n\nAby ruch bezwzględny działał poprawnie, wyłącz przyspieszenie myszy."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: zbyt wiele współrzędnych\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Ruchy kółka myszy nie mogą być wartościami bezwzględnymi\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: wymagane są dwie współrzędne\n"

msgid "Type anything (CTRL-C to exit):\n"
msgstr "Wpisz cokolwiek (CTRL-C, aby zakończyć):\n"

