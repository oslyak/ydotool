msgstr "  Wysyłanie Ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Użycie: type [OPTION]... [STRINGS]...\nWpisz ciągi znaków.\n\nOpcje:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Opóźnienie N milisekund między klawiszami (opóźnienie między każdą parą wciśnięcia/zwolnienia klawisza) (domyślnie: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Przytrzymaj każdy klawisz przez N milisekund (opóźnienie między wciśnięciem a zwolnieniem) (domyślnie: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Opóźnienie N milisekund między ciągami z wiersza poleceń (domyślnie: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Określ plik, którego zawartość zostanie wpisana tak, jakby była przekazana jako argument.\n                               Ścieżką pliku może być również '-' — wtedy dane są czytane ze stdin\n  -e, --escape=BOOL          Włącz (1) lub wyłącz (0) interpretowanie sekwencji escape\n  -h, --help                 Wyświetl tę pomoc i zakończ\n\nInterpretowanie sekwencji escape jest domyślnie włączone dla argumentów wiersza poleceń, a domyślnie wyłączone dla danych z pliku i stdin.\nDane z pliku są przesyłane strumieniowo: poprawne znaki ASCII przed późniejszym błędem mogły już zostać wpisane."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type obsługuje tylko ASCII; użyj wklejania ze schowka dla tekstu UTF-8\n"

msgid "escape mode"
msgstr "tryb escape"

