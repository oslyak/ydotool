msgstr "ydotool: odczyt stdin"

#, c-format
msgid "Key code: %d %d %d\n"
msgstr "Kod klawisza: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin obsługuje tylko ASCII; użyj wklejania ze schowka dla tekstu UTF-8\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  Mapuje na: %d\n"

