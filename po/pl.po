msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Użycie: ydotoold [OPTION]...\nDemon ydotool.\n\nOpcje:\n  -p, --socket-path=PATH     Niestandardowa ścieżka gniazda\n  -P, --socket-perm=PERM     Uprawnienia gniazda (domyślnie 0600)\n  -o, --socket-own=UID:GID   Właściciel gniazda\n  -s, --no-system-keys        Wyłącz klawisze SysRq oraz zasilania/uśpienia/ponownego uruchomienia\n  -m, --mouse-off            Wyłącz mysz (EV_REL)\n  -k, --keyboard-off         Wyłącz klawiaturę (EV_KEY)\n  -T, --touch-on             Włącz ekran dotykowy (EV_ABS)\n  -h, --help                 Wyświetl tę pomoc i zakończ\n  -V, --version              Wyświetl informacje o wersji\n"

