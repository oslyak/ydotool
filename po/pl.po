msgstr "Oto nasi szanowni piekarze:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Użycie: release-all\nZwolnij wszystkie wirtualne przyciski klawiatury i myszy."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all nie przyjmuje argumentów\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Użycie: ydotool <cmd> <args>\nDostępne polecenia:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Użyj release-all, aby zwolnić wciśnięte klawisze po wymuszonym zakończeniu klienta.\n  -h, --help     Wyświetl tę pomoc i zakończ\n  -V, --version  Wyświetl informacje o wersji i zakończ\nUżyj zmiennej środowiskowej YDOTOOL_SOCKET, aby wskazać gniazdo demona."

