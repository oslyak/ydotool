#, c-format
msgid "Click Event %d\n"
msgstr "Eveniment de clic %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Usatge: key [OPTION]... [KEYCODES]...\nEmetre d’eveniments de tòca.\n\nOpcions:\n  -d, --key-delay=N          Espèra N millisegondas entre los eveniments de tòca\n  -h, --help                 Afichar aquesta ajuda e sortir\n\nComa es impossible de saber quantas disposicions de clavièr existisson dins lo mond, utilizam ara los còdis de tòca bruts.\n\nSintaxi: <keycode>:<pressed>\nPer exemple, 28:1 28:0 significa qu’avèm tocat la tòca Enter d’un clavièr estandard dels Estats Units. (US)\n     (ont :1 indica que la tòca es baissada e :0 que la tòca es relargada)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nLas valors ininterpretablas, coma 0, aaa o l0l, causan sonque una pausa.\n\nVejatz `/usr/include/linux/input-event-codes.h' per trobar los còdis de tòca disponibles (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Usatge: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nDesplaçar lo puntador de mirga o la ròda.\n\nOpcions:\n  -w, --wheel                Desplaçar la ròda de la mirga relativament\n  -a, --absolute             Utilizar una posicion absoluda; pas aplicable a la ròda\n  -x, --xpos                 Posicion X\n  -y, --ypos                 Posicion Y\n  -h, --help                 Afichar aquesta ajuda e sortir\n\nCal desactivar l’acceleracion de la velocitat de la mirga per que lo desplaçament absolut siá corrècte."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: tròpas de coordenadas\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Los desplaçaments de la ròda de mirga pòdon pas èsser de valors absoluts\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: cal doas coordenadas\n"

