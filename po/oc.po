msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usatge: ydotoold [OPTION]...\nLo daemon ydotool.\n\nOpcions:\n  -p, --socket-path=PATH     Camin personalizat del socket\n  -P, --socket-perm=PERM     Permissions del socket (per defaut 0600)\n  -o, --socket-own=UID:GID   Proprietat del socket\n  -s, --no-system-keys        Desactivar las tòcas SysRq e d’alimentacion/demora/reaviada\n  -m, --mouse-off            Desactivar la mirga (EV_REL)\n  -k, --keyboard-off         Desactivar lo clavièr (EV_KEY)\n  -T, --touch-on             Activar l’ecran tactil (EV_ABS)\n  -h, --help                 Afichar aquesta ajuda e sortir\n  -V, --version              Afichar las informacions de version\n"

