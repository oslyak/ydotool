msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Usatge: release-all\nRelargar totas las tòcas de clavièr e los botons de mirga virtuals."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all prend pas d’arguments\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Usatge: ydotool <cmd> <args>\nComandas disponiblas:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Utilizatz release-all per tornar a l’estat normal las tòcas mantengudas après l’arrèst brutal d’un client.\n  -h, --help     Afichar aquesta ajuda e sortir\n  -V, --version  Afichar las informacions de version e sortir\nUtilizatz la variabla d’environament YDOTOOL_SOCKET per indicar lo socket del daemon."

