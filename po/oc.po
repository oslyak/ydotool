msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usatge: type [OPTION]... [STRINGS]...\nTipejar de cadenas.\n\nOpcions:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Espèra N millisegondas entre las tòcas (delai entre cada parelh de baissada/pujada) (per defaut: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Manténer cada tòca N millisegondas (delai entre la baissada e la pujada) (per defaut: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Espèra N millisegondas entre las cadenas de la linha de comanda (per defaut: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Indicar un fichièr, que lo contengut ne serà tipejat coma se foguèsse passat coma argument.\n                               Lo camin del fichièr pòt tanben èsser '-' per legir dempuèi stdin\n  -e, --escape=BOOL          Activar (1) o desactivar (0) l’interpretacion dels escapes\n  -h, --help                 Afichar aquesta ajuda e sortir\n\nL’interpretacion dels escapes es activada per defaut pels arguments de la linha de comanda e desactivada per defaut per la lectura dempuèi un fichièr o stdin.\nLa lectura del fichièr es progressiva: los caractèrs ASCII valids abans d’una error ulterior pòdon ja èsser tipejats."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type accepta sonque l’ASCII; utilizatz lo pegar del quichapapièrs per lo tèxte UTF-8\n"

msgid "escape mode"
msgstr "mòde d’escapament"

