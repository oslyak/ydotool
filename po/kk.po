msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Пайдалану: type [OPTION]... [STRINGS]...\nЖолдарды теру.\n\nПараметрлер:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Пернелер арасында N миллисекунд күту (әр пернені басу/босату жұбы арасындағы кідіріс) (default: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Әр пернені N миллисекунд ұстап тұру (пернені басу мен босату арасындағы кідіріс) (default: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Пәрмен жолындағы жолдар арасында N миллисекунд күту (default: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Мазмұны аргумент ретінде берілгендей терілетін файлды көрсету.\n                               Файл жолы сондай-ақ '-' stdin-нен оқу үшін\n  -e, --escape=BOOL          Escape режимін қосу (1) не өшіру (0)\n  -h, --help                 Осы көмекті көрсету және шығу\n\nПәрмен жолы аргументтерін тергенде Escape әдепкіде қосулы, файл мен stdin-нен тергенде әдепкіде өшірулі.\nФайл кірісі ағынмен оқылады: кейін қате шықса да, оған дейінгі жарамды ASCII мәтіні теріліп үлгеруі мүмкін."

