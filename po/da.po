msgstr "Project-Id-Version: ydotool\nReport-Msgid-Bugs-To: anton@sirius.if.ua\nPOT-Creation-Date: 2026-11-06 02:52+0700\nPO-Revision-Date: 2026-11-06 00:00+0000\nLast-Translator: ydotool translation tooling <anton@sirius.if.ua>\nLanguage-Team: Danish\nLanguage: da\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\nX-Native-Review: pending\n"

msgid "Usage: click [OPTION]... [BUTTONS]...\nClick mouse buttons.\n\nOptions:\n  -r, --repeat=N             Repeat entire sequence N times\n  -D, --next-delay=N         Delay N milliseconds between input events (up/down,                                a complete click means doubled time)\n  -P, --press-release        Press & release mouse button to complete a click, (optional)\n  -h, --help                 Display this help and exit\n\nHow to specify buttons:\n  Now all mouse buttons are represented using hexadecimal numeric values, with an optional\nbit mask to specify if mouse up/down needs to be omitted.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Mouse down\n  0x80 - Mouse up\n  Examples:\n    0x00: chooses left button, but does nothing (you can use this to implement extra sleeps)\n    0xC0: left button click (down then up)\n    0x41: right button down\n    0x82: middle button up\n  The '0x' prefix can be omitted if you want.\n"
msgstr "Brug: click [OPTION]... [BUTTONS]...\nKlik på museknapper.\n\nTilvalg:\n  -r, --repeat=N             Gentag hele sekvensen N gange\n  -D, --next-delay=N         Forsink N millisekunder mellem inputhændelser (ned/op,                                et helt klik betyder dobbelt tid)\n  -P, --press-release        Tryk på og slip museknappen for at fuldføre et klik (valgfrit)\n  -h, --help                 Vis denne hjælp, og afslut\n\nSådan angives knapper:\n  Museknapper repræsenteres med hexadecimale talværdier og eventuelt en\nbitmaske, der angiver, om museknap op/ned skal udelades.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Museknap ned\n  0x80 - Museknap op\n  Eksempler:\n    0x00: vælger venstre knap, men gør intet (kan bruges til ekstra pauser)\n    0xC0: klik på venstre knap (ned og derefter op)\n    0x41: højre knap ned\n    0x82: midterste knap op\n  Præfikset '0x' kan udelades.\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Brug: key [OPTION]... [KEYCODES]...\nUdsend tastehændelser.\n\nTilvalg:\n  -d, --key-delay=N          Forsink N millisekunder mellem tastehændelser\n  -h, --help                 Vis denne hjælp, og afslut\n\nDa det ikke er muligt at kende alle tastaturlayouts i verden,\nbruger vi nu rå tastekoder.\n\nSyntaks: <keycode>:<pressed>\nf.eks. betyder 28:1 28:0, at der trykkes på Enter på et almindeligt US-tastatur.\n     (:1 betyder, at tasten trykkes ned, og :0 betyder, at den slippes)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nVærdier, der ikke kan fortolkes, såsom 0, aaa, l0l, medfører kun en forsinkelse.\n\nSe `/usr/include/linux/input-event-codes.h' for tilgængelige tastekoder (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Brug: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nFlyt musemarkøren eller musehjulet.\n\nTilvalg:\n  -w, --wheel                Flyt musehjulet relativt\n  -a, --absolute             Brug absolut position; gælder ikke for musehjulet\n  -x, --xpos                 X-position\n  -y, --ypos                 Y-position\n  -h, --help                 Vis denne hjælp, og afslut\n\nDeaktivér musens hastighedsacceleration for korrekt absolut bevægelse."

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Brug: type [OPTION]... [STRINGS]...\nIndtast tekststrenge.\n\nTilvalg:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Forsink N millisekunder mellem taster (forsinkelsen mellem hvert tast ned/op-par) (standard: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Hold hver tast nede i N millisekunder (forsinkelse mellem tast ned og op) (standard: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Forsink N millisekunder mellem kommandolinjens tekststrenge (standard: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Angiv en fil, hvis indhold indtastes, som om det var et argument.\n                               Filstien kan også være '-' for at læse fra stdin\n  -e, --escape=BOOL          Aktivér (1) eller deaktivér (0) escape\n  -h, --help                 Vis denne hjælp, og afslut\n\nEscape er som standard aktiveret ved indtastning af kommandolinjeargumenter og deaktiveret ved indtastning fra fil og stdin.\nFilinput streames: gyldig ASCII før en senere fejl kan allerede være indtastet."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type understøtter kun ASCII; indsæt UTF-8-tekst fra udklipsholderen\n"

msgid "These are our honorable bakers:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"
msgstr "Dette er vores ærede bagere:\n\nDustin Van Tate Testa\nElliot Wolk\ntofik\n"

msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Brug: release-all\nSlip alle virtuelle tastatur- og museknapper."

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Brug: ydotool <cmd> <args>\nTilgængelige kommandoer:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Brug release-all til at frigive fastholdte taster efter en afsluttet klient.\n  -h, --help     Vis denne hjælp, og afslut\n  -V, --version  Vis versionsoplysninger, og afslut\nBrug miljøvariablen YDOTOOL_SOCKET til at angive daemonens socket."

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Brug: ydotoold [OPTION]...\nydotool-daemonen.\n\nTilvalg:\n  -p, --socket-path=PATH     Brugerdefineret socketsti\n  -P, --socket-perm=PERM     Socketrettighed (standard 0600)\n  -o, --socket-own=UID:GID   Socketejerskab\n  -s, --no-system-keys        Deaktivér SysRq samt tænd/sluk-, dvale- og genstartstaster\n  -m, --mouse-off            Deaktivér mus (EV_REL)\n  -k, --keyboard-off         Deaktivér tastatur (EV_KEY)\n  -T, --touch-on             Aktivér berøringsskærm (EV_ABS)\n  -h, --help                 Vis denne hjælp, og afslut\n  -V, --version              Vis versionsoplysninger\n"

