msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Usage: ydotoold [OPTION]...\nTrình nền ydotool.\n\nTùy chọn:\n  -p, --socket-path=PATH     Đường dẫn socket tùy chỉnh\n  -P, --socket-perm=PERM     Quyền socket (mặc định 0600)\n  -o, --socket-own=UID:GID   Chủ sở hữu socket\n  -s, --no-system-keys        Tắt SysRq và các phím nguồn/ngủ/khởi động lại\n  -m, --mouse-off            Tắt chuột (EV_REL)\n  -k, --keyboard-off         Tắt bàn phím (EV_KEY)\n  -T, --touch-on             Bật màn hình cảm ứng (EV_ABS)\n  -h, --help                 Hiển thị trợ giúp này rồi thoát\n  -V, --version              Hiển thị thông tin phiên bản\n"

