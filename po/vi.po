msgstr "Project-Id-Version: ydotool\nReport-Msgid-Bugs-To: anton@sirius.if.ua\nPOT-Creation-Date: 2026-11-06 02:48+0700\nPO-Revision-Date: 2026-11-06 00:00+0000\nLast-Translator: ydotool translation tooling <anton@sirius.if.ua>\nLanguage-Team: Vietnamese\nLanguage: vi\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\nX-Native-Review: pending\n"

msgid "Usage: click [OPTION]... [BUTTONS]...\nClick mouse buttons.\n\nOptions:\n  -r, --repeat=N             Repeat entire sequence N times\n  -D, --next-delay=N         Delay N milliseconds between input events (up/down,                                a complete click means doubled time)\n  -P, --press-release        Press & release mouse button to complete a click, (optional)\n  -h, --help                 Display this help and exit\n\nHow to specify buttons:\n  Now all mouse buttons are represented using hexadecimal numeric values, with an optional\nbit mask to specify if mouse up/down needs to be omitted.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Mouse down\n  0x80 - Mouse up\n  Examples:\n    0x00: chooses left button, but does nothing (you can use this to implement extra sleeps)\n    0xC0: left button click (down then up)\n    0x41: right button down\n    0x82: middle button up\n  The '0x' prefix can be omitted if you want.\n"
msgstr "Usage: click [OPTION]... [BUTTONS]...\nNhấp các nút chuột.\n\nTùy chọn:\n  -r, --repeat=N             Lặp lại toàn bộ chuỗi N lần\n  -D, --next-delay=N         Chờ N mili giây giữa các sự kiện nhập (lên/xuống,                                một lần nhấp hoàn chỉnh mất gấp đôi thời gian)\n  -P, --press-release        Nhấn và nhả nút chuột để hoàn tất một lần nhấp (tùy chọn)\n  -h, --help                 Hiển thị trợ giúp này rồi thoát\n\nCách chỉ định nút:\n  Hiện mọi nút chuột được biểu diễn bằng giá trị số thập lục phân, có thể kèm\nmặt nạ bit để chỉ định có bỏ qua thao tác nhả/nhấn chuột hay không.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Nhấn chuột xuống\n  0x80 - Nhả chuột lên\n  Ví dụ:\n    0x00: chọn nút trái nhưng không làm gì (có thể dùng để thêm khoảng nghỉ)\n    0xC0: nhấp nút trái (nhấn xuống rồi nhả lên)\n    0x41: nhấn nút phải xuống\n    0x82: nhả nút giữa lên\n  Có thể bỏ tiền tố 0x nếu muốn\n"

#, c-format
msgid "option %s"
msgstr "Tùy chọn %s"

#, c-format
