msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Usage: release-all\nNhả tất cả nút bàn phím và chuột ảo."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all không nhận đối số\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Usage: ydotool <cmd> <args>\nCác lệnh khả dụng:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Dùng release-all để phục hồi các phím bị giữ sau khi một client bị kết thúc.\n  -h, --help     Hiển thị trợ giúp này rồi thoát\n  -V, --version  Hiển thị thông tin phiên bản rồi thoát\nDùng biến môi trường YDOTOOL_SOCKET để chỉ định socket daemon."

