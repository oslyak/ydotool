msgstr "  Đang gửi ctrl\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Usage: type [OPTION]... [STRINGS]...\nNhập các chuỗi.\n\nTùy chọn:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Chờ N mili giây giữa các phím (độ trễ giữa mỗi cặp nhấn xuống/nhả lên) (mặc định: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Giữ mỗi phím trong N mili giây (độ trễ giữa lúc nhấn xuống và nhả lên) (mặc định: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Chờ N mili giây giữa các chuỗi dòng lệnh (mặc định: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Chỉ định tệp; nội dung của tệp sẽ được nhập như thể truyền dưới dạng đối số.\n                               filepath cũng có thể là '-' để đọc từ stdin\n  -e, --escape=BOOL          Bật escape (1) hoặc tắt (0)\n  -h, --help                 Hiển thị trợ giúp này rồi thoát\n\nEscape mặc định được bật khi nhập đối số dòng lệnh và tắt khi nhập từ tệp và stdin.\nĐầu vào tệp được đọc theo luồng: ASCII hợp lệ trước một lỗi xảy ra sau đó có thể đã được nhập."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type chỉ hỗ trợ ASCII; hãy dùng dán từ clipboard cho văn bản UTF-8\n"

msgid "escape mode"
msgstr "chế độ escape"

