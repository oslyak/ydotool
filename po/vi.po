msgstr "ydotool: đọc stdin"

#, c-format
msgid "Key code: %d %d %d\n"
msgstr "Mã phím: %d %d %d\n"

msgid "ydotool: stdin supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: stdin chỉ hỗ trợ ASCII; hãy dùng dán từ clipboard cho văn bản UTF-8\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  Ánh xạ thành: %d\n"

