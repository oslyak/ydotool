msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Úsáid: key [OPTION]... [KEYCODES]...\nEisigh imeachtaí eochracha.\n\nRoghanna:\n  -d, --key-delay=N          Fan N milleasoicind idir imeachtaí eochracha\n  -h, --help                 Taispeáin an chabhair seo agus scoir\n\nÓs rud é nach féidir líon leagan amach na méarchlár ar domhan a fháil amach,\núsáidimid cóid amh eochracha anois.\n\nComhréir: <keycode>:<pressed>\ne.g. Ciallaíonn 28:1 28:0 brú ar an gcnaipe Enter ar mhéarchlár caighdeánach US.\n     (is ionann :1 agus eochair síos agus :0 agus an eochair scaoilte)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNí dhéanfaidh luachanna nach féidir a léirmhíniú, amhail 0, aaa, l0l, ach moill.\n\nFéach `/usr/include/linux/input-event-codes.h' le haghaidh cóid eochracha atá ar fáil (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Úsáid: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nBog pointeoir na luiche nó an roth.\n\nRoghanna:\n  -w, --wheel                Bog roth na luiche go coibhneasta\n  -a, --absolute             Úsáid suíomh absalóideach; ní bhaineann sé seo leis an roth\n  -x, --xpos                 Suíomh X\n  -y, --ypos                 Suíomh Y\n  -h, --help                 Taispeáin an chabhair seo agus scoir\n\nNí mór luasghéarú luiche a dhíchumasú chun gluaiseacht absalóideach chruinn a fháil."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: an iomarca comhordanáidí\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Ní féidir gluaiseachtaí roth na luiche a bheith ina luachanna absalóideacha\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: tá dhá chomhordanáid riachtanach\n"

