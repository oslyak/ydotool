msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Úsáid: type [OPTION]... [STRINGS]...\nClóscríobh teaghráin.\n\nRoghanna:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Fan N milleasoicind idir eochracha (an mhoill idir gach péire eochair síos/suas) (réamhshocrú: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Coinnigh gach eochair síos ar feadh N milleasoicind (an mhoill idir eochair síos agus suas) (réamhshocrú: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Fan N milleasoicind idir teaghráin na líne ordaithe (réamhshocrú: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Sonraigh comhad; clóscríobhfar a bhfuil ann amhail is dá gcuirfí mar argóint é.\n                               Is féidir '-' a úsáid mar chonair chomhaid chun léamh ó stdin\n  -e, --escape=BOOL          Cumasaigh (1) nó díchumasaigh (0) éalú\n  -h, --help                 Taispeáin an chabhair seo agus scoir\n\nCumasaítear éalú de réir réamhshocraithe agus argóintí líne ordaithe á gclóscríobh, agus díchumasaítear é de réir réamhshocraithe agus comhad nó stdin á úsáid.\nSrutháiltear ionchur comhaid: seans go mbeidh ASCII bailí clóscríofa cheana féin sula dtarlaíonn earráid níos déanaí."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: ní thacaíonn type ach le ASCII; úsáid greamú ón ngearrthaisce do théacs UTF-8\n"

msgid "escape mode"
msgstr "modh éalaithe"

