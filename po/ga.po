msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Úsáid: ydotoold [OPTION]...\nDeamhan ydotool.\n\nRoghanna:\n  -p, --socket-path=PATH     Conair shaincheaptha don soicéad\n  -P, --socket-perm=PERM     Cead an tsoicéid (réamhshocrú 0600)\n  -o, --socket-own=UID:GID   Úinéireacht an tsoicéid\n  -s, --no-system-keys        Díchumasaigh eochracha SysRq agus na heochracha cumhachta/codlata/atosaithe\n  -m, --mouse-off            Díchumasaigh an luch (EV_REL)\n  -k, --keyboard-off         Díchumasaigh an méarchlár (EV_KEY)\n  -T, --touch-on             Cumasaigh an scáileán tadhaill (EV_ABS)\n  -h, --help                 Taispeáin an chabhair seo agus scoir\n  -V, --version              Taispeáin faisnéis faoin leagan\n"

