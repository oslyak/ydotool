msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Defnydd: ydotoold [OPTION]...\nY daemon ydotool.\n\nDewisiadau:\n  -p, --socket-path=PATH     Llwybr soced personol\n  -P, --socket-perm=PERM     Caniatâd soced (rhagosodiad 0600)\n  -o, --socket-own=UID:GID   Perchnogaeth soced\n  -s, --no-system-keys        Analluogi bysellau SysRq a bysellau pŵer/cysgu/ailgychwyn\n  -m, --mouse-off            Analluogi'r llygoden (EV_REL)\n  -k, --keyboard-off         Analluogi'r bysellfwrdd (EV_KEY)\n  -T, --touch-on             Galluogi'r sgrin gyffwrdd (EV_ABS)\n  -h, --help                 Dangoswch y cymorth hwn a gorffen\n  -V, --version              Dangoswch wybodaeth y fersiwn\n"

