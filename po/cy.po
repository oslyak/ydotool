msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "Defnydd: key [OPTION]... [KEYCODES]...\nCynhyrchwch ddigwyddiadau bysellau.\n\nDewisiadau:\n  -d, --key-delay=N          Oedwch N milieiliad rhwng digwyddiadau bysellau\n  -h, --help                 Dangoswch y cymorth hwn a gorffen\n\nGan nad oes modd gwybod faint o gynlluniau bysellfwrdd sydd yn y byd,\nrydym yn defnyddio codau bysellau crai bellach.\n\nCystrawen: <keycode>:<pressed>\ne.e. Mae 28:1 28:0 yn golygu pwyso'r botwm Enter ar fysellfwrdd safonol US.\n     (mae :1 yn golygu bod yr allwedd i lawr ac mae :0 yn golygu ei bod wedi'i rhyddhau)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nBydd gwerthoedd na ellir eu dehongli, megis 0, aaa, l0l, yn achosi oedi yn unig.\n\nGweler `/usr/include/linux/input-event-codes.h' am godau bysellau sydd ar gael (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "Defnydd: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nSymudwch bwyntydd neu olwyn y llygoden.\n\nDewisiadau:\n  -w, --wheel                Symudwch olwyn y llygoden yn gymharol\n  -a, --absolute             Defnyddiwch safle absoliwt; nid yw hyn yn berthnasol i'r olwyn\n  -x, --xpos                 Safle X\n  -y, --ypos                 Safle Y\n  -h, --help                 Dangoswch y cymorth hwn a gorffen\n\nRhaid analluogi cyflymiad cyflymder y llygoden er mwyn symud yn absoliwt yn gywir."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: gormod o gyfesurynnau\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Ni ddylai symudiadau olwyn y llygoden fod yn werthoedd absoliwt\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: mae angen dau gyfesuryn\n"

