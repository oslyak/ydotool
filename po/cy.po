msgstr "Defnydd: type [OPTION]... [STRINGS]...\nTeipiwch linynnau.\n\nDewisiadau:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Oedwch N milieiliad rhwng bysellau (yr oedi rhwng pob pâr bysell i lawr/i fyny) (rhagosodiad: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Daliwch bob bysell am N milieiliad (yr oedi rhwng bysell i lawr ac i fyny) (rhagosodiad: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Oedwch N milieiliad rhwng llinynnau llinell orchymyn (rhagosodiad: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Nodwch ffeil; bydd ei chynnwys yn cael ei deipio fel petai wedi'i basio yn ddadl.\n                               Gall llwybr y ffeil hefyd fod yn '-' i ddarllen o stdin\n  -e, --escape=BOOL          Galluogi (1) neu analluogi (0) dianc\n  -h, --help                 Dangoswch y cymorth hwn a gorffen\n\nMae dianc wedi'i alluogi yn ddiofyn wrth deipio dadleuon llinell orchymyn, ac wedi'i analluogi yn ddiofyn wrth deipio o ffeil ac stdin.\nDarllenir mewnbwn ffeil fel ffrwd: efallai y bydd ASCII dilys wedi'i deipio eisoes cyn gwall diweddarach."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: dim ond ASCII mae type yn ei gefnogi; defnyddiwch ludo o’r clipfwrdd ar gyfer testun UTF-8\n"

msgid "escape mode"
msgstr "modd dianc"

