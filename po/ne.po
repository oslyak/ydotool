msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "उपयोग: ydotoold [OPTION]...\nydotool डेमन।\n\nविकल्पहरू:\n  -p, --socket-path=PATH     अनुकूल socket बाटो\n  -P, --socket-perm=PERM     socket अनुमति (पूर्वनिर्धारित 0600)\n  -o, --socket-own=UID:GID   socket स्वामित्व\n  -s, --no-system-keys        SysRq र power/sleep/restart कुञ्जीहरू अक्षम गर्नुहोस्\n  -m, --mouse-off            माउस अक्षम गर्नुहोस् (EV_REL)\n  -k, --keyboard-off         किबोर्ड अक्षम गर्नुहोस् (EV_KEY)\n  -T, --touch-on             टचस्क्रिन सक्षम गर्नुहोस् (EV_ABS)\n  -h, --help                 यो सहायता देखाएर बन्द गर्नुहोस्\n  -V, --version              संस्करण जानकारी देखाउनुहोस्\n"

