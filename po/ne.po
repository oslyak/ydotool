#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          कुञ्जीहरूबीच N मिलिसेकेन्ड पर्खनुहोस् (हरेक कुञ्जी तल/माथि जोडीबीचको पर्खाइ) (पूर्वनिर्धारित: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           प्रत्येक कुञ्जी N मिलिसेकेन्ड थाम्नुहोस् (कुञ्जी तल र माथिबीचको पर्खाइ) (पूर्वनिर्धारित: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         आदेश-पङ्क्तिका स्ट्रिङहरूबीच N मिलिसेकेन्ड पर्खनुहोस् (पूर्वनिर्धारित: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            फाइल निर्दिष्ट गर्नुहोस्; यसको सामग्री तर्कका रूपमा दिएझैँ टाइप हुनेछ।\n                               stdin बाट पढ्न फाइलको बाटो '-' पनि हुन सक्छ\n  -e, --escape=BOOL          Escape सक्षम (1) वा अक्षम (0)\n  -h, --help                 यो सहायता देखाएर बन्द गर्नुहोस्\n\nआदेश-पङ्क्तिका तर्क टाइप गर्दा Escape पूर्वनिर्धारित रूपमा सक्षम हुन्छ; फाइल र stdin बाट टाइप गर्दा पूर्वनिर्धारित रूपमा अक्षम हुन्छ।\nफाइल इनपुट क्रमशः पढिन्छ: पछि त्रुटि आए पनि त्यसअघिको मान्य ASCII पहिले नै टाइप भइसकेको हुन सक्छ।"

