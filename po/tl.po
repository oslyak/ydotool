msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "PAGGAMIT: ydotoold [OPTION]...\nAng ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Pasadyang socket path\n  -P, --socket-perm=PERM     Pahintulot ng socket (default 0600)\n  -o, --socket-own=UID:GID   Pagmamay-ari ng socket\n  -s, --no-system-keys        I-disable ang mga key na SysRq at power/sleep/restart\n  -m, --mouse-off            I-disable ang mouse (EV_REL)\n  -k, --keyboard-off         I-disable ang keyboard (EV_KEY)\n  -T, --touch-on             I-enable ang touchscreen (EV_ABS)\n  -h, --help                 Ipakita ang tulong na ito at lumabas\n  -V, --version              Ipakita ang impormasyon ng bersyon\n"

