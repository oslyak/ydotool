msgstr "Click Event %d\n"

msgid "Usage: key [OPTION]... [KEYCODES]...\nEmit key events.\n\nOptions:\n  -d, --key-delay=N          Delay N milliseconds between key events\n  -h, --help                 Display this help and exit\n\nSince there's no way to know how many keyboard layouts are there in the world,\nwe're using raw keycodes now.\n\nSyntax: <keycode>:<pressed>\ne.g. 28:1 28:0 means pressing on the Enter button on a standard US keyboard.\n     (where :1 for pressed means the key is down and then :0 means the key is released)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nNon-interpretable values, such as 0, aaa, l0l, will only cause a delay.\n\nSee `/usr/include/linux/input-event-codes.h' for available key codes (KEY_*).\n"
msgstr "PAGGAMIT: key [OPTION]... [KEYCODES]...\nMagpadala ng mga event ng key.\n\nOptions:\n  -d, --key-delay=N          Maghintay ng N millisecond sa pagitan ng mga event ng key\n  -h, --help                 Ipakita ang tulong na ito at lumabas\n\nDahil hindi matitiyak kung ilang layout ng keyboard ang mayroon sa mundo,\ngumagamit na kami ngayon ng mga raw keycode.\n\nSyntax: <keycode>:<pressed>\nhal. ang 28:1 28:0 ay nangangahulugang pagpindot sa Enter sa karaniwang US keyboard.\n     (kung saan ang :1 ay nangangahulugang nakapindot ang key at ang :0 ay nangangahulugang binitiwan ito)     42:1 38:1 38:0 24:1 24:0 38:1 38:0 42:0 - \"LOL\"\n\nPaghihintay lamang ang idudulot ng mga value na hindi mabigyang-kahulugan, gaya ng 0, aaa, l0l.\n\nTingnan ang `/usr/include/linux/input-event-codes.h' para sa mga available na key code (KEY_*).\n"

msgid "Usage: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nMove mouse pointer or wheel.\n\nOptions:\n  -w, --wheel                Move mouse wheel relatively\n  -a, --absolute             Use absolute position, not applicable to wheel\n  -x, --xpos                 X position\n  -y, --ypos                 Y position\n  -h, --help                 Display this help and exit\n\nYou need to disable mouse speed acceleration for correct absolute movement."
msgstr "PAGGAMIT: mousemove [OPTION]... [-x <xpos> -y <ypos>] [-- <xpos> <ypos>]\nIlipat ang pointer o gulong ng mouse.\n\nOptions:\n  -w, --wheel                Relatibong igalaw ang gulong ng mouse\n  -a, --absolute             Gumamit ng absolutong posisyon; hindi ito naaangkop sa gulong\n  -x, --xpos                 Posisyon X\n  -y, --ypos                 Posisyon Y\n  -h, --help                 Ipakita ang tulong na ito at lumabas\n\nKailangang i-disable ang mouse speed acceleration upang maging tama ang absolutong galaw."

msgid "ydotool: mousemove: too many coordinates\n"
msgstr "ydotool: mousemove: napakaraming coordinate\n"

msgid "Mouse wheel moves should not be absolute values\n"
msgstr "Hindi dapat absolute value ang galaw ng gulong ng mouse\n"

msgid "ydotool: mousemove: two coordinates are required\n"
msgstr "ydotool: mousemove: kailangan ang dalawang coordinate\n"

