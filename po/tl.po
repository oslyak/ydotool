msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "PAGGAMIT: type [OPTION]... [STRINGS]...\nMag-type ng mga string.\n\nOptions:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Maghintay ng N millisecond sa pagitan ng mga key (pagitan ng bawat pares na key down/up) (default: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Hawakan ang bawat key nang N millisecond (pagitan ng key down at up) (default: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Maghintay ng N millisecond sa pagitan ng mga string ng command line (default: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Tumukoy ng file na ita-type ang nilalaman na para bang ipinasa ito bilang argumento.\n                               Maaari ring '-' ang filepath upang magbasa mula sa stdin\n  -e, --escape=BOOL          I-enable (1) o i-disable (0) ang escape\n  -h, --help                 Ipakita ang tulong na ito at lumabas\n\nNaka-enable bilang default ang Escape kapag nagta-type ng mga argumento sa command line, at naka-disable bilang default kapag nagta-type mula sa file at stdin.\nIni-stream ang input ng file: maaaring nai-type na ang valid na ASCII bago maganap ang susunod na error."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: ASCII lamang ang sinusuportahan ng type; gumamit ng clipboard paste para sa UTF-8 na text\n"

msgid "escape mode"
msgstr "escape mode"

