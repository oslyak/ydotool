msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Uso: type [OPTION]... [STRINGS]...\nEscribir cadenas de texto.\n\nOpciones:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Espera N milisegundos entre teclas (la espera entre cada par de pulsación y liberación) (predeterminado: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Mantener cada tecla durante N milisegundos (la espera entre bajar y subir la tecla) (predeterminado: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Espera N milisegundos entre cadenas de la línea de comandos (predeterminado: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Especificar un archivo cuyo contenido se escribirá\n                              como si se hubiera pasado como argumento.\n                              La ruta también puede ser '-' para leer desde stdin\n  -e, --escape=BOOL          Activar (1) o desactivar (0) el escape\n  -h, --help                 Mostrar esta ayuda y salir\n\nEl escape está activado de forma predeterminada al escribir argumentos de la línea de comandos y desactivado al escribir desde un archivo o stdin.\nLa entrada del archivo se procesa en flujo: el ASCII válido anterior a un error posterior puede haberse escrito ya."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type solo admite ASCII; usa pegar desde el portapapeles para texto UTF-8\n"

msgid "escape mode"
msgstr "modo de escape"

