msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Uso: release-all\nLiberar todas las teclas y botones virtuales del teclado y del ratón."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all no acepta argumentos\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Uso: ydotool <cmd> <args>\nComandos disponibles:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Usa release-all para recuperar las teclas mantenidas tras cerrar un cliente a la fuerza.\n  -h, --help     Mostrar esta ayuda y salir\n  -V, --version  Mostrar información de la versión y salir\nUsa la variable de entorno YDOTOOL_SOCKET para especificar el socket del daemon."

