msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Uso: ydotoold [OPTION]...\nEl daemon de ydotool.\n\nOpciones:\n  -p, --socket-path=PATH     Ruta personalizada del socket\n  -P, --socket-perm=PERM     Permisos del socket (predeterminado 0600)\n  -o, --socket-own=UID:GID   Propietario del socket\n  -s, --no-system-keys        Desactivar las teclas SysRq y de encendido/suspensión/reinicio\n  -m, --mouse-off            Desactivar el ratón (EV_REL)\n  -k, --keyboard-off         Desactivar el teclado (EV_KEY)\n  -T, --touch-on             Activar la pantalla táctil (EV_ABS)\n  -h, --help                 Mostrar esta ayuda y salir\n  -V, --version              Mostrar información de la versión\n"

