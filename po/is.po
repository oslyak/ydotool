msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Notkun: type [OPTION]... [STRINGS]...\nSláðu inn strengi.\n\nValkostir:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Bið N millisekúndur milli lykla (bið milli hvers niður/upp-lyklapars) (sjálfgefið: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Haltu hverjum lykli niðri í N millisekúndur (bið milli niður- og upp-tilvika) (sjálfgefið: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Bið N millisekúndur milli strengja á skipanalínu (sjálfgefið: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Tilgreindu skrá; innihald hennar verður slegið inn eins og það væri gefið sem viðfang.\n                               Skráarslóðin getur einnig verið '-' til að lesa úr stdin\n  -e, --escape=BOOL          Virkja Escape (1) eða slökkva á því (0)\n  -h, --help                 Sýndu þessa hjálp og hættu\n\nEscape er sjálfgefið virkt þegar skipanalínurök eru slegin inn en óvirkt við lestur úr skrá og stdin.\nSkráin er lesin sem straumur: gildum ASCII-stöfum kann þegar að hafa verið slegið inn áður en villa kemur síðar."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type styður aðeins ASCII; límdu UTF-8-texta úr klippiborði\n"

msgid "escape mode"
msgstr "Escape-hamur"

