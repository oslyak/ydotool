msgstr "Athugaðu hvort núverandi notandi hafi nægar heimildir til að fá aðgang að socket-skránni.\n"

msgid "ydotool: install signal handler"
msgstr "ydotool: setja upp merkjameðhöndlun"

msgid "ydotool: lock socket directory"
msgstr "ydotool: læsa socket-möppu"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Notkun: ydotoold [OPTION]...\nydotool-þjónninn.\n\nValkostir:\n  -p, --socket-path=PATH     Sérsniðin socket-slóð\n  -P, --socket-perm=PERM     Socket-heimild (sjálfgefið 0600)\n  -o, --socket-own=UID:GID   Socket-eignarhald\n  -s, --no-system-keys        Slökkva á SysRq- og afl-, svefn- og endurræsingarlyklum\n  -m, --mouse-off            Slökkva á mús (EV_REL)\n  -k, --keyboard-off         Slökkva á lyklaborði (EV_KEY)\n  -T, --touch-on             Virkja snertiskjá (EV_ABS)\n  -h, --help                 Sýna þessa hjálp og hætta\n  -V, --version              Sýna útgáfuupplýsingar\n"

