msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Notkun: release-all\nSlepptu öllum sýndarhnöppum lyklaborðs og músar."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all tekur engin viðföng\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Notkun: ydotool <cmd> <args>\nTiltækar skipanir:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Notaðu release-all til að losa fasta lykla eftir að biðlara hefur verið lokað með afli.\n  -h, --help     Sýndu þessa hjálp og hættu\n  -V, --version  Sýndu útgáfuupplýsingar og hættu\nNotaðu umhverfisbreytuna YDOTOOL_SOCKET til að tilgreina socket þjónsins."

#, c-format
