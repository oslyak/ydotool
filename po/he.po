msgstr "Project-Id-Version: ydotool\nReport-Msgid-Bugs-To: anton@sirius.if.ua\nPOT-Creation-Date: 2026-11-06 02:48+0700\nPO-Revision-Date: 2026-11-06 00:00+0000\nLast-Translator: ydotool translation tooling <anton@sirius.if.ua>\nLanguage-Team: he\nLanguage: he\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\nX-Native-Review: pending\n"

msgid "Usage: click [OPTION]... [BUTTONS]...\nClick mouse buttons.\n\nOptions:\n  -r, --repeat=N             Repeat entire sequence N times\n  -D, --next-delay=N         Delay N milliseconds between input events (up/down,                                a complete click means doubled time)\n  -P, --press-release        Press & release mouse button to complete a click, (optional)\n  -h, --help                 Display this help and exit\n\nHow to specify buttons:\n  Now all mouse buttons are represented using hexadecimal numeric values, with an optional\nbit mask to specify if mouse up/down needs to be omitted.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - Mouse down\n  0x80 - Mouse up\n  Examples:\n    0x00: chooses left button, but does nothing (you can use this to implement extra sleeps)\n    0xC0: left button click (down then up)\n    0x41: right button down\n    0x82: middle button up\n  The '0x' prefix can be omitted if you want.\n"
msgstr "שימוש: click [OPTION]... [BUTTONS]...\nלחץ על לחצני העכבר.\n\nאפשרויות:\n  -r, --repeat=N             חזור על הרצף כולו N פעמים\n  -D, --next-delay=N         השהיה N אלפיות שנייה בין אירועי קלט (למטה/למעלה, לחיצה מלאה פירושה זמן כפול)\n  -P, --press-release        לחץ ושחרר את לחצן העכבר להשלמת לחיצה (אופציונלי)\n  -h, --help                 הצג עזרה זו וצא\n\nאיך לציין לחצנים:\n  כל לחצני העכבר מיוצגים כעת בערכים הקסדצימליים, עם מסכת סיביות אופציונלית לציון אם להשמיט הרמה/הורדה.\n  0x00 - LEFT\n  0x01 - RIGHT\n  0x02 - MIDDLE\n  0x03 - SIDE\n  0x04 - EXTR\n  0x05 - FORWARD\n  0x06 - BACK\n  0x07 - TASK\n  0x40 - הורדת העכבר\n  0x80 - הרמת העכבר\n  דוגמאות:\n    0x00: בוחר בלחצן השמאלי אך אינו עושה דבר (אפשר להשתמש בכך להשהיות נוספות)\n    0xC0: לחיצה על הלחצן השמאלי (למטה ואז למעלה)\n    0x41: הורדת הלחצן הימני\n    0x82: הרמת הלחצן האמצעי\n  אפשר להשמיט את הקידומת '0x'.\n"

#, c-format
msgid "option %s"
msgstr "אפשרות %s"

#, c-format
msgid " with arg %s"
msgstr " עם הארגומנט %s"

msgid "repeat count"
msgstr "מספר חזרות"

