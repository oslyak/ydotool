msgstr "ydotool: stdin תומך ב־ASCII בלבד; השתמש בהדבקה מהלוח עבור טקסט UTF-8\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  ממופה אל: %d\n"

