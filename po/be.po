msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Выкарыстанне: type [OPTION]... [STRINGS]...\nУводзіць радкі.\n\nПараметры:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Затрымка N мілісекунд паміж клавішамі (затрымка паміж кожнай парай націскання і адпускання) (па змаўчанні: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Утрымліваць кожную клавішу N мілісекунд (затрымка паміж націсканнем і адпусканнем) (па змаўчанні: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Затрымка N мілісекунд паміж радкамі каманднага радка (па змаўчанні: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Указаць файл, змесціва якога будзе ўведзена так, быццам яно перададзена аргументам.\n                               Замест шляху да файла можна задаць '-' для чытання з stdin\n  -e, --escape=BOOL          Уключыць (1) або выключыць (0) апрацоўку Escape\n  -h, --help                 Паказаць гэтую даведку і выйсці\n\nПры ўводзе аргументаў каманднага радка Escape апрацоўваецца па змаўчанні; пры чытанні з файла і stdin — не.\nУвод з файла паступае патокам: дапушчальныя сімвалы ASCII да пазнейшай памылкі ўжо маглі быць уведзены."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type падтрымлівае толькі ASCII; для тэксту UTF-8 устаўце яго з буфера абмену\n"

