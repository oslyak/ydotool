msgstr "ydotool: signal handler ਲਗਾਓ"

msgid "ydotool: lock socket directory"
msgstr "ydotool: socket ਡਾਇਰੈਕਟਰੀ ਲੌਕ ਕਰੋ"

msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "ਵਰਤੋਂ: ydotoold [OPTION]...\nydotool ਡੈਮਨ।\n\nਚੋਣਾਂ:\n  -p, --socket-path=PATH     ਮਨਮੁਤਾਬਕ socket ਰਸਤਾ\n  -P, --socket-perm=PERM     socket ਇਜਾਜ਼ਤ (ਮੂਲ 0600)\n  -o, --socket-own=UID:GID   socket ਮਾਲਕੀ\n  -s, --no-system-keys        SysRq ਅਤੇ power/sleep/restart ਕੁੰਜੀਆਂ ਬੰਦ ਕਰੋ\n  -m, --mouse-off            ਮਾਊਸ ਬੰਦ ਕਰੋ (EV_REL)\n  -k, --keyboard-off         ਕੀਬੋਰਡ ਬੰਦ ਕਰੋ (EV_KEY)\n  -T, --touch-on             ਟੱਚਸਕ੍ਰੀਨ ਚਾਲੂ ਕਰੋ (EV_ABS)\n  -h, --help                 ਇਹ ਮਦਦ ਦਿਖਾ ਕੇ ਬਾਹਰ ਜਾਓ\n  -V, --version              ਵਰਜਨ ਜਾਣਕਾਰੀ ਦਿਖਾਓ\n"

#, c-format
msgid "UI_SET_EVBIT %s failed\n"
msgstr "UI_SET_EVBIT %s ਅਸਫਲ ਹੋਇਆ\n"

