msgstr "ydotool: stdin ਸਿਰਫ਼ ASCII ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ; UTF-8 ਲਿਖਤ ਲਈ ਕਲਿੱਪਬੋਰਡ ਪੇਸਟ ਵਰਤੋ\n"

#, c-format
msgid "  Maps to: %d\n"
msgstr "  ਇਸ ਨਾਲ ਮਿਲਦਾ ਹੈ: %d\n"

msgid "  Sending shift\n"
msgstr "  shift ਭੇਜ ਰਿਹਾ ਹੈ\n"

msgid "  Sending ctrl\n"
msgstr "  ctrl ਭੇਜ ਰਿਹਾ ਹੈ\n"

msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "ਵਰਤੋਂ: type [OPTION]... [STRINGS]...\nਲਿਖਤ-ਲੜੀਆਂ ਟਾਈਪ ਕਰੋ।\n\nਚੋਣਾਂ:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          ਕੁੰਜੀਆਂ ਵਿਚਕਾਰ N ਮਿਲੀਸਕਿੰਟ ਰੁਕੋ (ਹਰ ਕੁੰਜੀ ਦੇ ਹੇਠਾਂ/ਉੱਪਰ ਜੋੜੇ ਵਿਚਕਾਰ ਦੇਰੀ) (ਮੂਲ: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           ਹਰ ਕੁੰਜੀ N ਮਿਲੀਸਕਿੰਟ ਦਬਾਈ ਰੱਖੋ (ਕੁੰਜੀ ਹੇਠਾਂ ਅਤੇ ਉੱਪਰ ਵਿਚਕਾਰ ਦੇਰੀ) (ਮੂਲ: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         ਕਮਾਂਡ-ਲਾਈਨ ਲਿਖਤ-ਲੜੀਆਂ ਵਿਚਕਾਰ N ਮਿਲੀਸਕਿੰਟ ਰੁਕੋ (ਮੂਲ: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            ਫਾਈਲ ਦੱਸੋ; ਇਸ ਦੀ ਸਮੱਗਰੀ ਆਰਗੂਮੈਂਟ ਵਾਂਗ ਟਾਈਪ ਕੀਤੀ ਜਾਵੇਗੀ।\n                               stdin ਤੋਂ ਪੜ੍ਹਨ ਲਈ ਫਾਈਲ ਦਾ ਰਸਤਾ '-' ਵੀ ਹੋ ਸਕਦਾ ਹੈ\n  -e, --escape=BOOL          Escape ਚਾਲੂ (1) ਜਾਂ ਬੰਦ (0)\n  -h, --help                 ਇਹ ਮਦਦ ਦਿਖਾ ਕੇ ਬਾਹਰ ਜਾਓ\n\nਕਮਾਂਡ-ਲਾਈਨ ਆਰਗੂਮੈਂਟ ਟਾਈਪ ਕਰਨ ਵੇਲੇ Escape ਮੂਲ ਰੂਪ ਵਿੱਚ ਚਾਲੂ ਹੁੰਦਾ ਹੈ; ਫਾਈਲ ਅਤੇ stdin ਤੋਂ ਟਾਈਪ ਕਰਨ ਵੇਲੇ ਮੂਲ ਰੂਪ ਵਿੱਚ ਬੰਦ ਹੁੰਦਾ ਹੈ।\nਫਾਈਲ ਇਨਪੁੱਟ ਲਗਾਤਾਰ ਪੜ੍ਹਿਆ ਜਾਂਦਾ ਹੈ: ਬਾਅਦ ਵਿੱਚ ਗਲਤੀ ਆਵੇ ਤਾਂ ਉਸ ਤੋਂ ਪਹਿਲਾਂ ਵਾਲਾ ਠੀਕ ASCII ਪਹਿਲਾਂ ਹੀ ਟਾਈਪ ਹੋ ਸਕਦਾ ਹੈ।"

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type ਸਿਰਫ਼ ASCII ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ; UTF-8 ਲਿਖਤ ਲਈ ਕਲਿੱਪਬੋਰਡ ਪੇਸਟ ਵਰਤੋ\n"

