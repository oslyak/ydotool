msgstr "ydotool: release-all ਕੋਈ ਆਰਗੂਮੈਂਟ ਨਹੀਂ ਲੈਂਦਾ\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "ਵਰਤੋਂ: ydotool <cmd> <args>\nਉਪਲਬਧ ਕਮਾਂਡਾਂ:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "ਮਾਰੇ ਗਏ client ਤੋਂ ਬਾਅਦ ਦਬਾਈਆਂ ਕੁੰਜੀਆਂ ਛੱਡਣ ਲਈ release-all ਵਰਤੋ।\n  -h, --help     ਇਹ ਮਦਦ ਦਿਖਾ ਕੇ ਬਾਹਰ ਜਾਓ\n  -V, --version  ਵਰਜਨ ਜਾਣਕਾਰੀ ਦਿਖਾ ਕੇ ਬਾਹਰ ਜਾਓ\nਡੈਮਨ socket ਦੱਸਣ ਲਈ YDOTOOL_SOCKET ਵਾਤਾਵਰਣ ਚਲ ਵਰਤੋ।"

#, c-format
