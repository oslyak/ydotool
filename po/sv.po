msgid "Usage: release-all\nRelease all virtual keyboard and mouse buttons."
msgstr "Användning: release-all\nSläpp alla virtuella tangentbords- och musknappar."

msgid "ydotool: release-all takes no arguments\n"
msgstr "ydotool: release-all tar inga argument\n"

msgid "Usage: ydotool <cmd> <args>\nAvailable commands:"
msgstr "Användning: ydotool <cmd> <args>\nTillgängliga kommandon:"

msgid "Use release-all to recover held keys after a killed client.\n  -h, --help     Display this help and exit\n  -V, --version  Display version information and exit\nUse environment variable YDOTOOL_SOCKET to specify daemon socket."
msgstr "Använd release-all för att återställa nedtryckta tangenter efter att en klient har avslutats med tvång.\n  -h, --help     Visa den här hjälpen och avsluta\n  -V, --version  Visa versionsinformation och avsluta\nAnvänd miljövariabeln YDOTOOL_SOCKET för att ange daemonens socket."

