msgid "Usage: type [OPTION]... [STRINGS]...\nType strings.\n\nOptions:"
msgstr "Användning: type [OPTION]... [STRINGS]...\nSkriv strängar.\n\nAlternativ:"

#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Vänta N millisekunder mellan tangenter (väntetiden mellan varje tangenttryckning och tangentuppsläppning) (standard: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Håll varje tangent nere i N millisekunder (väntetiden mellan tangenttryckning och tangentuppsläppning) (standard: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Vänta N millisekunder mellan strängar på kommandoraden (standard: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Ange en fil vars innehåll skrivs som om det hade angetts som ett argument.\n                               Filsökvägen kan också vara '-' för att läsa från stdin\n  -e, --escape=BOOL          Aktivera (1) eller inaktivera (0) escape\n  -h, --help                 Visa den här hjälpen och avsluta\n\nEscape är aktiverat som standard när argument på kommandoraden skrivs, och inaktiverat som standard när indata läses från en fil eller stdin.\nFilindata strömmas: giltig ASCII före ett senare fel kan redan ha skrivits."

msgid "ydotool: type supports ASCII only; use clipboard paste for UTF-8 text\n"
msgstr "ydotool: type stöder endast ASCII; använd inklistring från urklipp för UTF-8-text\n"

msgid "escape mode"
msgstr "escape-läge"

