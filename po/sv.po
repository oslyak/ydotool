msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "Användning: ydotoold [OPTION]...\nydotool-demonen.\n\nAlternativ:\n  -p, --socket-path=PATH     Anpassad sökväg till socket\n  -P, --socket-perm=PERM     Socketbehörighet (standard 0600)\n  -o, --socket-own=UID:GID   Socketägare\n  -s, --no-system-keys        Inaktivera SysRq- samt ström-, viloläges- och omstartstangenter\n  -m, --mouse-off            Inaktivera mus (EV_REL)\n  -k, --keyboard-off         Inaktivera tangentbord (EV_KEY)\n  -T, --touch-on             Aktivera pekskärm (EV_ABS)\n  -h, --help                 Visa den här hjälpen och avsluta\n  -V, --version              Visa versionsinformation\n"
