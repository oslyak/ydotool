#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          Késleltetés N ezredmásodpercig a billentyűk között (az egyes lenyomás/felengedés párok közötti késleltetés) (alapértelmezett: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           Minden billentyű lenyomva tartása N ezredmásodpercig (késleltetés a lenyomás és felengedés között) (alapértelmezett: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         Késleltetés N ezredmásodpercig a parancssori szövegek között (alapértelmezett: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            Fájl megadása; a tartalmát úgy gépeli be, mintha argumentumként adta volna meg.\n                               A fájl elérési útja '-' is lehet, ekkor stdin-ről olvas\n  -e, --escape=BOOL          Escape engedélyezése (1) vagy letiltása (0)\n  -h, --help                 E súgó megjelenítése és kilépés\n\nParancssori argumentumok begépelésekor az escape alapértelmezés szerint engedélyezett, fájl és stdin begépelésekor pedig letiltott.\nA fájlbemenet folyamatos: egy későbbi hiba előtt érvényes ASCII-adatok már begépelődhettek."

