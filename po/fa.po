#, c-format
msgid "  -d, --key-delay=N          Delay N milliseconds between keys (the delay between every key down/up pair) (default: %d)\n"
msgstr "  -d, --key-delay=N          بین کلیدها N میلی‌ثانیه تأخیر (تأخیر میان هر جفت پایین/بالای کلید) (پیش‌فرض: %d)\n"

#, c-format
msgid "  -H, --key-hold=N           Hold each key for N milliseconds (the delay between key down and up) (default: %d)\n"
msgstr "  -H, --key-hold=N           هر کلید را N میلی‌ثانیه نگه می‌دارد (تأخیر میان پایین و بالای کلید) (پیش‌فرض: %d)\n"

#, c-format
msgid "  -D, --next-delay=N         Delay N milliseconds between command line strings (default: %d)\n"
msgstr "  -D, --next-delay=N         بین رشته‌های خط فرمان N میلی‌ثانیه تأخیر (پیش‌فرض: %d)\n"

msgid "  -f, --file=PATH            Specify a file, the contents of which will be be typed as if passed as an argument.\n                               The filepath may also be '-' to read from stdin\n  -e, --escape=BOOL          Escape enable (1) or disable (0)\n  -h, --help                 Display this help and exit\n\nEscape is enabled by default when typing command line arguments, and disabled by default when typing from file and stdin.\nFile input is streamed: valid ASCII before a later error may already have been typed."
msgstr "  -f, --file=PATH            فایلی را مشخص می‌کند که محتوایش گویی به‌عنوان آرگومان داده شده تایپ می‌شود.\n                               مسیر فایل می‌تواند برای خواندن از stdin برابر '-' باشد\n  -e, --escape=BOOL          فعال‌سازی Escape (1) یا غیرفعال‌سازی آن (0)\n  -h, --help                 این راهنما را نمایش می‌دهد و خارج می‌شود\n\nهنگام تایپ آرگومان‌های خط فرمان، Escape به‌طور پیش‌فرض فعال است؛ هنگام تایپ از فایل و stdin، به‌طور پیش‌فرض غیرفعال است.\nورودی فایل به‌صورت جریانی خوانده می‌شود: ممکن است ASCII معتبر پیش از خطای بعدی از قبل تایپ شده باشد."

