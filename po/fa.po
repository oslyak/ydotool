msgid "Usage: ydotoold [OPTION]...\nThe ydotool Daemon.\n\nOptions:\n  -p, --socket-path=PATH     Custom socket path\n  -P, --socket-perm=PERM     Socket permission (default 0600)\n  -o, --socket-own=UID:GID   Socket ownership\n  -s, --no-system-keys        Disable SysRq and power/sleep/restart keys\n  -m, --mouse-off            Disable mouse (EV_REL)\n  -k, --keyboard-off         Disable keyboard (EV_KEY)\n  -T, --touch-on             Enable touchscreen (EV_ABS)\n  -h, --help                 Display this help and exit\n  -V, --version              Show version information\n"
msgstr "استفاده: ydotoold [OPTION]...\nدیمون ydotool.\n\nگزینه‌ها:\n  -p, --socket-path=PATH     مسیر سفارشی سوکت\n  -P, --socket-perm=PERM     مجوز سوکت (پیش‌فرض 0600)\n  -o, --socket-own=UID:GID   مالکیت سوکت\n  -s, --no-system-keys        کلیدهای SysRq و خاموشی/خواب/راه‌اندازی مجدد را غیرفعال می‌کند\n  -m, --mouse-off            ماوس را غیرفعال می‌کند (EV_REL)\n  -k, --keyboard-off         صفحه‌کلید را غیرفعال می‌کند (EV_KEY)\n  -T, --touch-on             صفحه‌نمایش لمسی را فعال می‌کند (EV_ABS)\n  -h, --help                 این راهنما را نمایش می‌دهد و خارج می‌شود\n  -V, --version              اطلاعات نسخه را نمایش می‌دهد\n"

